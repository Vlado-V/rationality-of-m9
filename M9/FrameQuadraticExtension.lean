module

public import M9.FrameProjectiveGeometry
public import M9.SemilinearInvolution
public import Mathlib.FieldTheory.Fixed
public import Mathlib.LinearAlgebra.Dimension.Finrank

/-!+# The two actual frame invariant fields

The ambient field is the generic stalk of the native projective matrix scheme.
The even frame subgroup and the full frame group define actual fixed fields.
Transposition restricts to an involution of the even fixed field, whose fixed
elements are exactly the full-group invariants.
-/

@[expose] public section
noncomputable section

namespace M9.FrameQuadraticExtension

open Module FrameAction

abbrev Ambient := ProjectiveFunctionField.matrixFunctionField
abbrev W := FrameProjectiveGeometry.W
abbrev Even := TetrahedralGroup.Gamma × TetrahedralGroup.Gamma

local instance : MulSemiringAction W Ambient := FrameProjectiveGeometry.fieldAction
local instance : SMulCommClass W ℂ Ambient := FrameProjectiveGeometry.fieldScalarCommutes
local instance : FaithfulSMul W Ambient := FrameProjectiveGeometry.fieldAction_faithful

def evenRepresentation : Even →* (Ambient ≃ₐ[ℂ] Ambient) :=
  FrameProjectiveGeometry.fieldRepresentation.comp FrameGroup.pairHom

@[instance_reducible] def evenAction : MulSemiringAction Even Ambient :=
  MulSemiringAction.compHom Ambient evenRepresentation

local instance : MulSemiringAction Even Ambient := evenAction

local instance : SMulCommClass Even ℂ Ambient where
  smul_comm g c x := map_smul (evenRepresentation g).toLinearEquiv c x

/-- Connected frame invariants in the original projective function field. -/
def connectedField : IntermediateField ℂ Ambient where
  __ := FixedPoints.subfield Even Ambient
  algebraMap_mem' c g := smul_algebraMap g c

/-- Full frame invariants in the same original projective function field. -/
def baseField : IntermediateField ℂ Ambient where
  __ := FixedPoints.subfield W Ambient
  algebraMap_mem' c g := smul_algebraMap g c

@[simp] theorem mem_connectedField (x : Ambient) :
    x ∈ connectedField ↔ ∀ g : Even, evenRepresentation g x = x := Iff.rfl

@[simp] theorem mem_baseField (x : Ambient) :
    x ∈ baseField ↔ ∀ g : W, FrameProjectiveGeometry.fieldRepresentation g x = x := Iff.rfl

theorem baseField_le_connectedField : baseField ≤ connectedField := by
  intro x hx g
  exact hx (FrameGroup.pairHom g)

/-- Transposition preserves the actual connected invariant field. -/
theorem tau_mem_connectedField (x : connectedField) :
    FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau x.val ∈ connectedField := by
  intro g
  have hcomm : FrameGroup.pairHom g * (FrameGroup.tau : W) =
      FrameGroup.tau * FrameGroup.pairHom (g.2, g.1) := by
    rcases g with ⟨a,b⟩
    change (⟨a,b,false⟩ : W) * ⟨1,1,true⟩ = ⟨1,1,true⟩ * ⟨b,a,false⟩
    rw [FrameGroup.mul_even, FrameGroup.mul_odd]
    simp
  change FrameProjectiveGeometry.fieldRepresentation (FrameGroup.pairHom g)
    (FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau x.val) = _
  rw [← AlgEquiv.mul_apply, ← map_mul, hcomm, map_mul, AlgEquiv.mul_apply]
  exact congrArg (FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau)
    (x.property (g.2,g.1))

/-- The actual involution of the connected invariant field. -/
def exchange : connectedField ≃ₐ[ℂ] connectedField where
  toFun x := ⟨FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau x.val,
    tau_mem_connectedField x⟩
  invFun x := ⟨FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau x.val,
    tau_mem_connectedField x⟩
  left_inv x := by
    apply Subtype.ext
    change FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau
      (FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau x.val) = x.val
    rw [← AlgEquiv.mul_apply, ← map_mul, FrameGroup.tau_squared, map_one]
    rfl
  right_inv x := by
    apply Subtype.ext
    change FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau
      (FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau x.val) = x.val
    rw [← AlgEquiv.mul_apply, ← map_mul, FrameGroup.tau_squared, map_one]
    rfl
  map_mul' x y := Subtype.ext (map_mul _ _ _)
  map_add' x y := Subtype.ext (map_add _ _ _)
  commutes' c := Subtype.ext ((FrameProjectiveGeometry.fieldRepresentation
    FrameGroup.tau).commutes c)

@[simp] theorem exchange_coe (x : connectedField) :
    (exchange x).val = FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau x.val := rfl

@[simp] theorem exchange_exchange (x : connectedField) : exchange (exchange x) = x :=
  exchange.left_inv x

/-- The full group is generated by the actual connected subgroup and transpose. -/
theorem mem_baseField_iff (x : Ambient) :
    x ∈ baseField ↔ x ∈ connectedField ∧
      FrameProjectiveGeometry.fieldRepresentation FrameGroup.tau x = x := by
  rw [mem_baseField, mem_connectedField]
  constructor
  · intro hx
    exact ⟨baseField_le_connectedField hx, hx FrameGroup.tau⟩
  · rintro ⟨hx, ht⟩ ⟨a,b,o⟩
    cases o
    · exact hx (a,b)
    · have hnormal : (⟨a,b,true⟩ : W) = FrameGroup.pairHom (a,b) * FrameGroup.tau := by
        change (⟨a,b,true⟩ : W) = ⟨a,b,false⟩ * ⟨1,1,true⟩
        rw [FrameGroup.mul_even]
        simp
      rw [hnormal, map_mul, AlgEquiv.mul_apply, ht]
      exact hx (a,b)

theorem exchange_fixed_iff (x : connectedField) :
    exchange x = x ↔ x.val ∈ baseField := by
  rw [mem_baseField_iff]
  exact ⟨fun h => ⟨x.property, congrArg Subtype.val h⟩,
    fun h => Subtype.ext h.2⟩

local instance : FaithfulSMul Even Ambient where
  eq_of_smul_eq_smul {g h} heq := by
    have hrep : evenRepresentation g = evenRepresentation h := by
      ext x
      exact heq x
    have he := FrameProjectiveGeometry.fieldRepresentation_injective hrep
    exact Prod.ext (congrArg FrameGroup.first he) (congrArg FrameGroup.second he)

theorem ambient_degree_over_connected : finrank connectedField Ambient = 576 := by
  change finrank (FixedPoints.subfield Even Ambient) Ambient = 576
  rw [FixedPoints.finrank_eq_card]
  simp [Even, TetrahedralGroup.card_gamma]

theorem ambient_degree_over_base : finrank baseField Ambient = 1152 := by
  change finrank (FixedPoints.subfield W Ambient) Ambient = 1152
  rw [FixedPoints.finrank_eq_card]
  exact FrameAction.card_tetrahedralFrameGroup

/-- The actual inclusion of the full invariant field in the connected one. -/
def baseInclusion : baseField →ₐ[ℂ] connectedField :=
  IntermediateField.inclusion baseField_le_connectedField

instance : Algebra baseField connectedField := baseInclusion.toRingHom.toAlgebra

instance : IsScalarTower baseField connectedField Ambient :=
  IsScalarTower.of_algebraMap_eq (fun _ => rfl)

instance : FiniteDimensional baseField Ambient := by
  change FiniteDimensional (FixedPoints.subfield W Ambient) Ambient
  infer_instance

instance : FiniteDimensional connectedField Ambient := by
  change FiniteDimensional (FixedPoints.subfield Even Ambient) Ambient
  infer_instance

instance : FiniteDimensional baseField connectedField :=
  FiniteDimensional.left baseField connectedField Ambient

/-- The quadratic degree is proved from the two actual faithful group actions. -/
theorem connected_degree : finrank baseField connectedField = 2 := by
  have h := finrank_mul_finrank baseField connectedField Ambient
  rw [ambient_degree_over_connected, ambient_degree_over_base] at h
  exact mul_right_cancel₀ (by decide : (576 : ℕ) ≠ 0) h

/-- Transposition is not the identity on the connected invariant field. -/
theorem exchange_ne_one : exchange ≠ 1 := by
  intro hid
  have heq : connectedField = baseField := by
    apply le_antisymm
    · intro x hx
      exact (exchange_fixed_iff ⟨x,hx⟩).mp (by rw [hid]; rfl)
    · exact baseField_le_connectedField
  have hc := ambient_degree_over_connected
  rw [heq, ambient_degree_over_base] at hc
  norm_num at hc

theorem exists_moved : ∃ x : connectedField, exchange x ≠ x := by
  by_contra! h
  apply exchange_ne_one
  ext x
  exact congrArg Subtype.val (h x)

/-- The fixed field of the actual exchange, retaining the original complex
coefficient inclusion. -/
def exchangeFixedField : IntermediateField ℂ connectedField where
  __ := SemilinearInvolution.fixedField exchange.toRingEquiv
  algebraMap_mem' c := exchange.commutes c

/-- The original full invariant field is exactly the exchange fixed field,
with both original complex structures respected. -/
def baseFixedEquiv : baseField ≃ₐ[ℂ] exchangeFixedField where
  toFun x := ⟨baseInclusion x, (exchange_fixed_iff (baseInclusion x)).mpr x.property⟩
  invFun x := ⟨x.val.val, (exchange_fixed_iff x.val).mp x.property⟩
  left_inv x := by apply Subtype.ext; rfl
  right_inv x := by apply Subtype.ext; apply Subtype.ext; rfl
  map_mul' x y := by apply Subtype.ext; apply Subtype.ext; rfl
  map_add' x y := by apply Subtype.ext; apply Subtype.ext; rfl
  commutes' c := by apply Subtype.ext; apply Subtype.ext; rfl

@[simp] theorem baseFixedEquiv_coe (x : baseField) :
    (baseFixedEquiv x).val.val = x.val := rfl

/-- A genuine nonzero anti-invariant in the actual quadratic extension. -/
theorem exists_anti_invariant : ∃ θ : connectedField, θ ≠ 0 ∧ exchange θ = -θ := by
  obtain ⟨b, hb⟩ := exists_moved
  refine ⟨b - exchange b, sub_ne_zero.mpr hb.symm, ?_⟩
  rw [map_sub, exchange_exchange]
  ring

end M9.FrameQuadraticExtension
