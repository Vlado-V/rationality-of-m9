module

public import M9.ProjectiveFrameQuotient

/-!
# The native PGL₃ action on the actual pair-frame ratio field

The original connected action preserves the field generated by the two
projective frame coordinates. Its center acts trivially, so it factors
through the native projective general linear group. The resulting native
fixed field is identified with the actual generic stalk of P(Mat₃).
-/

@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 300000
set_option maxRecDepth 2048
open scoped Classical Matrix BigOperators

namespace M9.ProjectiveFrameAction
open MvPolynomial FrameFieldElimination ProjectiveFrameQuotient

abbrev GL3 := ConstantFrameElimination.GLn ℂ 3
abbrev PGL3 := Matrix.ProjGenLinGroup (Fin 3) ℂ

local instance : MulSemiringAction GL3 PF := FrameFieldElimination.pairAction ℂ

theorem linearRatio_mem (V : Matrix (Fin 3) (Fin 3) PF) (p : PF) (hp : p ≠ 0)
    (hV : ∀ ij : Index, V ij.1 ij.2 / p ∈ projectivePairField)
    (L : Matrix (Fin 3) (Fin 3) ℂ) (ij kl : Index) :
    (L.map (algebraMap ℂ PF) * V) ij.1 ij.2 /
      (L.map (algebraMap ℂ PF) * V) kl.1 kl.2 ∈ projectivePairField := by
  have hn (i j : Fin 3) : (L.map (algebraMap ℂ PF) * V) i j / p ∈ projectivePairField := by
    change (∑ k : Fin 3, algebraMap ℂ PF (L i k) * V k j) / p ∈ _
    rw [Finset.sum_div]
    apply IntermediateField.sum_mem
    intro k _
    rw [mul_div_assoc]
    exact projectivePairField.mul_mem (projectivePairField.algebraMap_mem _) (hV (k,j))
  have h := projectivePairField.div_mem (hn ij.1 ij.2) (hn kl.1 kl.2)
  rwa [div_div_div_cancel_right₀ hp] at h

/-- The actual field of projective pair coordinates is preserved by the
literal connected inverse-pullback action. -/
theorem pairAction_projectivePair_mem (g : GL3) (f : PF) (hf : f ∈ projectivePairField) :
    pairActionHom ℂ g f ∈ projectivePairField := by
  have hF (i j : Fin 3) : pairActionHom ℂ g (firstFrame ℂ i j) =
      ((g⁻¹).val.map (algebraMap ℂ PF) * firstFrame ℂ) i j :=
    congrArg (fun M : Matrix (Fin 3) (Fin 3) PF => M i j) (pairAction_firstFrame ℂ g)
  have hH (i j : Fin 3) : pairActionHom ℂ g (secondFrame ℂ i j) =
      (g.val.transpose.map (algebraMap ℂ PF) * secondFrame ℂ) i j :=
    congrArg (fun M : Matrix (Fin 3) (Fin 3) PF => M i j) (pairAction_secondFrame ℂ g)
  refine IntermediateField.adjoin_induction (F := ℂ)
    (motive := fun y _ => pairActionHom ℂ g y ∈ projectivePairField) ?_ ?_ ?_ ?_ ?_ hf
  · rintro _ (⟨ij,rfl⟩ | ⟨ij,rfl⟩)
    · change pairActionHom ℂ g (firstFrame ℂ ij.1 ij.2 / firstPivot) ∈ _
      rw [map_div₀, hF]
      rw [show pairActionHom ℂ g firstPivot =
        ((g⁻¹).val.map (algebraMap ℂ PF) * firstFrame ℂ) pivotIndex.1 pivotIndex.2 from
          hF pivotIndex.1 pivotIndex.2]
      exact linearRatio_mem (firstFrame ℂ) firstPivot firstPivot_ne_zero firstRatio_mem (g⁻¹).val ij pivotIndex
    · change pairActionHom ℂ g (secondFrame ℂ ij.1 ij.2 / secondPivot) ∈ _
      rw [map_div₀, hH]
      rw [show pairActionHom ℂ g secondPivot =
        (g.val.transpose.map (algebraMap ℂ PF) * secondFrame ℂ) pivotIndex.1 pivotIndex.2 from
          hH pivotIndex.1 pivotIndex.2]
      exact linearRatio_mem (secondFrame ℂ) secondPivot secondPivot_ne_zero secondRatio_mem
        g.val.transpose ij pivotIndex
  · intro c
    rw [pairAction_constant]
    exact projectivePairField.algebraMap_mem c
  · intro y z _ _ hy hz
    rw [map_add]
    exact projectivePairField.add_mem hy hz
  · intro y _ hy
    rw [map_inv₀]
    exact projectivePairField.inv_mem hy
  · intro y z _ _ hy hz
    rw [map_mul]
    exact projectivePairField.mul_mem hy hz

def restrictRingActionHom {G F : Type*} [Group G] [Field F]
    (ρ : G →* (F ≃+* F)) (T : Subfield F)
    (hT : ∀ g : G, ∀ f ∈ T, ρ g f ∈ T) : G →* (T ≃+* T) where
  toFun g :=
    { toFun f := ⟨ρ g f.val, hT g f.val f.property⟩
      invFun f := ⟨ρ g⁻¹ f.val, hT g⁻¹ f.val f.property⟩
      left_inv f := Subtype.ext (by
        have he := congrArg (fun σ : F ≃+* F => σ f.val) (map_mul ρ g⁻¹ g)
        simpa only [inv_mul_cancel, map_one, RingAut.one_apply, RingAut.mul_apply] using he.symm)
      right_inv f := Subtype.ext (by
        have he := congrArg (fun σ : F ≃+* F => σ f.val) (map_mul ρ g g⁻¹)
        simpa only [mul_inv_cancel, map_one, RingAut.one_apply, RingAut.mul_apply] using he.symm)
      map_mul' f h := Subtype.ext ((ρ g).map_mul f.val h.val)
      map_add' f h := Subtype.ext ((ρ g).map_add f.val h.val) }
  map_one' := RingEquiv.ext (fun f => Subtype.ext (by
    change ρ 1 f.val = f.val
    have he := congrArg (fun σ : F ≃+* F => σ f.val) (map_one ρ)
    simpa only [RingAut.one_apply] using he))
  map_mul' g h := RingEquiv.ext (fun f => Subtype.ext (by
    change ρ (g*h) f.val = ρ g (ρ h f.val)
    have he := congrArg (fun σ : F ≃+* F => σ f.val) (map_mul ρ g h)
    simpa only [RingAut.mul_apply] using he))

@[simp] theorem restrictRingActionHom_val {G F : Type*} [Group G] [Field F]
    (ρ : G →* (F ≃+* F)) (T : Subfield F)
    (hT : ∀ g : G, ∀ f ∈ T, ρ g f ∈ T) (g : G) (f : T) :
    (restrictRingActionHom ρ T hT g f).val = ρ g f.val := rfl

def projectiveActionHom : GL3 →* (projectivePairField ≃+* projectivePairField) :=
  restrictRingActionHom (pairActionHom ℂ) projectivePairField.toSubfield pairAction_projectivePair_mem

@[simp] theorem projectiveActionHom_val (g : GL3) (f : projectivePairField) :
    (projectiveActionHom g f).val = pairActionHom ℂ g f.val :=
  restrictRingActionHom_val _ _ _ _ _

theorem pairAction_scalar_firstFrame (a : ℂˣ) (i j : Fin 3) :
    pairActionHom ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a) (firstFrame ℂ i j) =
      algebraMap ℂ PF (a⁻¹ : ℂˣ).val * firstFrame ℂ i j := by
  have he := pairAction_firstFrame ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a)
  rw [← map_inv (Matrix.GeneralLinearGroup.scalar (Fin 3)) a] at he
  have hm : (Matrix.GeneralLinearGroup.scalar (Fin 3) (a⁻¹)).val.map (algebraMap ℂ PF) =
      algebraMap ℂ PF (a⁻¹ : ℂˣ).val • (1 : Matrix (Fin 3) (Fin 3) PF) := by
    ext k l
    change algebraMap ℂ PF (if k = l then (a⁻¹ : ℂˣ).val else 0) =
      algebraMap ℂ PF (a⁻¹ : ℂˣ).val * (if k = l then 1 else 0)
    by_cases h : k = l <;> simp [h]
  rw [hm, Matrix.smul_mul, Matrix.one_mul] at he
  exact congrArg (fun M : Matrix (Fin 3) (Fin 3) PF => M i j) he

theorem pairAction_scalar_secondFrame (a : ℂˣ) (i j : Fin 3) :
    pairActionHom ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a) (secondFrame ℂ i j) =
      algebraMap ℂ PF (a : ℂ) * secondFrame ℂ i j := by
  have he := pairAction_secondFrame ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a)
  have hm : ((Matrix.GeneralLinearGroup.scalar (Fin 3) a).val.map (algebraMap ℂ PF)).transpose =
      algebraMap ℂ PF (a : ℂ) • (1 : Matrix (Fin 3) (Fin 3) PF) := by
    ext k l
    simp [Matrix.GeneralLinearGroup.coe_scalar, Matrix.scalar_apply, Matrix.diagonal_apply,
      Matrix.one_apply, eq_comm]
  rw [hm, Matrix.smul_mul, Matrix.one_mul] at he
  exact congrArg (fun M : Matrix (Fin 3) (Fin 3) PF => M i j) he

theorem scalar_projectivePair_fixed (a : ℂˣ) (f : PF) (hf : f ∈ projectivePairField) :
    pairActionHom ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a) f = f := by
  have ha : algebraMap ℂ PF (a : ℂ) ≠ 0 := by
    simpa only [map_zero] using (algebraMap ℂ PF).injective.ne a.ne_zero
  have hai : algebraMap ℂ PF (a⁻¹ : ℂˣ).val ≠ 0 := by
    simpa only [map_zero] using (algebraMap ℂ PF).injective.ne (a⁻¹).ne_zero
  refine IntermediateField.adjoin_induction (F := ℂ)
    (motive := fun y _ => pairActionHom ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a) y = y)
    ?_ ?_ ?_ ?_ ?_ hf
  · rintro _ (⟨ij,rfl⟩ | ⟨ij,rfl⟩)
    · change pairActionHom ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a)
        (firstFrame ℂ ij.1 ij.2 / firstPivot) = _
      rw [map_div₀, pairAction_scalar_firstFrame]
      rw [show pairActionHom ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a) firstPivot =
        algebraMap ℂ PF (a⁻¹ : ℂˣ).val * firstPivot from
          pairAction_scalar_firstFrame a pivotIndex.1 pivotIndex.2]
      exact mul_div_mul_left _ _ hai
    · change pairActionHom ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a)
        (secondFrame ℂ ij.1 ij.2 / secondPivot) = _
      rw [map_div₀, pairAction_scalar_secondFrame]
      rw [show pairActionHom ℂ (Matrix.GeneralLinearGroup.scalar (Fin 3) a) secondPivot =
        algebraMap ℂ PF (a : ℂ) * secondPivot from
          pairAction_scalar_secondFrame a pivotIndex.1 pivotIndex.2]
      exact mul_div_mul_left _ _ ha
  · intro c
    exact pairAction_constant ℂ _ c
  · intro y z _ _ hy hz
    rw [map_add, hy, hz]
  · intro y _ hy
    rw [map_inv₀, hy]
  · intro y z _ _ hy hz
    rw [map_mul, hy, hz]

theorem center_le_kernel : Subgroup.center GL3 ≤ projectiveActionHom.ker := by
  rw [Matrix.GeneralLinearGroup.center_eq_range_scalar]
  rintro _ ⟨a,rfl⟩
  apply MonoidHom.mem_ker.mpr
  apply RingEquiv.ext
  intro f
  apply Subtype.ext
  change (projectiveActionHom (Matrix.GeneralLinearGroup.scalar (Fin 3) a) f).val = f.val
  rw [projectiveActionHom_val]
  exact scalar_projectivePair_fixed a f.val f.property

/-- The action factors through the actual native quotient GL₃/Z(GL₃). -/
def pglActionHom : PGL3 →* (projectivePairField ≃+* projectivePairField) :=
  QuotientGroup.lift _ projectiveActionHom center_le_kernel

@[simp] theorem pglActionHom_mk (g : GL3) :
    pglActionHom (Matrix.ProjGenLinGroup.mk g) = projectiveActionHom g := rfl

@[instance_reducible] def pglAction : MulSemiringAction PGL3 projectivePairField :=
  MulSemiringAction.compHom projectivePairField pglActionHom

attribute [local instance] pglAction

def pglFixedField : IntermediateField ℂ projectivePairField where
  __ := FixedPoints.subfield PGL3 projectivePairField
  algebraMap_mem' c p := by
    refine Matrix.ProjGenLinGroup.induction_on p ?_
    intro g
    change pglActionHom (Matrix.ProjGenLinGroup.mk g) (algebraMap ℂ projectivePairField c) = _
    rw [pglActionHom_mk]
    apply Subtype.ext
    rw [projectiveActionHom_val]
    exact pairAction_constant ℂ g c

theorem mem_pglFixedField_iff (f : projectivePairField) :
    f ∈ pglFixedField ↔ ∀ g : GL3, pairActionHom ℂ g f.val = f.val := by
  change (∀ p : PGL3, pglActionHom p f = f) ↔ _
  constructor
  · intro h g
    simpa only [pglActionHom_mk, projectiveActionHom_val] using
      congrArg Subtype.val (h (Matrix.ProjGenLinGroup.mk g))
  · intro h p
    refine Matrix.ProjGenLinGroup.induction_on p ?_
    intro g
    rw [pglActionHom_mk]
    apply Subtype.ext
    rw [projectiveActionHom_val]
    exact h g

def pglFixedEquiv : pglFixedField ≃ₐ[ℂ] projectiveConnectedField where
  toFun f := ⟨f.val.val, (mem_projectiveConnectedField_iff _).mpr
    ⟨f.val.property, (mem_pglFixedField_iff f.val).mp f.property⟩⟩
  invFun f := ⟨⟨f.val,f.property.1⟩, (mem_pglFixedField_iff _).mpr
    ((mem_projectiveConnectedField_iff _).mp f.property).2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

/-- Actual PGL₃ invariants of the original projective pair-frame field are
identified with the native projective matrix generic stalk. -/
def nativePGLQuotientEquiv : NativeMatrixField ≃ₐ[ℂ] pglFixedField :=
  projectiveConnectedQuotientEquiv.trans pglFixedEquiv.symm

theorem nativePGLQuotientEquiv_coordinateRatio (i : Fin 8) :
    ((nativePGLQuotientEquiv
      (ProjectiveFunctionField.coordinateRatio 8 (Fin.last 8) i)).val : PF) =
        invariantMatrix ℂ (affineIndex i).1 (affineIndex i).2 /
          invariantMatrix ℂ pivotIndex.1 pivotIndex.2 :=
  projectiveConnectedQuotientEquiv_coordinateRatio i

end M9.ProjectiveFrameAction
