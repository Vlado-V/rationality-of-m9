module

public import M9.Basic
public import M9.SemilinearInvolution
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.Algebra.CharP.Algebra
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.AlgebraicIndependent.Adjoin
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.Tactic.FieldSimp
public import Mathlib.Tactic.Ring

/-!
# Simultaneous interchange of two independent quadruples

The rational functions below have the actual eight independent coordinates as
their ambient field. The invariant generators are sums, one squared difference,
and three ratios of differences, as in Section 6 of the pinned paper.
-/

@[expose] public section
noncomputable section

namespace M9.PermutationInvariants

abbrev CoordinateIndex := Fin 4 ⊕ Fin 4
abbrev GeneratorIndex := Fin 4 ⊕ (Unit ⊕ Fin 3)
abbrev CoordinatePolynomial (K : Type*) [Field K] := MvPolynomial CoordinateIndex K
abbrev CoordinateField (K : Type*) [Field K] := FractionRing (CoordinatePolynomial K)

variable (K : Type*) [Field K]

def coordinate (i : CoordinateIndex) : CoordinateField K :=
  algebraMap (CoordinatePolynomial K) (CoordinateField K) (MvPolynomial.X i)

def x (i : Fin 4) : CoordinateField K := coordinate K (.inl i)
def y (i : Fin 4) : CoordinateField K := coordinate K (.inr i)

/-- The actual automorphism exchanging the two blocks of independent variables. -/
def swap : CoordinateField K ≃ₐ[K] CoordinateField K :=
  IsFractionRing.algEquivOfAlgEquiv
    (MvPolynomial.renameEquiv K (Equiv.sumComm (Fin 4) (Fin 4)))

@[simp] theorem swap_coordinate (i : CoordinateIndex) :
    swap K (coordinate K i) = coordinate K (Sum.swap i) := by
  simp [swap, coordinate, MvPolynomial.renameEquiv_apply]

@[simp] theorem swap_x (i : Fin 4) : swap K (x K i) = y K i := by
  simp [x, y]

@[simp] theorem swap_y (i : Fin 4) : swap K (y K i) = x K i := by
  simp [x, y]

theorem swap_involutive : Function.Involutive (swap K) := by
  intro z
  obtain ⟨p, q, -, rfl⟩ := IsFractionRing.div_surjective (CoordinatePolynomial K) z
  have h (p : CoordinatePolynomial K) :
      swap K (swap K (algebraMap (CoordinatePolynomial K) (CoordinateField K) p)) =
        algebraMap (CoordinatePolynomial K) (CoordinateField K) p := by
    simp only [swap, IsFractionRing.algEquivOfAlgEquiv_algebraMap,
      MvPolynomial.renameEquiv_apply, MvPolynomial.rename_rename]
    simp
  simp only [map_div₀, h]

theorem coordinate_injective : Function.Injective (coordinate K) := by
  intro i j hij
  exact MvPolynomial.X_injective (IsFractionRing.injective _ _ hij)

theorem swap_ne_refl : (swap K).toRingEquiv ≠ RingEquiv.refl (CoordinateField K) := by
  intro h
  have hmoved := congrArg (fun e : CoordinateField K ≃+* CoordinateField K => e (x K 0)) h
  have hxy : y K 0 = x K 0 := by simpa using hmoved
  have := coordinate_injective K hxy
  cases this

/-- The actual fixed intermediate field of the simultaneous interchange. -/
def swapFixedField : IntermediateField K (CoordinateField K) where
  __ := SemilinearInvolution.fixedField (swap K).toRingEquiv
  algebraMap_mem' a := (swap K).commutes a

@[simp] theorem mem_swapFixedField (z : CoordinateField K) :
    z ∈ swapFixedField K ↔ swap K z = z := Iff.rfl

def sumCoordinate (i : Fin 4) : CoordinateField K := x K i + y K i
def difference (i : Fin 4) : CoordinateField K := x K i - y K i
def delta : CoordinateField K := difference K 0
def squareDifference : CoordinateField K := delta K ^ 2
def ratio (i : Fin 3) : CoordinateField K := difference K i.succ / delta K

theorem delta_ne_zero : delta K ≠ 0 := by
  apply sub_ne_zero.mpr
  intro h
  have := coordinate_injective K h
  cases this

/-- Eight concrete invariant rational functions, with their exact indexing. -/
def invariantGenerator : GeneratorIndex → CoordinateField K
  | .inl i => sumCoordinate K i
  | .inr (.inl _) => squareDifference K
  | .inr (.inr i) => ratio K i

/-- The intermediate field generated by the displayed functions in the ambient field. -/
abbrev generatedField : IntermediateField K (CoordinateField K) :=
  IntermediateField.adjoin K (Set.range (invariantGenerator K))

@[simp] theorem swap_sumCoordinate (i : Fin 4) :
    swap K (sumCoordinate K i) = sumCoordinate K i := by
  simp [sumCoordinate, add_comm]

@[simp] theorem swap_difference (i : Fin 4) :
    swap K (difference K i) = -difference K i := by
  simp [difference, neg_sub]

@[simp] theorem swap_delta : swap K (delta K) = -delta K :=
  swap_difference K 0

@[simp] theorem swap_squareDifference :
    swap K (squareDifference K) = squareDifference K := by
  simp [squareDifference]

@[simp] theorem swap_ratio (i : Fin 3) : swap K (ratio K i) = ratio K i := by
  simp [ratio]

theorem swap_invariantGenerator (i : GeneratorIndex) :
    swap K (invariantGenerator K i) = invariantGenerator K i := by
  rcases i with i | (_ | i) <;> simp [invariantGenerator]

theorem invariantGenerator_mem (i : GeneratorIndex) :
    invariantGenerator K i ∈ generatedField K :=
  IntermediateField.subset_adjoin K _ (Set.mem_range_self i)

theorem sumCoordinate_mem (i : Fin 4) : sumCoordinate K i ∈ generatedField K :=
  invariantGenerator_mem K (.inl i)

theorem squareDifference_mem : squareDifference K ∈ generatedField K :=
  invariantGenerator_mem K (.inr (.inl ()))

theorem ratio_mem (i : Fin 3) : ratio K i ∈ generatedField K :=
  invariantGenerator_mem K (.inr (.inr i))

theorem generatedField_le_swapFixedField : generatedField K ≤ swapFixedField K := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro z ⟨i, rfl⟩
  exact swap_invariantGenerator K i

theorem difference_eq_ratio_mul_delta (i : Fin 3) :
    difference K i.succ = ratio K i * delta K := by
  simp only [ratio, div_mul_cancel₀ _ (delta_ne_zero K)]

section Reconstruction

variable [CharZero K]

instance coordinateFieldCharZero : CharZero (CoordinateField K) :=
  charZero_of_injective_algebraMap (algebraMap K (CoordinateField K)).injective

theorem x_reconstruction (i : Fin 4) :
    x K i = (sumCoordinate K i + difference K i) / 2 := by
  simp only [sumCoordinate, difference]
  field_simp
  ring

theorem y_reconstruction (i : Fin 4) :
    y K i = (sumCoordinate K i - difference K i) / 2 := by
  simp only [sumCoordinate, difference]
  field_simp
  ring

omit [CharZero K] in
/-- Every intermediate field containing the eight coordinates is the ambient field. -/
theorem eq_top_of_coordinates_mem (E : IntermediateField K (CoordinateField K))
    (hE : ∀ i, coordinate K i ∈ E) : E = ⊤ := by
  apply top_unique
  intro z _
  obtain ⟨p, q, -, rfl⟩ := IsFractionRing.div_surjective (CoordinatePolynomial K) z
  have hpoly (p : CoordinatePolynomial K) :
      algebraMap (CoordinatePolynomial K) (CoordinateField K) p ∈ E := by
    induction p using MvPolynomial.induction_on with
    | C a =>
      change algebraMap (CoordinatePolynomial K) (CoordinateField K)
        (algebraMap K (CoordinatePolynomial K) a) ∈ E
      rw [← IsScalarTower.algebraMap_apply]
      exact E.algebraMap_mem a
    | add p q hp hq => simpa only [map_add] using E.add_mem hp hq
    | mul_X p i hp => simpa only [map_mul, coordinate] using E.mul_mem hp (hE i)
  exact E.div_mem (hpoly p) (hpoly q)

/-- Adjoining the one anti-invariant difference reconstructs every original coordinate. -/
theorem adjoin_delta_eq_top :
    IntermediateField.adjoin (generatedField K) {delta K} =
      (⊤ : IntermediateField (generatedField K) (CoordinateField K)) := by
  let E := IntermediateField.adjoin (generatedField K) {delta K}
  have hincl {z : CoordinateField K} (hz : z ∈ generatedField K) : z ∈ E := by
    exact E.algebraMap_mem ⟨z, hz⟩
  have hd : delta K ∈ E := IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)
  have hdiff (i : Fin 4) : difference K i ∈ E := by
    refine Fin.cases hd (fun j => ?_) i
    rw [difference_eq_ratio_mul_delta]
    exact E.mul_mem (hincl (ratio_mem K j)) hd
  have hx (i : Fin 4) : x K i ∈ E := by
    rw [x_reconstruction]
    exact E.div_mem (E.add_mem (hincl (sumCoordinate_mem K i)) (hdiff i))
      (by norm_num)
  have hy (i : Fin 4) : y K i ∈ E := by
    rw [y_reconstruction]
    exact E.div_mem (E.sub_mem (hincl (sumCoordinate_mem K i)) (hdiff i))
      (by norm_num)
  have h := eq_top_of_coordinates_mem K (E.restrictScalars K) (fun i => by
    rcases i with i | i
    · exact hx i
    · exact hy i)
  apply IntermediateField.restrictScalars_injective K
  simpa only [IntermediateField.restrictScalars_top] using h

omit [CharZero K] in
theorem delta_isIntegral : IsIntegral (generatedField K) (delta K) := by
  apply IsIntegral.of_pow (n := 2) (by decide)
  exact isIntegral_algebraMap (R := generatedField K) (A := CoordinateField K)
    (x := (⟨squareDifference K, squareDifference_mem K⟩ : generatedField K))

instance coordinateField_finiteDimensional :
    FiniteDimensional (generatedField K) (CoordinateField K) := by
  let := IntermediateField.adjoin.finiteDimensional (delta_isIntegral K)
  let e := (IntermediateField.equivOfEq (adjoin_delta_eq_top K)).trans
    IntermediateField.topEquiv
  exact FiniteDimensional.of_injective e.symm.toLinearMap e.symm.injective

omit [CharZero K] in
theorem algebraicIndependent_coordinate : AlgebraicIndependent K (coordinate K) := by
  exact (IsTranscendenceBasis.mvPolynomial CoordinateIndex K).1.map
    (f := IsScalarTower.toAlgHom K (CoordinatePolynomial K) (CoordinateField K))
    (IsFractionRing.injective _ _).injOn

open scoped IntermediateField.algebraAdjoinAdjoin in
theorem algebraicIndependent_invariantGenerator :
    AlgebraicIndependent K (invariantGenerator K) := by
  let : Algebra.IsAlgebraic (generatedField K) (CoordinateField K) :=
    Algebra.IsAlgebraic.of_finite _ _
  let : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range (invariantGenerator K)))
      (CoordinateField K) := Algebra.IsAlgebraic.trans _ (generatedField K) _
  apply (Algebra.IsAlgebraic.isTranscendenceBasis_of_lift_le_trdeg_of_finite
    K (x := invariantGenerator K) ?_).1
  convert (algebraicIndependent_coordinate K).lift_cardinalMk_le_trdeg using 1
  simp

/-- The concrete field generated by the invariants is a rational function field. -/
def generatedFieldEquiv : RationalField K 8 ≃ₐ[K] generatedField K :=
  (IsFractionRing.algEquivOfAlgEquiv (MvPolynomial.renameEquiv K
    ((Fintype.equivFinOfCardEq (show Fintype.card GeneratorIndex = 8 by decide)).symm))).trans
    (algebraicIndependent_invariantGenerator K).aevalEquivField

theorem generatedField_rational : RationalOfDimension K (generatedField K) 8 :=
  ⟨(generatedFieldEquiv K).symm⟩

/-- The proposed generators give the whole fixed field, not just a fixed subfield. -/
theorem swapFixedField_eq_generatedField : swapFixedField K = generatedField K := by
  apply IntermediateField.toSubfield_injective
  exact SemilinearInvolution.fixedField_eq_of_adjoin (swap K).toRingEquiv
    (by norm_num) (generatedField K).toSubfield (generatedField_le_swapFixedField K)
    (delta_ne_zero K) (swap_delta K) (squareDifference_mem K) (adjoin_delta_eq_top K)

/-- The actual invariant field is rational in exactly eight independent variables. -/
def swapFixedFieldEquiv : swapFixedField K ≃ₐ[K] RationalField K 8 :=
  (IntermediateField.equivOfEq (swapFixedField_eq_generatedField K)).trans
    (generatedFieldEquiv K).symm

theorem swapFixedField_rational : RationalOfDimension K (swapFixedField K) 8 :=
  ⟨swapFixedFieldEquiv K⟩

/-- The reconstruction is a genuinely quadratic extension. -/
theorem finrank_swapFixedField :
    Module.finrank (swapFixedField K) (CoordinateField K) = 2 := by
  exact SemilinearInvolution.finrank_fixedField (swap K).toRingEquiv
    (swap_involutive K) (by norm_num) (swap_ne_refl K)

theorem finrank_generatedField :
    Module.finrank (generatedField K) (CoordinateField K) = 2 := by
  rw [← swapFixedField_eq_generatedField K]
  exact finrank_swapFixedField K

end Reconstruction

end M9.PermutationInvariants
