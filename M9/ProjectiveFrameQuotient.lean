module

public import M9.FrameFieldElimination
public import M9.ScalarProjectiveFixedField
public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Projective

/-!
# The projective pair-frame connected invariant field

Projective pair functions are generated by literal ratios of entries of the
two original independent invertible frames. Their connected invariants are
identified with the native function field of projective ternary matrix space.
-/

@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 300000
set_option maxRecDepth 2048
open scoped Classical Matrix BigOperators

namespace M9.ProjectiveFrameQuotient
open MvPolynomial FrameFieldElimination

abbrev MF := MatrixField ℂ
abbrev PF := PairField ℂ
abbrev NativeMatrixField := ProjectiveFunctionField.matrixFunctionField

def finOneUnitEquiv : Fin 1 ≃ Unit where
  toFun _ := ()
  invFun _ := 0
  left_inv _ := Subsingleton.elim _ _
  right_inv _ := Subsingleton.elim _ _

def matrixIndexEquiv : Index ≃ Fin 8 ⊕ Unit :=
  finProdFinEquiv.trans ((finSumFinEquiv : Fin 8 ⊕ Fin 1 ≃ Fin 9).symm.trans
    (Equiv.sumCongr (Equiv.refl (Fin 8)) finOneUnitEquiv))

def pivotIndex : Index := matrixIndexEquiv.symm (.inr ())
def affineIndex (i : Fin 8) : Index := matrixIndexEquiv.symm (.inl i)

@[simp] theorem pivotIndex_eq : pivotIndex = (2,2) := by decide

def matrixHomogeneousEquiv : MF ≃ₐ[ℂ] ScalarProjectiveFixedField.Homogeneous ℂ (Fin 8) :=
  M9.rationalFieldReindex ℂ matrixIndexEquiv

@[simp] theorem matrixHomogeneous_coordinate (ij : Index) :
    matrixHomogeneousEquiv (genericFieldMatrix ℂ ij.1 ij.2) =
      ScalarProjectiveFixedField.homogeneousVariable ℂ (Fin 8) (matrixIndexEquiv ij) := by
  change M9.rationalFieldReindex ℂ matrixIndexEquiv
    (algebraMap (ConstantFrameElimination.PolynomialRing ℂ 3) MF (X ij)) = _
  rw [M9.rationalFieldReindex_algebraMap]
  simp only [MvPolynomial.rename_X]
  rfl

def matrixScale (a : ℂˣ) : MF ≃ₐ[ℂ] MF :=
  ProjectiveNoName.fractionScale Index (a : ℂ) a.ne_zero

@[simp] theorem matrixScale_coordinate (a : ℂˣ) (ij : Index) :
    matrixScale a (genericFieldMatrix ℂ ij.1 ij.2) =
      algebraMap ℂ MF (a : ℂ) * genericFieldMatrix ℂ ij.1 ij.2 :=
  ProjectiveNoName.fractionScale_variable Index (a : ℂ) a.ne_zero ij

def firstScale (a : ℂˣ) : PF ≃ₐ[ℂ] PF :=
  ProjectiveNoName.rationalCoefficientEquiv ℂ Index (matrixScale a)

theorem firstScale_firstFrame (a : ℂˣ) (i j : Fin 3) :
    firstScale a (firstFrame ℂ i j) = algebraMap ℂ PF (a : ℂ) * firstFrame ℂ i j := by
  change ProjectiveNoName.rationalCoefficientEquiv ℂ Index (matrixScale a)
    (algebraMap MF PF (genericFieldMatrix ℂ i j)) = _
  rw [ProjectiveNoName.rationalCoefficientEquiv_coefficient, matrixScale_coordinate a (i,j), map_mul]
  rfl

theorem firstScale_secondFrame (a : ℂˣ) (i j : Fin 3) :
    firstScale a (secondFrame ℂ i j) = secondFrame ℂ i j :=
  ProjectiveNoName.rationalCoefficientEquiv_variable ℂ Index (matrixScale a) (i,j)

theorem firstScale_invariantMatrix (a : ℂˣ) (i j : Fin 3) :
    firstScale a (invariantMatrix ℂ i j) = algebraMap ℂ PF (a : ℂ) * invariantMatrix ℂ i j := by
  change firstScale a (∑ k : Fin 3, secondFrame ℂ k i * firstFrame ℂ k j) =
    algebraMap ℂ PF (a : ℂ) * ∑ k : Fin 3, secondFrame ℂ k i * firstFrame ℂ k j
  simp only [map_sum, map_mul, firstScale_firstFrame, firstScale_secondFrame, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k _
  ring

theorem firstScale_invariantEmbedding (a : ℂˣ) (r : MF) :
    firstScale a (invariantEmbedding ℂ r) = invariantEmbedding ℂ (matrixScale a r) := by
  have he : (firstScale a).toRingHom.comp (invariantEmbedding ℂ).toRingHom =
      (invariantEmbedding ℂ).toRingHom.comp (matrixScale a).toRingHom := by
    apply ProjectiveNoName.rationalRingHom_ext ℂ Index
    · intro c
      change firstScale a (invariantEmbedding ℂ (algebraMap ℂ MF c)) =
        invariantEmbedding ℂ (matrixScale a (algebraMap ℂ MF c))
      rw [(invariantEmbedding ℂ).commutes, (firstScale a).commutes,
        (matrixScale a).commutes, (invariantEmbedding ℂ).commutes]
    · intro ij
      change firstScale a (invariantEmbedding ℂ (genericFieldMatrix ℂ ij.1 ij.2)) =
        invariantEmbedding ℂ (matrixScale a (genericFieldMatrix ℂ ij.1 ij.2))
      rw [invariantEmbedding_coordinate, matrixScale_coordinate, map_mul,
        (invariantEmbedding ℂ).commutes, invariantEmbedding_coordinate]
      exact firstScale_invariantMatrix a ij.1 ij.2
  exact RingHom.congr_fun he r

theorem matrixHomogeneous_scale (a : ℂˣ) (r : MF) :
    matrixHomogeneousEquiv (matrixScale a r) = ScalarProjectiveFixedField.scalarScale ℂ (Fin 8) a
      (matrixHomogeneousEquiv r) := by
  have he : matrixHomogeneousEquiv.toRingHom.comp (matrixScale a).toRingHom =
      (ScalarProjectiveFixedField.scalarScale ℂ (Fin 8) a).toRingHom.comp matrixHomogeneousEquiv.toRingHom := by
    apply ProjectiveNoName.rationalRingHom_ext ℂ Index
    · intro c
      change matrixHomogeneousEquiv (matrixScale a (algebraMap ℂ MF c)) =
        ScalarProjectiveFixedField.scalarScale ℂ (Fin 8) a
          (matrixHomogeneousEquiv (algebraMap ℂ MF c))
      simp only [AlgEquiv.commutes]
    · intro ij
      change matrixHomogeneousEquiv (matrixScale a (genericFieldMatrix ℂ ij.1 ij.2)) =
        ScalarProjectiveFixedField.scalarScale ℂ (Fin 8) a
          (matrixHomogeneousEquiv (genericFieldMatrix ℂ ij.1 ij.2))
      rw [matrixScale_coordinate, map_mul, matrixHomogeneousEquiv.commutes,
        matrixHomogeneous_coordinate, ScalarProjectiveFixedField.scalarScale_variable]
  exact RingHom.congr_fun he r

/-- Native projective matrix functions embed into the original nine-coordinate
matrix field through their literal normalized coordinate ratios. -/
def matrixProjectiveEmbedding : NativeMatrixField →ₐ[ℂ] MF :=
  matrixHomogeneousEquiv.symm.toAlgHom.comp
    ((ScalarProjectiveFixedField.scalarFixedField ℂ (Fin 8)).val.comp
      ScalarProjectiveFixedField.nativeMatrixFixedEquiv.toAlgHom)

theorem matrixProjectiveEmbedding_coordinateRatio (i : Fin 8) :
    matrixProjectiveEmbedding (ProjectiveFunctionField.coordinateRatio 8 (Fin.last 8) i) =
      genericFieldMatrix ℂ (affineIndex i).1 (affineIndex i).2 /
        genericFieldMatrix ℂ pivotIndex.1 pivotIndex.2 := by
  apply matrixHomogeneousEquiv.injective
  change matrixHomogeneousEquiv (matrixHomogeneousEquiv.symm
    (ScalarProjectiveFixedField.nativeMatrixFixedEquiv
      (ProjectiveFunctionField.coordinateRatio 8 (Fin.last 8) i)).val) = _
  rw [AlgEquiv.apply_symm_apply, ScalarProjectiveFixedField.nativeMatrixFixedEquiv_coordinateRatio,
    map_div₀, matrixHomogeneous_coordinate, matrixHomogeneous_coordinate]
  simp only [affineIndex, pivotIndex, Equiv.apply_symm_apply]

theorem matrixScalarInvariant_iff (r : MF) :
    (∀ a : ℂˣ, matrixScale a r = r) ↔ ∃ f : NativeMatrixField, matrixProjectiveEmbedding f = r := by
  constructor
  · intro h
    have hf : matrixHomogeneousEquiv r ∈ ScalarProjectiveFixedField.scalarFixedField ℂ (Fin 8) := by
      rw [ScalarProjectiveFixedField.mem_scalarFixedField_iff]
      intro a
      rw [← matrixHomogeneous_scale, h a]
    obtain ⟨f,hf'⟩ := ScalarProjectiveFixedField.nativeMatrixFixedEquiv.surjective
      ⟨matrixHomogeneousEquiv r,hf⟩
    refine ⟨f, ?_⟩
    apply matrixHomogeneousEquiv.injective
    change matrixHomogeneousEquiv (matrixHomogeneousEquiv.symm
      (ScalarProjectiveFixedField.nativeMatrixFixedEquiv f).val) = _
    rw [AlgEquiv.apply_symm_apply]
    exact congrArg Subtype.val hf'
  · rintro ⟨f,rfl⟩ a
    apply matrixHomogeneousEquiv.injective
    rw [matrixHomogeneous_scale]
    change ScalarProjectiveFixedField.scalarScale ℂ (Fin 8) a
      (matrixHomogeneousEquiv (matrixHomogeneousEquiv.symm
        (ScalarProjectiveFixedField.nativeMatrixFixedEquiv f).val)) =
      matrixHomogeneousEquiv (matrixHomogeneousEquiv.symm
        (ScalarProjectiveFixedField.nativeMatrixFixedEquiv f).val)
    rw [AlgEquiv.apply_symm_apply]
    exact (ScalarProjectiveFixedField.mem_scalarFixedField_iff ℂ (Fin 8) _).mp
      (ScalarProjectiveFixedField.nativeMatrixFixedEquiv f).property a


def firstPivot : PF := firstFrame ℂ pivotIndex.1 pivotIndex.2
def secondPivot : PF := secondFrame ℂ pivotIndex.1 pivotIndex.2

theorem firstPivot_ne_zero : firstPivot ≠ 0 := by
  have hx : genericFieldMatrix ℂ pivotIndex.1 pivotIndex.2 ≠ 0 := by
    intro h
    apply MvPolynomial.X_ne_zero (R := ℂ) pivotIndex
    exact (IsFractionRing.injective (ConstantFrameElimination.PolynomialRing ℂ 3) MF)
      (h.trans (map_zero _).symm)
  change algebraMap MF PF (genericFieldMatrix ℂ pivotIndex.1 pivotIndex.2) ≠ 0
  simpa only [map_zero] using (algebraMap MF PF).injective.ne hx

theorem secondPivot_ne_zero : secondPivot ≠ 0 := by
  intro h
  apply MvPolynomial.X_ne_zero (R := MF) pivotIndex
  exact (IsFractionRing.injective (ConstantFrameElimination.PolynomialRing MF 3) PF)
    (h.trans (map_zero _).symm)

/-- The projective pair field is defined by actual coordinate ratios in
both original frames, independently of any invariant-field conclusion. -/
def projectivePairField : IntermediateField ℂ PF :=
  IntermediateField.adjoin ℂ
    (Set.range (fun ij : Index => firstFrame ℂ ij.1 ij.2 / firstPivot) ∪
      Set.range (fun ij : Index => secondFrame ℂ ij.1 ij.2 / secondPivot))

theorem firstRatio_mem (ij : Index) : firstFrame ℂ ij.1 ij.2 / firstPivot ∈ projectivePairField :=
  IntermediateField.subset_adjoin ℂ _ (Or.inl ⟨ij,rfl⟩)

theorem secondRatio_mem (ij : Index) : secondFrame ℂ ij.1 ij.2 / secondPivot ∈ projectivePairField :=
  IntermediateField.subset_adjoin ℂ _ (Or.inr ⟨ij,rfl⟩)

theorem firstScale_projectivePair (a : ℂˣ) (f : PF) (hf : f ∈ projectivePairField) :
    firstScale a f = f := by
  have hc : algebraMap ℂ PF (a : ℂ) ≠ 0 := by
    simpa only [map_zero] using (algebraMap ℂ PF).injective.ne a.ne_zero
  refine IntermediateField.adjoin_induction (F := ℂ) (motive := fun y _ => firstScale a y = y)
    ?_ ?_ ?_ ?_ ?_ hf
  · rintro _ (⟨ij,rfl⟩ | ⟨ij,rfl⟩)
    · change firstScale a (firstFrame ℂ ij.1 ij.2 / firstPivot) = _
      rw [map_div₀, firstScale_firstFrame]
      rw [show firstScale a firstPivot = algebraMap ℂ PF (a : ℂ) * firstPivot from
        firstScale_firstFrame a pivotIndex.1 pivotIndex.2]
      exact mul_div_mul_left _ _ hc
    · change firstScale a (secondFrame ℂ ij.1 ij.2 / secondPivot) = _
      rw [map_div₀, firstScale_secondFrame]
      rw [show firstScale a secondPivot = secondPivot from
        firstScale_secondFrame a pivotIndex.1 pivotIndex.2]
  · intro c
    exact (firstScale a).commutes c
  · intro y z _ _ hy hz
    rw [map_add, hy, hz]
  · intro y _ hy
    rw [map_inv₀, hy]
  · intro y z _ _ hy hz
    rw [map_mul, hy, hz]

theorem normalizedInvariant_mem (ij : Index) :
    invariantMatrix ℂ ij.1 ij.2 / (secondPivot * firstPivot) ∈ projectivePairField := by
  have he : invariantMatrix ℂ ij.1 ij.2 / (secondPivot * firstPivot) =
      ∑ k : Fin 3, (secondFrame ℂ k ij.1 / secondPivot) * (firstFrame ℂ k ij.2 / firstPivot) := by
    change (∑ k : Fin 3, secondFrame ℂ k ij.1 * firstFrame ℂ k ij.2) /
      (secondPivot * firstPivot) = _
    rw [Finset.sum_div]
    apply Finset.sum_congr rfl
    intro k _
    exact (div_mul_div_comm _ _ _ _).symm
  rw [he]
  apply IntermediateField.sum_mem
  intro k _
  exact projectivePairField.mul_mem (secondRatio_mem (k,ij.1)) (firstRatio_mem (k,ij.2))

theorem invariantRatio_mem (ij : Index) :
    invariantMatrix ℂ ij.1 ij.2 / invariantMatrix ℂ pivotIndex.1 pivotIndex.2 ∈ projectivePairField := by
  have h := projectivePairField.div_mem (normalizedInvariant_mem ij) (normalizedInvariant_mem pivotIndex)
  rwa [div_div_div_cancel_right₀ (mul_ne_zero secondPivot_ne_zero firstPivot_ne_zero)] at h

def projectiveInvariantEmbedding : NativeMatrixField →ₐ[ℂ] PF :=
  (invariantEmbedding ℂ).comp matrixProjectiveEmbedding

theorem projectiveInvariantEmbedding_coordinateRatio (i : Fin 8) :
    projectiveInvariantEmbedding (ProjectiveFunctionField.coordinateRatio 8 (Fin.last 8) i) =
      invariantMatrix ℂ (affineIndex i).1 (affineIndex i).2 /
        invariantMatrix ℂ pivotIndex.1 pivotIndex.2 := by
  rw [projectiveInvariantEmbedding, AlgHom.comp_apply, matrixProjectiveEmbedding_coordinateRatio,
    map_div₀, invariantEmbedding_coordinate, invariantEmbedding_coordinate]

theorem rationalMap_mem (T : IntermediateField ℂ PF)
    (φ : RationalField ℂ 8 →ₐ[ℂ] PF)
    (hX : ∀ i : Fin 8, φ (algebraMap (MvPolynomial (Fin 8) ℂ) (RationalField ℂ 8) (X i)) ∈ T)
    (r : RationalField ℂ 8) : φ r ∈ T := by
  have hp : ∀ p : MvPolynomial (Fin 8) ℂ,
      φ (algebraMap (MvPolynomial (Fin 8) ℂ) (RationalField ℂ 8) p) ∈ T := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C c =>
      change φ (algebraMap ℂ (RationalField ℂ 8) c) ∈ T
      rw [φ.commutes]
      exact T.algebraMap_mem c
    | add p q hp hq =>
      rw [map_add, map_add]
      exact T.add_mem hp hq
    | mul_X p i hp =>
      rw [map_mul, map_mul]
      exact T.mul_mem hp (hX i)
  obtain ⟨p,q,_,rfl⟩ := IsFractionRing.div_surjective (MvPolynomial (Fin 8) ℂ) r
  rw [map_div₀]
  exact T.div_mem (hp p) (hp q)

theorem projectiveInvariantEmbedding_mem (f : NativeMatrixField) :
    projectiveInvariantEmbedding f ∈ projectivePairField := by
  let e := ProjectiveFunctionField.matrixFunctionFieldEquiv
  let φ := projectiveInvariantEmbedding.comp e.symm.toAlgHom
  have hX (i : Fin 8) :
      φ (algebraMap (MvPolynomial (Fin 8) ℂ) (RationalField ℂ 8) (X i)) ∈ projectivePairField := by
    have hi : e (ProjectiveFunctionField.coordinateRatio 8 (Fin.last 8) i) =
        algebraMap (MvPolynomial (Fin 8) ℂ) (RationalField ℂ 8) (X i) :=
      ProjectiveFunctionField.functionFieldEquiv_coordinateRatio 8 (Fin.last 8) i
    change projectiveInvariantEmbedding (e.symm
      (algebraMap (MvPolynomial (Fin 8) ℂ) (RationalField ℂ 8) (X i))) ∈ _
    rw [← hi, AlgEquiv.symm_apply_apply, projectiveInvariantEmbedding_coordinateRatio]
    exact invariantRatio_mem (affineIndex i)
  have h := rationalMap_mem projectivePairField φ hX (e f)
  change projectiveInvariantEmbedding (e.symm (e f)) ∈ _ at h
  rwa [AlgEquiv.symm_apply_apply] at h

/-- Rational functions of the original pair of projective frames that are
fixed by the actual connected frame action in the ambient field. -/
def projectiveConnectedField : IntermediateField ℂ PF := projectivePairField ⊓ connectedFixedField ℂ

theorem mem_projectiveConnectedField_iff (f : PF) :
    f ∈ projectiveConnectedField ↔ f ∈ projectivePairField ∧
      ∀ g : ConstantFrameElimination.GLn ℂ 3, pairActionHom ℂ g f = f := by
  change (f ∈ projectivePairField ∧ f ∈ connectedFixedField ℂ) ↔ _
  rw [mem_connectedFixedField_iff]

/-- The projective connected quotient is the native projective matrix
function field, by the original ratio inclusion. -/
theorem projective_connected_invariant_iff (f : PF) :
    f ∈ projectiveConnectedField ↔ ∃ r : NativeMatrixField, projectiveInvariantEmbedding r = f := by
  constructor
  · intro hf
    obtain ⟨a,ha⟩ := (connected_invariant_iff ℂ f).mp hf.2
    have hs : ∀ u : ℂˣ, matrixScale u a = a := by
      intro u
      have he := firstScale_projectivePair u f hf.1
      rw [← ha, firstScale_invariantEmbedding] at he
      exact (invariantEmbedding ℂ).injective he
    obtain ⟨r,hr⟩ := (matrixScalarInvariant_iff a).mp hs
    refine ⟨r, ?_⟩
    change invariantEmbedding ℂ (matrixProjectiveEmbedding r) = f
    rw [hr, ha]
  · rintro ⟨r,rfl⟩
    exact ⟨projectiveInvariantEmbedding_mem r,
      (connected_invariant_iff ℂ _).mpr ⟨matrixProjectiveEmbedding r,rfl⟩⟩

theorem projectiveInvariantEmbedding_fieldRange :
    projectiveInvariantEmbedding.fieldRange = projectiveConnectedField := by
  ext f
  exact (projective_connected_invariant_iff f).symm

def projectiveConnectedQuotientEquiv : NativeMatrixField ≃ₐ[ℂ] projectiveConnectedField :=
  projectiveInvariantEmbedding.equivFieldRange.trans
    (IntermediateField.equivOfEq projectiveInvariantEmbedding_fieldRange)

theorem projectiveConnectedQuotientEquiv_coordinateRatio (i : Fin 8) :
    (projectiveConnectedQuotientEquiv
      (ProjectiveFunctionField.coordinateRatio 8 (Fin.last 8) i) : PF) =
        invariantMatrix ℂ (affineIndex i).1 (affineIndex i).2 /
          invariantMatrix ℂ pivotIndex.1 pivotIndex.2 :=
  projectiveInvariantEmbedding_coordinateRatio i

end M9.ProjectiveFrameQuotient
