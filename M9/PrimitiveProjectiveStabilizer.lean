module

public import M9.PrimitiveStabilizerConverse
public import M9.CentralSignQuotient

/-!
# The actual projective primitive line stabilizer

The generic central-sign quotient theorem is instantiated with the genuine
symplectic line stabilizer, its connected special-linear blocks, and the
actual exchanging element. All four normal forms and parity facts are
discharged by the proved converse; no stabilizer-classification premise
remains in the resulting isomorphism.
-/

@[expose] public section
noncomputable section
set_option maxRecDepth 4096
set_option maxHeartbeats 1000000

namespace M9.PrimitiveProjectiveStabilizer

open PrimitiveStabilizer

variable (K : Type*) [Field K] [CharZero K]

abbrev SL3 := Matrix.SpecialLinearGroup (Fin 3) K

/-- Every input of the quotient construction is supplied by the actual symplectic stabilizer. -/
def quotientData (i : K) (hi : i ^ 2 = -1) :
    CentralSignQuotient.Data (SL3 K) (lineStabilizer K) where
  iota := blockStabilizerHom K
  iota_injective := blockStabilizerHom_injective K
  psi := inverseTransposeAut K
  psi_sq := inverseTransposeAut_square K
  z := centralSign K
  s := swappingElement K i hi
  z_central h := Subtype.ext (negativeIdentity_central K h.val)
  z_sq := Subtype.ext (negativeIdentity_square K)
  s_sq := Subtype.ext (exchanging_square K i hi)
  conjugation g := Subtype.ext (exchanging_block K i hi g)
  z_not_range := centralSign_not_range K
  parity := stabilizerParity K
  parity_iota := stabilizerParity_block K
  parity_s := stabilizerParity_swapping K i hi
  normalForms h := by
    obtain ⟨g, hg⟩ := stabilizer_normalForms K i hi h.val h.property
    refine ⟨g, ?_⟩
    rcases hg with hg | hg | hg | hg
    · exact Or.inl (Subtype.ext hg)
    · exact Or.inr (Or.inl (Subtype.ext hg))
    · exact Or.inr (Or.inr (Or.inl (Subtype.ext hg)))
    · exact Or.inr (Or.inr (Or.inr (Subtype.ext hg)))

/-- The cyclic subgroup generated by the actual negative identity in the actual stabilizer. -/
abbrev centralSignSubgroup : Subgroup (lineStabilizer K) := Subgroup.zpowers (centralSign K)

instance centralSignSubgroup_normal : (centralSignSubgroup K).Normal := by
  apply Subgroup.normal_of_le_center
  apply Subgroup.zpowers_le.mpr
  exact Subgroup.mem_center_iff.mpr (fun h => Subtype.ext (negativeIdentity_central K h.val).symm)

/-- The literal line-stabilizer quotient by the symplectic central sign. -/
abbrev projectiveLineStabilizer := lineStabilizer K ⧸ centralSignSubgroup K

/-- The actual inverse-transpose action of the cyclic group of order two on `SL₃`. -/
def inverseTransposeAction : CentralSignQuotient.C2 →* MulAut (SL3 K) :=
  CentralSignQuotient.involutionHom (inverseTransposeAut K) (inverseTransposeAut_square K)

@[simp] theorem inverseTransposeAction_epsilon :
    inverseTransposeAction K CentralSignQuotient.epsilon = inverseTransposeAut K := by
  simp [inverseTransposeAction]

/-- The genuine semidirect product in Lemma 2.1. -/
abbrev specialLinearSemidirect := SL3 K ⋊[inverseTransposeAction K] CentralSignQuotient.C2

/-- The actual projective line stabilizer is `SL₃ ⋊ C₂`, with inverse-transpose conjugation. -/
def stabilizerQuotientEquiv (i : K) (hi : i ^ 2 = -1) :
    projectiveLineStabilizer K ≃* specialLinearSemidirect K :=
  (quotientData K i hi).centralQuotientEquiv

@[simp] theorem stabilizerQuotientEquiv_block (i : K) (hi : i ^ 2 = -1) (g : SL3 K) :
    stabilizerQuotientEquiv K i hi
      (QuotientGroup.mk' (centralSignSubgroup K) (blockStabilizerHom K g)) =
      SemidirectProduct.inl g :=
  (quotientData K i hi).centralQuotientEquiv_iota g

@[simp] theorem stabilizerQuotientEquiv_swapping (i : K) (hi : i ^ 2 = -1) :
    stabilizerQuotientEquiv K i hi
      (QuotientGroup.mk' (centralSignSubgroup K) (swappingElement K i hi)) =
      SemidirectProduct.inr CentralSignQuotient.epsilon :=
  (quotientData K i hi).centralQuotientEquiv_s

/-- The concrete quotient homomorphism has no kernel beyond the central sign. -/
def toProjectiveSemidirect (i : K) (hi : i ^ 2 = -1) :
    lineStabilizer K →* specialLinearSemidirect K :=
  (stabilizerQuotientEquiv K i hi).toMonoidHom.comp (QuotientGroup.mk' (centralSignSubgroup K))

theorem toProjectiveSemidirect_eq_data (i : K) (hi : i ^ 2 = -1) :
    toProjectiveSemidirect K i hi = (quotientData K i hi).toSemidirect := by
  apply MonoidHom.ext
  intro h
  exact (quotientData K i hi).centralQuotientEquiv_mk h

theorem toProjectiveSemidirect_kernel (i : K) (hi : i ^ 2 = -1) :
    (toProjectiveSemidirect K i hi).ker = centralSignSubgroup K := by
  rw [toProjectiveSemidirect_eq_data]
  exact (quotientData K i hi).toSemidirect_kernel

/-- The semidirect-product component is exactly the actual square-character parity. -/
theorem toProjectiveSemidirect_parity (i : K) (hi : i ^ 2 = -1) :
    SemidirectProduct.rightHom.comp (toProjectiveSemidirect K i hi) = stabilizerParity K := by
  rw [toProjectiveSemidirect_eq_data]
  exact (quotientData K i hi).toSemidirect_parity

theorem projectiveBlock_injective (i : K) (hi : i ^ 2 = -1) :
    Function.Injective
      (fun g : SL3 K => QuotientGroup.mk' (centralSignSubgroup K) (blockStabilizerHom K g)) := by
  intro g h hgh
  have he := congrArg (stabilizerQuotientEquiv K i hi) hgh
  rw [stabilizerQuotientEquiv_block, stabilizerQuotientEquiv_block] at he
  exact SemidirectProduct.inl_injective he

section Complex

/-- In particular the actual complex stabilizer has the asserted quotient without a root premise. -/
def complexStabilizerQuotientEquiv :
    projectiveLineStabilizer ℂ ≃* specialLinearSemidirect ℂ :=
  stabilizerQuotientEquiv ℂ Complex.I (by simp)

end Complex

end M9.PrimitiveProjectiveStabilizer
