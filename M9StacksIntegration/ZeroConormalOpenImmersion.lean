module

public import StacksFrontier.AlgebraicGeometry.Conormal.FirstOrderThickening
public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
public import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
public import Mathlib.RingTheory.Ideal.IdempotentFG
public import Mathlib.Topology.Connected.Clopen

/-!
# A finitely presented closed immersion with zero conormal is open

The actual affine conormal comparison identifies the sections of the
native conormal with the kernel quotient `I/I²`. Vanishing makes the
actual affine kernel idempotent. Finite presentation makes that kernel
finitely generated, so it is generated by an idempotent element, and the
actual affine quotient is an open immersion. Target locality globalizes
this statement, preserving the full scheme structure.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option autoImplicit false

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open RingedSpaceModuleAdjunction Stacks.Conormal Stacks.Thickenings

attribute [local implicit_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.Scheme.Modules AlgebraicGeometry.Scheme.Modules.Hom

universe u

namespace M9Native.ZeroConormalOpenImmersion

/-- Finite presentation of a surjective ring map gives a genuinely
finitely generated kernel. -/
theorem ker_fg_of_finitePresentation {R A : Type u} [CommRing R] [CommRing A]
    (f : R →+* A) (hfp : f.FinitePresentation) (hf : Function.Surjective f) :
    (RingHom.ker f).FG := by
  let : Algebra R A := f.toAlgebra
  let : Algebra.FinitePresentation R A := hfp
  exact Algebra.FinitePresentation.ker_fG_of_surjective (IsScalarTower.toAlgHom R R A) hf

variable {C S : Scheme.{u}} (i : C ⟶ S) [IsClosedImmersion i]

/-- Sections of an actual zero sheaf vanish on every open. -/
theorem isZero_sections {X : Scheme.{u}} {N : X.Modules} (h : IsZero N) (U : X.Opens) :
    IsZero (N.val.obj (op U)) := by
  rw [IsZero.iff_id_eq_zero]
  have h' := congrArg (fun f : N ⟶ N => f.val.app (op U)) (h.eq_of_src (𝟙 N) 0)
  exact h'

section Affine

variable (U : S.Opens) (hU : IsAffineOpen U) (I : Ideal Γ(S,U))
  (e : pullback i U.ι ≅ Spec (.of (Γ(S,U) ⧸ I)))
  (he : pullback.snd i U.ι ≫ hU.isoSpec.hom =
    e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))

include he

/-- The actual vanishing conormal forces the actual affine kernel
cotangent module to vanish, using the genuine affine conormal isomorphism. -/
theorem subsingleton_cotangent (h : IsZero (immersionConormalSheaf i)) :
    Subsingleton I.Cotangent := by
  have hp : IsZero ((modulePushforward i.toLRSHom.toShHom).obj
      (immersionConormalSheaf i)) := by
    let : (modulePushforward i.toLRSHom.toShHom).IsRightAdjoint :=
      modulePushforward_isRightAdjoint _
    exact Functor.map_isZero _ h
  have hc : IsZero (ModuleCat.of Γ(S,U) I.Cotangent) :=
    IsZero.of_iso (isZero_sections hp U) (affineConormalIsoCotangent i U hU I e he).symm
  exact ModuleCat.isZero_iff_subsingleton.mp hc

omit [IsClosedImmersion i] in
/-- Finite presentation is used at the actual affine chart, precisely
where finite generation of the defining ideal is needed. -/
theorem affineIdeal_fg [LocallyOfFinitePresentation i] : I.FG := by
  have hV := isAffineOpen_preimage_of_affineModel i U I e
  have hfp := i.finitePresentation_appLE hU hV
    (le_rfl : i ⁻¹ᵁ U ≤ i ⁻¹ᵁ U)
  rw [← ker_appLE_eq_of_affineModel i U hU I e he]
  exact ker_fg_of_finitePresentation _ hfp
    (surjective_appLE_of_affineModel i U hU I e he)

/-- The actual affine quotient map is open: its finitely generated
kernel is generated by an idempotent, derived from its zero cotangent. -/
theorem quotient_isOpenImmersion [LocallyOfFinitePresentation i]
    (h : IsZero (immersionConormalSheaf i)) :
    IsOpenImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
  have hc := subsingleton_cotangent i U hU I e he h
  have hid : IsIdempotentElem I := (Ideal.cotangent_subsingleton_iff I).mp hc
  obtain ⟨a, ha, hIa⟩ := (Ideal.isIdempotentElem_iff_of_fg I
    (affineIdeal_fg i U hU I e he)).mp hid
  exact (isOpenImmersion_SpecMap_iff_of_surjective _ Ideal.Quotient.mk_surjective).mpr
    ⟨a, ha, by simpa using hIa⟩

end Affine

/-- Every actual affine-target restriction is open, with the original
quotient-model compatibility retaining the morphism itself. -/
theorem restrict_isOpenImmersion [LocallyOfFinitePresentation i]
    (h : IsZero (immersionConormalSheaf i)) (U : S.Opens) (hU : IsAffineOpen U) :
    IsOpenImmersion (i ∣_ U) := by
  obtain ⟨I, e, he⟩ := exists_affineModel i U hU
  let : IsOpenImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    quotient_isOpenImmersion i U hU I e he h
  let : IsOpenImmersion ((i ∣_ U) ≫ hU.isoSpec.hom) := by
    rw [morphismRestrict_isoSpec_hom_eq i U hU I e he]
    infer_instance
  exact IsOpenImmersion.of_comp (i ∣_ U) hU.isoSpec.hom

/-- A closed immersion locally of finite presentation with zero native
conormal is an actual open immersion. -/
theorem isOpenImmersion_of_isZero_conormal [LocallyOfFinitePresentation i]
    (h : IsZero (immersionConormalSheaf i)) : IsOpenImmersion i := by
  apply IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsOpenImmersion)
    (fun U : S.affineOpens => (U : S.Opens)) (iSup_affineOpens_eq_top S)
  intro U
  exact restrict_isOpenImmersion i h U.1 U.2

/-- The open-and-closed image is the entire connected target when the
source is nonempty, so the original immersion is an isomorphism. -/
theorem isIso_of_isZero_conormal [LocallyOfFinitePresentation i]
    [Nonempty C] [ConnectedSpace S] (h : IsZero (immersionConormalSheaf i)) : IsIso i := by
  let : IsOpenImmersion i := isOpenImmersion_of_isZero_conormal i h
  have hc : IsClopen (Set.range i.base) :=
    ⟨i.isClosedEmbedding.isClosed_range, i.isOpenEmbedding.isOpen_range⟩
  have hr : Set.range i.base = Set.univ := hc.eq_univ (Set.range_nonempty i.base)
  exact (isIso_iff_isOpenImmersion_and_epi_base i).mpr
    ⟨inferInstance, (TopCat.epi_iff_surjective i.base).mpr (Set.range_eq_univ.mp hr)⟩

end M9Native.ZeroConormalOpenImmersion
