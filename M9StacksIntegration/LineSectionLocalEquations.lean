module

public import M9StacksIntegration.LineSectionIdealSum
public import M9StacksIntegration.OrderedPrefixRegularity
public import StacksFrontier.AlgebraicGeometry.F6Rank89.IdealSheafStalk

/-!
# Actual ordered local equations of successive line-section cuts

The local ring of the literal successive cut is the quotient by the germs
of the original scalar equations in their original order. The equations
come from a genuine affine line frame; the kernel equality and local-ring
identification are conclusions.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u
namespace M9Native.LineSectionLocalEquations
open IteratedLineSectionCuts

variable {X : Scheme.{u}} (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]

def coefficient (U : X.affineOpens) (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1))
    (s : Γ(L, ⊤)) : Γ(X, U.1) :=
  e (L.presheaf.map (homOfLE le_top).op s)

/-- The actual affine ideal has the original ordered list of equations. -/
theorem affine_ideal (ss : List Γ(L, ⊤)) (U : X.affineOpens)
    (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) :
    (LineSectionIdealSum.ideal L ss).ideal U =
      Ideal.ofList (ss.map (coefficient L U e)) := by
  rw [LineSectionIdealSum.ideal, Scheme.IdealSheafData.ideal_iSup, iSup_apply]
  have heq : (fun s : {s : Γ(L, ⊤) // s ∈ ss} =>
      (Stacks.Divisors.zeroScheme X L s.1).ideal U) =
      (fun s : {s : Γ(L, ⊤) // s ∈ ss} => Ideal.span {coefficient L U e s.1}) := by
    funext s
    exact zeroScheme_ideal_of_trivialization X L s.1 U e _ rfl
  rw [heq, ← Ideal.span_range_eq_iSup, Ideal.ofList]
  congr 1
  ext a
  simp only [Set.mem_range, Set.mem_ofPred_eq, List.mem_map]
  constructor
  · rintro ⟨s, rfl⟩
    exact ⟨s.1, s.2, rfl⟩
  · rintro ⟨s, hs, rfl⟩
    exact ⟨⟨s, hs⟩, rfl⟩

def localEquations (ss : List Γ(L, ⊤)) (U : X.affineOpens)
    (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) (x : X) (hx : x ∈ U.1) :
    List (X.presheaf.stalk x) :=
  ss.map (fun s => X.presheaf.germ U.1 x hx (coefficient L U e s))

omit [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] in
theorem localEquations_length (ss : List Γ(L, ⊤)) (U : X.affineOpens)
    (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) (x : X) (hx : x ∈ U.1) :
    (localEquations L ss U e x hx).length = ss.length := List.length_map _

omit [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] in
theorem localEquations_take (ss : List Γ(L, ⊤)) (U : X.affineOpens)
    (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) (x : X) (hx : x ∈ U.1) (i : ℕ) :
    localEquations L (ss.take i) U e x hx = (localEquations L ss U e x hx).take i :=
  List.map_take

/-- The actual closed-immersion stalk map has kernel generated by those
very ordered local equations. -/
theorem stalkMap_kernel (ss : List Γ(L, ⊤))
    (z : (simultaneousCut L ss).left) (U : X.affineOpens)
    (hz : (simultaneousCut L ss).hom z ∈ U.1)
    (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) :
    RingHom.ker ((simultaneousCut L ss).hom.stalkMap z).hom =
      Ideal.ofList (localEquations L ss U e ((simultaneousCut L ss).hom z) hz) := by
  rw [← IdealSheafData.stalk_ker_of_isClosedImmersion (simultaneousCut L ss).hom z,
    LineSectionIdealSum.cut_ker, IdealSheafData.stalk_eq_map_germ _ _ U hz,
    affine_ideal, Ideal.map_ofList, List.map_map]
  rfl

/-- The actual local ring of the original cut, with no quotient
identification hypothesis. -/
def stalkQuotientEquiv (ss : List Γ(L, ⊤))
    (z : (simultaneousCut L ss).left) (U : X.affineOpens)
    (hz : (simultaneousCut L ss).hom z ∈ U.1)
    (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) :
    (X.presheaf.stalk ((simultaneousCut L ss).hom z) ⧸
        Ideal.ofList (localEquations L ss U e ((simultaneousCut L ss).hom z) hz)) ≃+*
      (simultaneousCut L ss).left.presheaf.stalk z :=
  (Ideal.quotEquivOfEq (stalkMap_kernel L ss z U hz e).symm).trans
    (RingHom.quotientKerEquivOfSurjective ((simultaneousCut L ss).hom.stalkMap_surjective z))

end M9Native.LineSectionLocalEquations
