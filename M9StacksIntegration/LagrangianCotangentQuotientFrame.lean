module

public import M9StacksIntegration.LagrangianQuotientCoordinates
public import M9StacksIntegration.LagrangianSymmetricPullbackProduct

/-! The actual intrinsic cotangent map under an actual quotient-frame change. -/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
set_option maxRecDepth 4096

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped TensorProduct

universe u

namespace M9Native.LagrangianCotangentQuotientFrame

open LagrangianGrassmannian LagrangianMatrixChart LagrangianDualCoefficients
open LagrangianCotangentMap LagrangianCotangentSections LagrangianLocalPairing
open LagrangianQuotientCoordinates LagrangianSymmetricPullback LagrangianSymmetricPullbackProduct
open Stacks.AlgebraicGeometry.ReflexiveModules

variable {X S : Scheme.{u}} {Q Q' : X.Modules}

/-- Native symmetric sheafification is generated by its actual local
products; no freeness assumption is required. -/
theorem symmetricHom_ext_products (F : X.Modules) {N : X.Modules}
    {a b : symmetricSquare F ⟶ N}
    (h : ∀ (U : X.Opens) (α β : Γ(F,U)),
      a.val.app (op U) (product F U α β)=b.val.app (op U) (product F U α β)) : a=b := by
  apply (PresheafOfModules.sheafificationHomEquiv (𝟙 X.ringCatSheaf.obj)).injective
  apply PresheafOfModules.hom_ext
  intro U
  apply ModuleCat.hom_ext
  apply SymPow.sqMul_ext
  intro α β
  exact h U.unop α β

/-- The original sheaf cotangent map transforms by the actual dual of
an actual morphism of quotient bundles. -/
theorem cotangentMap_target_comp (p : X ⟶ S) (q : freeOn X 6 ⟶ Q)
    (hq : AnnihilatesSigma X q) (φ : Q ⟶ Q')
    (hφ : AnnihilatesSigma X (q ≫ φ)) :
    symmetricMap (dualMap φ) 2 ≫ cotangentMap p q hq=
      cotangentMap p (q ≫ φ) hφ := by
  apply symmetricHom_ext_products (dualSheaf Q')
  intro U α β
  have h₀ := symmetricMap_product (dualMap φ) U α β
  have h₁ := cotangentMap_squareUnit_product p q hq U ((dualMap φ).app U α) ((dualMap φ).app U β)
  have h₂ := localPairing_comp p q hq φ hφ U α β
  have h₃ := cotangentMap_squareUnit_product p (q ≫ φ) hφ U α β
  exact (congrArg (fun z => (cotangentMap p q hq).val.app (op U) z) h₀).trans
    (h₁.trans (h₂.symm.trans h₃.symm))

/-- Invertibility in an actual quotient frame implies invertibility
of the same intrinsic morphism before the frame change. -/
theorem cotangentMap_isIso_of_targetIso (p : X ⟶ S) (q : freeOn X 6 ⟶ Q)
    (hq : AnnihilatesSigma X q) (e : Q ≅ Q')
    (hφ : AnnihilatesSigma X (q ≫ e.hom))
    (hpost : IsIso (cotangentMap p (q ≫ e.hom) hφ)) :
    IsIso (cotangentMap p q hq) := by
  letI : IsIso (dualMap e.hom) := by
    change IsIso ((dualFunctor X).map e.hom.op)
    infer_instance
  letI : IsIso (symmetricMap (dualMap e.hom) 2) :=
    (Scheme.Modules.isSymmetricAlgebra_symmetricAlgebra X (dualSheaf Q')).isIso_pieceMap
      (Scheme.Modules.isSymmetricAlgebra_symmetricAlgebra X (dualSheaf Q))
        (dualMap e.hom) inferInstance 2
  letI : IsIso (symmetricMap (dualMap e.hom) 2 ≫ cotangentMap p q hq) :=
    (cotangentMap_target_comp p q hq e.hom hφ).symm ▸ hpost
  exact (isIso_comp_left_iff (symmetricMap (dualMap e.hom) 2) (cotangentMap p q hq)).mp
    inferInstance

/-- Equality of the actual base morphisms transports the actual
cotangent-map isomorphism predicate without adding any comparison data. -/
theorem cotangentMap_isIso_congr (p p' : X ⟶ S) (h : p=p')
    (q : freeOn X 6 ⟶ Q) (hq : AnnihilatesSigma X q) :
    IsIso (cotangentMap p q hq) ↔ IsIso (cotangentMap p' q hq) := by
  cases h
  rfl

end M9Native.LagrangianCotangentQuotientFrame
