module

public import M9StacksIntegration.CurveDivisorSections
public import M9StacksIntegration.MukaiPencilDegreeBounds
public import M9StacksIntegration.LinearSeriesFromCohomology
public import StacksFrontier.AlgebraicGeometry.Curves.LinearSeriesMorphism
public import StacksFrontier.AlgebraicGeometry.ProductFamilyTwist.Basic
public import StacksFrontier.AlgebraicGeometry.Variety.Smooth.Regular

/-!
# Minimal degree forces the original linear series to generate

The native invertible span lifts the original basis sections. Naturality
of the actual degree-zero cohomology/sections comparison proves that the
lifted cohomology classes are independent. Minimal degree then makes the
nonzero map from the span an isomorphism, so its generating sections give
generation by the original series. No generation assumption is supplied.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open Stacks.LinearSeriesMorphism Stacks.ProjectiveFromSections

universe u

namespace M9Native.MinimalDegreeSeriesGeneration

variable {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f]
    (hdim : topologicalKrullDim X ≤ 1)

/-- Original basis sections lifted through a line-bundle map give at
least the same number of actual cohomology classes upstairs. This uses
the older bare comparison used by `seriesSections`, with its actual
naturality; it does not identify it with another H⁰ comparison. -/
theorem finrank_H0_lift_ge {d r : ℕ} (E : LinearSeries k f hdim d r)
    (b : Module.Basis (Fin (r + 1)) k E.V) (L' : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property L']
    (j : L' ⟶ E.L) (s' : Fin (r + 1) → Γ(L', ⊤))
    (hpin : ∀ i, j.app ⊤ (s' i) = seriesSections E b i) :
    r + 1 ≤ Module.finrank k (cohomologyOverField k f L' 0) := by
  let := CurveDivisorSections.invertible_cohomology_zero_finite f L'
  let t : Fin (r + 1) → cohomologyOverField k f L' 0 :=
    fun i => (cohomologyOverFieldZeroEquivSections k f L').symm (s' i)
  let q := (cohomologyOverFieldMap k f j 0).hom
  have hqt (i : Fin (r + 1)) : q (t i) = (b i : cohomologyOverField k f E.L 0) := by
    apply (cohomologyOverFieldZeroEquivSections k f E.L).injective
    rw [cohomologyOverFieldZeroEquivSections_cohomologyOverFieldMap]
    change j.app ⊤ ((cohomologyOverFieldZeroEquivSections k f L')
      ((cohomologyOverFieldZeroEquivSections k f L').symm (s' i))) = _
    rw [Equiv.apply_symm_apply]
    exact hpin i
  have hcomp : q ∘ t = fun i => (b i : cohomologyOverField k f E.L 0) := funext hqt
  have ht : LinearIndependent k t := LinearIndependent.of_comp q (by
    rw [hcomp]
    exact b.linearIndependent.map' E.V.subtype (by simp))
  simpa only [Fintype.card_fin] using ht.fintype_card_le_finrank

/-- A map carrying lifts to the original basis is actually nonzero. -/
theorem lift_map_ne_zero {d r : ℕ} (E : LinearSeries k f hdim d r)
    (b : Module.Basis (Fin (r + 1)) k E.V) {L' : X.Modules}
    (j : L' ⟶ E.L) (s' : Fin (r + 1) → Γ(L', ⊤))
    (hpin : ∀ i, j.app ⊤ (s' i) = seriesSections E b i) : j ≠ 0 := by
  intro hj
  apply seriesSections_ne_zero E b 0
  calc
    seriesSections E b 0 = j.app ⊤ (s' 0) := (hpin 0).symm
    _ = 0 := by rw [hj, Scheme.Modules.Hom.zero_app]; rfl

/-- A linear series whose degree is minimal among line bundles with
enough sections is generated by its original chosen basis. The native
invertible span, its cohomology classes, and the equality-case
isomorphism of line bundles are all constructed in the proof. -/
theorem generatesStalks_of_minimal_degree [IsCurve k f]
    (hregular : IsRegular X) {d r : ℕ} (E : LinearSeries k f hdim d r)
    (b : Module.Basis (Fin (r + 1)) k E.V)
    (hmin : ∀ (M : X.Modules)
      (hM : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property M),
      r + 1 ≤ Module.finrank k (cohomologyOverField k f M 0) →
        (d : ℤ) ≤ @invertibleCurveDegree k _ X f _ hdim M hM) :
    GeneratesStalks (seriesSections E b) := by
  let : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property E.L := E.isInvertible
  obtain ⟨L', hL', j, s', hgen, hpin⟩ :=
    hasGeneratingInvertibleLift_seriesSections hregular E b
  let := hL'
  have h0 := finrank_H0_lift_ge f hdim E b L' j s' hpin
  have hj := lift_map_ne_zero f hdim E b j s' hpin
  have hle := invertibleCurveDegree_le_of_hom_ne_zero k f hdim L' E.L j hj
  have hge : invertibleCurveDegree k f hdim E.L ≤ invertibleCurveDegree k f hdim L' := by
    rw [E.degree_eq]
    exact hmin L' hL' h0
  let : IsIso j := isIso_of_invertibleCurveDegree_eq_of_hom_ne_zero k f hdim
    L' E.L j hj (le_antisymm hle hge)
  have hgen' := Stacks.ProductFamilyTwist.generatesStalks_congr (asIso j) hgen
  have hp : (fun i => j.app ⊤ (s' i)) = seriesSections E b := funext hpin
  change GeneratesStalks (fun i => j.app ⊤ (s' i)) at hgen'
  rw [hp] at hgen'
  exact hgen'

/-- Excluding every smaller native linear series gives the actual
minimal-degree inequality for each line bundle with enough sections. -/
theorem degree_lower_bound_of_no_smaller_series [IsCurve k f]
    (N r : ℕ)
    (hno : ∀ e : ℕ, e < N → ¬ Nonempty (LinearSeries k f hdim e r))
    (M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property M]
    (h0 : r + 1 ≤ Module.finrank k (cohomologyOverField k f M 0)) :
    (N : ℤ) ≤ invertibleCurveDegree k f hdim M := by
  obtain ⟨v, hv⟩ := exists_linearIndependent_of_le_finrank h0
  let s : M.sections := (Stacks.NonvanishingSpelling.sectionsEquiv X M).symm
    (cohomologyOverFieldZeroEquivSections k f M (v 0))
  have hs : s.eval (op ⊤) ≠ 0 := by
    have heval : s.eval (op ⊤) = cohomologyOverFieldZeroEquivSections k f M (v 0) :=
      (Stacks.NonvanishingSpelling.sectionsEquiv X M).apply_symm_apply _
    rw [heval]
    intro hz
    apply hv.ne_zero 0
    apply (cohomologyOverFieldZeroEquivSections k f M).injective
    exact hz.trans (cohomologyOverFieldZeroEquivSections_zero k f M).symm
  have hnn := invertibleCurveDegree_nonneg_of_eval_top_ne_zero k f hdim M s hs
  let e := (invertibleCurveDegree k f hdim M).toNat
  have heq : invertibleCurveDegree k f hdim M = (e : ℤ) :=
    (Int.toNat_of_nonneg hnn).symm
  by_contra h
  have he : e < N := by omega
  exact hno e he (LinearSeriesFromCohomology.nonempty_linearSeries_of_finrank_H0
    k f hdim M e r heq h0)

/-- A degree-six pencil on a smooth nonpentagonal curve has no base
points: its original basis generates its original invertible sheaf. -/
theorem degree_six_pencil_generates [IsAlgClosed k] [IsCurve k f] [Smooth f]
    (hno5 : ¬ Nonempty (LinearSeries k f hdim 5 1))
    (E : LinearSeries k f hdim 6 1) (b : Module.Basis (Fin 2) k E.V) :
    GeneratesStalks (seriesSections E b) := by
  apply generatesStalks_of_minimal_degree f hdim (isRegular_of_smooth_over_field f) E b
  intro M hM h0
  let := hM
  exact MukaiPencilDegreeBounds.six_le_degree_of_two_sections f hdim hno5 M h0

/-- A degree-eight net on a smooth curve with no net of degree at most
seven is generated by its original basis, without a generation premise. -/
theorem degree_eight_net_generates [IsCurve k f] [Smooth f]
    (hno7 : ∀ e : ℕ, e ≤ 7 → ¬ Nonempty (LinearSeries k f hdim e 2))
    (E : LinearSeries k f hdim 8 2) (b : Module.Basis (Fin 3) k E.V) :
    GeneratesStalks (seriesSections E b) := by
  apply generatesStalks_of_minimal_degree f hdim (isRegular_of_smooth_over_field f) E b
  intro M hM h0
  let := hM
  exact degree_lower_bound_of_no_smaller_series f hdim 8 2
    (fun e he => hno7 e (by omega)) M h0

end M9Native.MinimalDegreeSeriesGeneration
