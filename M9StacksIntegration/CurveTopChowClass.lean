module

public import StacksFrontier.AlgebraicGeometry.Chow.DominantPrimeCycle
public import StacksFrontier.AlgebraicGeometry.Chow.RelativeDimension

/-!
# The actual top Chow group of an integral scheme is generated by its fundamental class

The native relative dimension function is strictly anti under proper
specialization. A top-dimensional cycle is therefore supported only at
the actual generic point. The native prime-cycle calculation gives its
coefficient on the actual fundamental cycle, and passing to the actual
Chow quotient preserves that equality.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace M9Native.CurveTopChowClass

open Stacks.Chow

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (f : X ⟶ C.S)
  [LocallyOfFiniteType f] [IsIntegral X]

theorem eq_genericPoint_of_top_relativeDimension (n : ℤ)
    (hdim : schemeDeltaDimension C f = (n : EInt)) (x : X)
    (hx : relativeDimension C.dimensionFunction f x = n) : x = genericPoint X := by
  obtain ⟨d, hd⟩ :=
    relativeDimension_isDimensionFunction C.isUniversallyCatenary C.dimensionFunction f
  have hη : d (genericPoint X) = n := by
    rw [hd]
    exact WithBotTop.coe_injective ((schemeDeltaDimension_eq_genericPoint C f).symm.trans hdim)
  have hxx : d x = n := (hd x).trans hx
  by_contra hne
  have hlt := d.strictAnti_specializes (genericPoint_specializes x) (Ne.symm hne)
  rw [hη, hxx] at hlt
  exact lt_irrefl _ hlt

theorem topCycle_eq_zsmul_identity (n : ℤ)
    (hdim : schemeDeltaDimension C f = (n : EInt)) (a : CycleGroup C f n) :
    a = a.1 (genericPoint X) • cycleAssociatedToClosedSubscheme C f (𝟙 X) n := by
  classical
  have hη : relativeDimension C.dimensionFunction f (genericPoint X) = n :=
    WithBotTop.coe_injective ((schemeDeltaDimension_eq_genericPoint C f).symm.trans hdim)
  have hfund : (cycleAssociatedToClosedSubscheme C f (𝟙 X) n).1 =
      Function.locallyFinsuppWithin.single (genericPoint X) (1 : ℤ) := by
    exact cycleAssociatedToClosedSubscheme_eq_single C f (𝟙 X) n hη
  apply Subtype.ext
  apply Function.locallyFinsuppWithin.ext
  intro x
  change a.1 x = a.1 (genericPoint X) •
    (cycleAssociatedToClosedSubscheme C f (𝟙 X) n).1 x
  rw [hfund]
  by_cases hx : x = genericPoint X
  · subst x
    simp
  · have hz : a.1 x = 0 := by
      by_contra hne
      exact hx (eq_genericPoint_of_top_relativeDimension C f n hdim x
        ((mem_cyclesOfDimension_iff_forall_point C f n a.1).mp a.2 x hne))
    simp [Function.locallyFinsuppWithin.single_apply, hx, hz]

/-- The genuine quotient class of the actual identity fundamental cycle. -/
abbrev identityChowClass (n : ℤ) : chowGroup C f n :=
  QuotientAddGroup.mk' (rationalEquivalences C f n)
    (cycleAssociatedToClosedSubscheme C f (𝟙 X) n)

theorem exists_zsmul_identityChowClass (n : ℤ)
    (hdim : schemeDeltaDimension C f = (n : EInt)) (a : chowGroup C f n) :
    ∃ m : ℤ, a = m • identityChowClass C f n := by
  obtain ⟨b, rfl⟩ := QuotientAddGroup.mk'_surjective (rationalEquivalences C f n) a
  refine ⟨b.1 (genericPoint X), ?_⟩
  change (QuotientAddGroup.mk' (rationalEquivalences C f n)) b =
    b.1 (genericPoint X) • (QuotientAddGroup.mk' (rationalEquivalences C f n))
      (cycleAssociatedToClosedSubscheme C f (𝟙 X) n)
  calc
    _ = (QuotientAddGroup.mk' (rationalEquivalences C f n))
        (b.1 (genericPoint X) • cycleAssociatedToClosedSubscheme C f (𝟙 X) n) :=
      congrArg (QuotientAddGroup.mk' (rationalEquivalences C f n))
        (topCycle_eq_zsmul_identity C f n hdim b)
    _ = _ := map_zsmul _ _ _

theorem addHom_cross_mul (n : ℤ) (hdim : schemeDeltaDimension C f = (n : EInt))
    (φ ψ : chowGroup C f n →+ ℤ) (a : chowGroup C f n) :
    φ a * ψ (identityChowClass C f n) = φ (identityChowClass C f n) * ψ a := by
  obtain ⟨m, rfl⟩ := exists_zsmul_identityChowClass C f n hdim a
  rw [map_zsmul, map_zsmul]
  simp only [smul_eq_mul]
  ring

theorem addHom_zero_of_identity_zero (n : ℤ) (hdim : schemeDeltaDimension C f = (n : EInt))
    {M : Type*} [AddCommGroup M] (φ : chowGroup C f n →+ M)
    (hφ : φ (identityChowClass C f n) = 0) (a : chowGroup C f n) : φ a = 0 := by
  obtain ⟨m, rfl⟩ := exists_zsmul_identityChowClass C f n hdim a
  rw [map_zsmul, hφ, smul_zero]

end M9Native.CurveTopChowClass
