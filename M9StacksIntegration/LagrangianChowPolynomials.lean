module

public import M9StacksIntegration.GradedLineCapSubring
public import Mathlib.Algebra.MvPolynomial.Eval

/-!
# Integer polynomials in three actual first-Chern line caps

Evaluation takes place in the proved commutative subring generated by
actual invertible-line caps, then includes into the original generally
noncommutative graded cap ring. Thus it refers to the original Chow
operators and supplies no artificial commutativity or root realization.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
set_option maxRecDepth 4096

open AlgebraicGeometry CategoryTheory Stacks.Chow

universe u

namespace M9Native.LagrangianChowPolynomials

open GradedLineCapSubring ChowCapWords GradedCapVirtualSchur MvPolynomial

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (q : X ⟶ C.S) [LocallyOfFiniteType q]
  (L : Fin 3 → InvertibleLine X)

/-- The original three line families, through their actual generated subring. -/
def evaluate : MvPolynomial (Fin 3) ℤ →+* GradedCapFamily (chowGroup C q) :=
  (inclusion C q).comp
    (MvPolynomial.eval₂Hom (Int.castRingHom (lineSubring C q)) (fun i => lineRoot C q (L i)))

@[simp]
theorem evaluate_X (i : Fin 3) :
    evaluate C q L (MvPolynomial.X i) = lineFamily C q (L i) := by
  change (inclusion C q)
    ((MvPolynomial.eval₂Hom (Int.castRingHom (lineSubring C q))
      (fun i => lineRoot C q (L i))) (MvPolynomial.X i)) = _
  rw [MvPolynomial.eval₂Hom_X']
  rfl

@[simp]
theorem evaluate_C (a : ℤ) :
    evaluate C q L (MvPolynomial.C a) = (a : GradedCapFamily (chowGroup C q)) := by
  change (inclusion C q)
    ((MvPolynomial.eval₂Hom (Int.castRingHom (lineSubring C q))
      (fun i => lineRoot C q (L i))) (MvPolynomial.C a)) = _
  rw [MvPolynomial.eval₂Hom_C]
  exact map_intCast (inclusion C q) a

/-- The ordered monomial is homogeneous of its actual cap degree. -/
theorem evaluate_word_homogeneous (a b c : ℕ) :
    (evaluate C q L (MvPolynomial.X 0^a * MvPolynomial.X 1^b * MvPolynomial.X 2^c)).IsHomogeneous (a+b+c) := by
  simp only [map_mul,map_pow,evaluate_X]
  exact (((lineFamily_homogeneous C q (L 0)).pow a).mul
    ((lineFamily_homogeneous C q (L 1)).pow b)).mul
      ((lineFamily_homogeneous C q (L 2)).pow c)

/-- Taking a fixed actual cap component on a fixed actual Chow input is additive. -/
def applyComponent (k : ℤ) (i : ℕ) (α : chowGroup C q k) :
    MvPolynomial (Fin 3) ℤ →+ chowGroup C q (k-(i:ℤ)) where
  toFun p := evaluate C q L p k i α
  map_zero' :=
    congrArg (fun A : GradedCapFamily (chowGroup C q) => A k i α) (evaluate C q L).map_zero
  map_add' p r :=
    congrArg (fun A : GradedCapFamily (chowGroup C q) => A k i α)
      ((evaluate C q L).map_add p r)

end M9Native.LagrangianChowPolynomials
