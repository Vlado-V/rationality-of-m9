module

public import M9StacksIntegration.PolynomialGraphKernel
public import M9StacksIntegration.LagrangianMatrixChart
public import Mathlib.LinearAlgebra.Matrix.Adjugate

/-! The actual normalized `(q,b,p)` polynomial graph, with `q = adj(p)`
and `b = det(p)`.  Its ideal is generated by the dehomogenized quadratic
matrix equations `adj(p) - q` and `p*q - b*I` over every coefficient ring. -/

@[expose] public noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 1800000
set_option maxRecDepth 4096

open MvPolynomial Matrix
open scoped BigOperators

universe u

namespace M9Native.LagrangianQuadricChartAlgebra

open LagrangianMatrixChart

abbrev SymIndex := ULift.{u} SymmetricEntry
abbrev ExtraIndex := SymIndex.{u} ⊕ Unit
abbrev LocalIndex := ExtraIndex.{u} ⊕ SymIndex.{u}
abbrev QuadricIndex := (Fin 3 × Fin 3) ⊕ (Fin 3 × Fin 3)

variable (R : Type u) [CommRing R]

abbrev AffineRing := MvPolynomial SymIndex.{u} R
abbrev LocalRing := MvPolynomial LocalIndex.{u} R

def genericMatrix : Matrix (Fin 3) (Fin 3) (AffineRing R) :=
  fun i j => X (ULift.up (symmetricIndex (i,j)))

theorem genericMatrix_symmetric : (genericMatrix R).transpose = genericMatrix R := by
  funext i j
  change (X (ULift.up (symmetricIndex (j,i))) : AffineRing R) = X (ULift.up (symmetricIndex (i,j)))
  rw [symmetricIndex_swap]

def pMatrix : Matrix (Fin 3) (Fin 3) (LocalRing R) :=
  (genericMatrix R).map (MvPolynomial.rename Sum.inr : AffineRing R →ₐ[R] LocalRing R)

def qMatrix : Matrix (Fin 3) (Fin 3) (LocalRing R) :=
  fun i j => X (Sum.inl (Sum.inl (ULift.up (symmetricIndex (i,j)))))

def bVariable : LocalRing R := X (Sum.inl (Sum.inr ()))

def extraPolynomials : ExtraIndex.{u} → AffineRing R :=
  Sum.elim (fun ij => (genericMatrix R).adjugate ij.down.val.1 ij.down.val.2)
    (fun _ => (genericMatrix R).det)

def graphMap : LocalRing R →ₐ[R] AffineRing R :=
  PolynomialGraphKernel.graphEvaluation R ExtraIndex.{u} SymIndex.{u} (extraPolynomials R)

def graphIdeal : Ideal (LocalRing R) :=
  PolynomialGraphKernel.graphIdeal R ExtraIndex.{u} SymIndex.{u} (extraPolynomials R)

def adjRelation (i j : Fin 3) : LocalRing R := (pMatrix R).adjugate i j - qMatrix R i j
def productRelation (i j : Fin 3) : LocalRing R :=
  (pMatrix R * qMatrix R) i j - bVariable R * (1 : Matrix (Fin 3) (Fin 3) (LocalRing R)) i j

def quadricRelation : QuadricIndex → LocalRing R :=
  Sum.elim (fun ij => adjRelation R ij.1 ij.2) (fun ij => productRelation R ij.1 ij.2)

def quadricIdeal : Ideal (LocalRing R) := Ideal.span (Set.range (quadricRelation R))

theorem graphMap_pMatrix : (pMatrix R).map (graphMap R) = genericMatrix R := by
  funext i j
  exact AlgHom.congr_fun
    (PolynomialGraphKernel.graphEvaluation_comp_rename R ExtraIndex.{u} SymIndex.{u}
      (extraPolynomials R)) (genericMatrix R i j)

theorem graphMap_qMatrix : (qMatrix R).map (graphMap R) = (genericMatrix R).adjugate := by
  funext i j
  change graphMap R (X (Sum.inl (Sum.inl (ULift.up (symmetricIndex (i,j)))))) = _
  rw [graphMap, PolynomialGraphKernel.graphEvaluation, MvPolynomial.aeval_X]
  change (genericMatrix R).adjugate (symmetricIndex (i,j)).val.1
    (symmetricIndex (i,j)).val.2 = (genericMatrix R).adjugate i j
  by_cases hij : i ≤ j
  · simp only [symmetricIndex, dite_eq_left hij]
  · simp only [symmetricIndex, dite_eq_right hij]
    have hs : (genericMatrix R).adjugate.transpose = (genericMatrix R).adjugate := by
      rw [Matrix.adjugate_transpose, genericMatrix_symmetric]
    exact congrFun (congrFun hs i) j

theorem graphMap_bVariable : graphMap R (bVariable R) = (genericMatrix R).det := by
  simp [bVariable, graphMap, PolynomialGraphKernel.graphEvaluation, extraPolynomials]

theorem graphMap_adjRelation (i j : Fin 3) : graphMap R (adjRelation R i j) = 0 := by
  have hp₀ := (graphMap R).map_adjugate (pMatrix R)
  simp only [AlgHom.mapMatrix_apply] at hp₀
  rw [graphMap_pMatrix] at hp₀
  have hp := congrArg (fun M : Matrix (Fin 3) (Fin 3) (AffineRing R) => M i j) hp₀
  have hq := congrArg (fun M : Matrix (Fin 3) (Fin 3) (AffineRing R) => M i j)
    (graphMap_qMatrix R)
  change graphMap R ((pMatrix R).adjugate i j) = (genericMatrix R).adjugate i j at hp
  change graphMap R (qMatrix R i j) = (genericMatrix R).adjugate i j at hq
  rw [adjRelation, map_sub, hp, hq, sub_self]

theorem graphMap_productRelation (i j : Fin 3) : graphMap R (productRelation R i j) = 0 := by
  have hmul : graphMap R ((pMatrix R * qMatrix R) i j) =
      (genericMatrix R).det * (1 : Matrix (Fin 3) (Fin 3) (AffineRing R)) i j := by
    have hm : (pMatrix R * qMatrix R).map (graphMap R) =
        genericMatrix R * (genericMatrix R).adjugate := by
      rw [Matrix.map_mul, graphMap_pMatrix, graphMap_qMatrix]
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) (AffineRing R) => M i j)
      (hm.trans (Matrix.mul_adjugate (genericMatrix R)))
    simpa only [Matrix.map_apply, Matrix.smul_apply, smul_eq_mul] using h
  have hone : graphMap R ((1 : Matrix (Fin 3) (Fin 3) (LocalRing R)) i j) =
      (1 : Matrix (Fin 3) (Fin 3) (AffineRing R)) i j := by
    simp only [Matrix.one_apply]
    split_ifs <;> simp only [map_one, map_zero]
  rw [productRelation, map_sub, map_mul, graphMap_bVariable, hone, hmul, sub_self]

theorem quadricIdeal_le_ker : quadricIdeal R ≤ RingHom.ker (graphMap R).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨ij, rfl⟩
  cases ij with
  | inl ij => exact graphMap_adjRelation R ij.1 ij.2
  | inr ij => exact graphMap_productRelation R ij.1 ij.2

theorem rename_genericMatrix :
    (genericMatrix R).map (MvPolynomial.rename Sum.inr : AffineRing R →ₐ[R] LocalRing R) = pMatrix R := rfl

theorem graphRelation_q (ij : SymIndex.{u}) :
    PolynomialGraphKernel.graphRelation R ExtraIndex.{u} SymIndex.{u}
      (extraPolynomials R) (Sum.inl ij) = -adjRelation R ij.down.val.1 ij.down.val.2 := by
  have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) (LocalRing R) =>
    M ij.down.val.1 ij.down.val.2)
      ((MvPolynomial.rename Sum.inr : AffineRing R →ₐ[R] LocalRing R).map_adjugate (genericMatrix R))
  change MvPolynomial.rename Sum.inr ((genericMatrix R).adjugate ij.down.val.1 ij.down.val.2) =
    (pMatrix R).adjugate ij.down.val.1 ij.down.val.2 at h
  rw [PolynomialGraphKernel.graphRelation]
  change X (Sum.inl (Sum.inl ij)) -
    MvPolynomial.rename Sum.inr ((genericMatrix R).adjugate ij.down.val.1 ij.down.val.2) = _
  rw [h, adjRelation, neg_sub]
  congr 1
  have hi : symmetricIndex (ij.down.val.1, ij.down.val.2) = ij.down := symmetricIndex_of_le ij.down
  simp only [qMatrix, hi, ULift.up_down]

theorem graphRelation_b :
    PolynomialGraphKernel.graphRelation R ExtraIndex.{u} SymIndex.{u}
      (extraPolynomials R) (Sum.inr ()) = bVariable R - (pMatrix R).det := by
  rw [PolynomialGraphKernel.graphRelation]
  change bVariable R - MvPolynomial.rename Sum.inr (genericMatrix R).det = _
  rw [AlgHom.map_det]
  rfl

theorem b_sub_det_mem_quadricIdeal : bVariable R - (pMatrix R).det ∈ quadricIdeal R := by
  have hdet := congrArg (fun M : Matrix (Fin 3) (Fin 3) (LocalRing R) => M (0 : Fin 3) 0)
    (Matrix.mul_adjugate (pMatrix R))
  have hid : bVariable R - (pMatrix R).det =
      -productRelation R 0 0 - ∑ k : Fin 3, pMatrix R 0 k * adjRelation R k 0 := by
    have hd : ∑ k : Fin 3, pMatrix R 0 k * (pMatrix R).adjugate k 0 = (pMatrix R).det := by
      simpa only [Matrix.mul_apply, Matrix.smul_apply, Matrix.one_apply, ite_true,
        smul_eq_mul, mul_one] using hdet
    rw [← hd]
    simp only [productRelation, adjRelation, Matrix.mul_apply, Matrix.one_apply, ite_true,
      mul_one, mul_sub, Finset.sum_sub_distrib]
    ring
  rw [hid]
  apply Ideal.sub_mem
  · exact Submodule.neg_mem _ (Ideal.subset_span ⟨Sum.inr (0,0), rfl⟩)
  · exact Ideal.sum_mem _ (fun k _ => Ideal.mul_mem_left _ _
      (Ideal.subset_span ⟨Sum.inl (k,0), rfl⟩))

theorem graphIdeal_le_quadricIdeal : graphIdeal R ≤ quadricIdeal R := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  cases i with
  | inl ij =>
    rw [graphRelation_q]
    exact Submodule.neg_mem _ (Ideal.subset_span ⟨Sum.inl (ij.down.val.1, ij.down.val.2), rfl⟩)
  | inr i =>
    cases i
    rw [graphRelation_b]
    exact b_sub_det_mem_quadricIdeal R

/-- The normalized original matrix graph is cut out scheme-theoretically
by the dehomogenized quadratic equations, over every commutative ring. -/
theorem ker_graphMap_eq_quadricIdeal : RingHom.ker (graphMap R).toRingHom = quadricIdeal R := by
  apply le_antisymm _ (quadricIdeal_le_ker R)
  rw [show RingHom.ker (graphMap R).toRingHom = graphIdeal R from
    PolynomialGraphKernel.ker_graphEvaluation R ExtraIndex.{u} SymIndex.{u} (extraPolynomials R)]
  exact graphIdeal_le_quadricIdeal R

end M9Native.LagrangianQuadricChartAlgebra
