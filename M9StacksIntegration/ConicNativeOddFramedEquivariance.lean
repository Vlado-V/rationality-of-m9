module

public import M9StacksIntegration.ConicNativeSLFramedEquivariance

/-! Literal equivariance of the actual native odd stabilizer generator,
through the actual ordinary graph, native center quotient and proved J. -/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000
set_option maxRecDepth 10000

open Matrix
open scoped Classical

namespace M9Native.ConicNativeOddFramedEquivariance

open M9.GraphBundleDescent ConicPairMovingFrames ConicOrdinaryGraphEvaluation
open ConicOrdinaryGraphAction ConicFramedTwistEmbedding ConicFramedTwistAction

abbrev M := ConicFramedGraphField.M

theorem ordinaryOdd_firstFrame :
    Matrix.GeneralLinearGroup.map ordinaryOdd.toRingHom (frame 0) = frame 1 := by
  apply Units.ext
  apply Matrix.ext
  intro i j
  change ordinaryOdd (algebraMap B M ((frameUnit 0).val i j)) =
    algebraMap B M ((frameUnit 1).val i j)
  rw [ordinaryOdd_constant]
  have h := congrArg (fun U : M9.MovingDeterminantFrames.GL3 B => U.val i j) swap_frameUnit_zero
  change PairProjectiveEquivariance.projectivePairSwap ((frameUnit 0).val i j) =
    (frameUnit 1).val i j at h
  exact congrArg (algebraMap B M) h

theorem ordinaryOdd_secondFrame :
    Matrix.GeneralLinearGroup.map ordinaryOdd.toRingHom (frame 1) = frame 0 := by
  apply Units.ext
  apply Matrix.ext
  intro i j
  change ordinaryOdd (algebraMap B M ((frameUnit 1).val i j)) =
    algebraMap B M ((frameUnit 0).val i j)
  rw [ordinaryOdd_constant]
  have h := congrArg (fun U : M9.MovingDeterminantFrames.GL3 B => U.val i j) swap_frameUnit_one
  change PairProjectiveEquivariance.projectivePairSwap ((frameUnit 1).val i j) =
    (frameUnit 0).val i j at h
  exact congrArg (algebraMap B M) h

/-- Genuine native odd action on the original ordinary graph pullback. -/
theorem ordinaryOdd_equivariance (f : FF) :
    ordinaryEmbedding (ordinaryFieldRepresentation
      (SemidirectProduct.inr M9.CentralSignQuotient.epsilon) f) =
      ordinaryOdd (ordinaryEmbedding f) := by
  have h := odd_field_of_formulas ordinaryOdd ordinaryOdd_firstFrame ordinaryOdd_secondFrame
    ordinaryOdd_rawUnit ((GraphGrassmannianChart.graphFunctionFieldEquiv ℂ).symm f)
  simpa only [ordinaryFieldRepresentation_apply, AlgEquiv.apply_symm_apply] using h

/-- Actual native odd equivariance in the determinant-compensated graph
coordinates. The inverse is the genuine original raw-matrix inverse. -/
theorem embedding_odd (f : FF) :
    ConicFramedGraphField.embedding
      (ConicCompatibleTwistedAction.twistedFieldRepresentation
        (SemidirectProduct.inr M9.CentralSignQuotient.epsilon) f) =
      ordinaryOdd (ConicFramedGraphField.embedding f) :=
  twisted_equivariance_of_ordinary (SemidirectProduct.inr M9.CentralSignQuotient.epsilon)
    ordinaryOdd ordinaryOdd ordinaryOdd_equivariance ordinaryOdd_J f

/-- The actual semidirect stabilizer is generated by its original SL3
and the actual odd generator. The center is retained in SL3. -/
theorem mem_twistedHFixedField_iff_generators (f : FF) :
    f ∈ ConicCompatibleTwistedAction.twistedHFixedField ↔
      (∀ g : ProjectivePairSLFixedField.SL3,
        ConicCompatibleTwistedAction.twistedFieldRepresentation (SemidirectProduct.inl g) f = f) ∧
      ConicCompatibleTwistedAction.twistedFieldRepresentation
        (SemidirectProduct.inr M9.CentralSignQuotient.epsilon) f = f := by
  constructor
  · intro hf
    have h := (ConicCompatibleTwistedAction.mem_twistedHFixedField_iff f).mp hf
    exact ⟨fun g => h (SemidirectProduct.inl g), h _⟩
  · rintro ⟨hc, ho⟩
    apply (ConicCompatibleTwistedAction.mem_twistedHFixedField_iff f).mpr
    intro w
    rcases M9.CentralSignQuotient.c2_cases w.right with hr | hr
    · have hw : w = SemidirectProduct.inl w.left := by
        calc
          w = SemidirectProduct.inl w.left * SemidirectProduct.inr w.right :=
            (SemidirectProduct.inl_left_mul_inr_right w).symm
          _ = _ := by rw [hr, map_one, mul_one]
      rw [hw]
      exact hc _
    · have hw : w = SemidirectProduct.inl w.left *
          SemidirectProduct.inr M9.CentralSignQuotient.epsilon := by
        calc
          w = SemidirectProduct.inl w.left * SemidirectProduct.inr w.right :=
            (SemidirectProduct.inl_left_mul_inr_right w).symm
          _ = _ := by rw [hr]
      rw [hw, map_mul, AlgEquiv.mul_apply, ho, hc]

/-- Exact original native stabilizer fixedness in the proved framed
inclusion, with every action comparison discharged. -/
theorem mem_twistedHFixedField_iff_framed (f : FF) :
    f ∈ ConicCompatibleTwistedAction.twistedHFixedField ↔
      (∀ g : ProjectivePairSLFixedField.SL3,
        ConicFramedSLQuotient.coefficientTranslate g (ConicFramedGraphField.embedding f) =
          ConicFramedGraphField.embedding f) ∧
      ordinaryOdd (ConicFramedGraphField.embedding f) = ConicFramedGraphField.embedding f := by
  rw [mem_twistedHFixedField_iff_generators]
  constructor
  · rintro ⟨hc, ho⟩
    constructor
    · intro g
      rw [← ConicNativeSLFramedEquivariance.embedding_connected_actual, hc]
    · rw [← embedding_odd, ho]
  · rintro ⟨hc, ho⟩
    constructor
    · intro g
      apply ConicFramedGraphField.embedding.injective
      change ConicFramedGraphField.embedding
        (ConicCompatibleTwistedAction.twistedFieldRepresentation (SemidirectProduct.inl g) f) = _
      rw [ConicNativeSLFramedEquivariance.embedding_connected_actual]
      exact hc g
    · apply ConicFramedGraphField.embedding.injective
      change ConicFramedGraphField.embedding
        (ConicCompatibleTwistedAction.twistedFieldRepresentation
          (SemidirectProduct.inr M9.CentralSignQuotient.epsilon) f) = _
      rw [embedding_odd]
      exact ho

end M9Native.ConicNativeOddFramedEquivariance
