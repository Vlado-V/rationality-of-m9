module

public import M9StacksIntegration.GradedCapSegreComparison
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.PowerSumShortExact

/-!
# Finite actual virtual-Chern components commute

The generators are the genuine homogeneous Chern cap components of the
two actual finite locally free modules. Native cap commutation, with
its actual zero coefficients above rank, makes only their generated
subring commutative. The finite inverse recurrence and genuine finite
convolution put each actual inverse/virtual component in that subring.

No whole infinite inverse family is asserted to belong to this
uncompleted subring. Component commutation is proved from those actual
finite memberships, without a global operational commutativity premise.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false

universe u
namespace M9Native.ChowVirtualComponentCommutation
open AlgebraicGeometry CategoryTheory Stacks.Chow Stacks.Chow.GenuineChern
open M9Native.GradedCapVirtualSchur M9Native.GradedCapSegreComparison

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (q : X ⟶ C.S)
  [LocallyOfFiniteType q]
variable (F E : X.Modules) (rF rE : ℕ)
  [SheafOfModules.IsFiniteLocallyFreeOfRank F rF]
  [SheafOfModules.IsFiniteLocallyFreeOfRank E rE]

/-- The actual subring generated by the homogeneous genuine Chern
components of the original two modules. -/
def coefficientSubring : Subring (GradedCapFamily (chowGroup C q)) :=
  Subring.closure
    (Set.range (fun i : ℕ => homComponent i (chernFamily C q F rF)) ∪
      Set.range (fun i : ℕ => homComponent i (chernFamily C q E rE)))

theorem leftComponent_mem (i : ℕ) :
    homComponent i (chernFamily C q F rF) ∈ coefficientSubring C q F E rF rE :=
  Subring.subset_closure (Or.inl ⟨i, rfl⟩)

theorem rightComponent_mem (i : ℕ) :
    homComponent i (chernFamily C q E rE) ∈ coefficientSubring C q F E rF rE :=
  Subring.subset_closure (Or.inr ⟨i, rfl⟩)

/-- Only the actual coefficient-generated subring is commutative;
the pairwise generator theorem is native geometric cap commutation. -/
instance coefficientSubring_isMulCommutative :
    IsMulCommutative (coefficientSubring C q F E rF rE) :=
  Subring.isMulCommutative_closure (by
    rintro a (⟨i, rfl⟩ | ⟨i, rfl⟩) b (⟨j, rfl⟩ | ⟨j, rfl⟩) _
    · exact GenuineChern.commute_homComponent_chernFamily C q F rF F rF i j
    · exact GenuineChern.commute_homComponent_chernFamily C q F rF E rE i j
    · exact GenuineChern.commute_homComponent_chernFamily C q E rE F rF i j
    · exact GenuineChern.commute_homComponent_chernFamily C q E rE E rE i j)

open scoped IsMulCommutative in
instance coefficientSubring_commRing : CommRing (coefficientSubring C q F E rF rE) :=
  inferInstance

/-- Each finite homogeneous component of the actual inverse is in the
actual Chern-component subring, by the finite native inverse recurrence. -/
theorem inverseComponent_mem (n : ℕ) :
    homComponent n (inverseFamily C q E rE) ∈ coefficientSubring C q F E rF rE := by
  let S := coefficientSubring C q F E rF rE
  change homComponent n (inverseFamily C q E rE) ∈ S
  induction n using Nat.strong_induction_on with
  | h n ih =>
      have hrec : homComponent n (inverseFamily C q E rE) = homComponent n 1 -
          ∑ j : Fin n, homComponent (n - j) (chernFamily C q E rE) *
            homComponent j (inverseFamily C q E rE) := by
        simpa only [inverseFamily_eq_gradedRightInv] using
          homComponent_gradedRightInv (chernFamily C q E rE) n
      rw [hrec]
      apply S.sub_mem
      · by_cases hn : n = 0
        · subst n
          rw [GradedCapFamily.IsHomogeneous.one.homComponent_self]
          exact S.one_mem
        · rw [GradedCapFamily.IsHomogeneous.one.homComponent_of_ne hn]
          exact S.zero_mem
      · apply S.sum_mem
        intro j _
        exact S.mul_mem (rightComponent_mem C q F E rF rE (n - j)) (ih j j.isLt)

/-- Genuine finite convolution puts each actual virtual component in
the same actual coefficient subring. -/
theorem virtualComponent_mem (n : ℕ) :
    homComponent n (virtualFamily C q F E rF rE) ∈ coefficientSubring C q F E rF rE := by
  rw [virtualFamily, homComponent_mul]
  apply (coefficientSubring C q F E rF rE).sum_mem
  intro j _
  exact (coefficientSubring C q F E rF rE).mul_mem
    (leftComponent_mem C q F E rF rE (n - j)) (inverseComponent_mem C q F E rF rE j)

/-- Any two actual homogeneous components of the original virtual
family commute. This follows from genuine Chern-component commutation
and finite recurrence, rather than whole-family self-commutation. -/
theorem commute_homComponent_virtualFamily (i j : ℕ) :
    Commute (homComponent i (virtualFamily C q F E rF rE))
      (homComponent j (virtualFamily C q F E rF rE)) := by
  let a : coefficientSubring C q F E rF rE :=
    ⟨homComponent i (virtualFamily C q F E rF rE), virtualComponent_mem C q F E rF rE i⟩
  let b : coefficientSubring C q F E rF rE :=
    ⟨homComponent j (virtualFamily C q F E rF rE), virtualComponent_mem C q F E rF rE j⟩
  exact congrArg (fun x : coefficientSubring C q F E rF rE =>
    (x : GradedCapFamily (chowGroup C q))) (mul_comm a b)

end M9Native.ChowVirtualComponentCommutation
