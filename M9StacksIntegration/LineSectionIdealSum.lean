module

public import M9StacksIntegration.IteratedLineSectionCuts
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemePower
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemeFactorization

/-!
# The actual ideal of successive line-section cuts

The literal successive zero schemes are the closed subscheme defined by the
sum of the original zero ideals. On every affine open with an actual line
generator, this is the ideal generated by the original scalar equations.
The comparison uses factorization on every test scheme and preserves the
original closed immersion; it includes the nilpotent structure.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u
namespace M9Native.LineSectionIdealSum
open IteratedLineSectionCuts

variable {X : Scheme.{u}} (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]

/-- The sum of the actual original section zero ideals, with list membership
retained so that repetitions and the given ordering require no assumptions. -/
def ideal (ss : List Γ(L, ⊤)) : X.IdealSheafData :=
  ⨆ s : {s : Γ(L, ⊤) // s ∈ ss}, Stacks.Divisors.zeroScheme X L s.1

theorem ideal_factors_iff (ss : List Γ(L, ⊤))
    {T : Scheme.{u}} (f : T ⟶ X) :
    (∃ g : T ⟶ (ideal L ss).subscheme, g ≫ (ideal L ss).subschemeι = f) ↔
      ∀ s ∈ ss, pullbackGlobalSections f L s = 0 := by
  rw [factorsThrough_ideal_iff_ideal_le_ker, ideal, iSup_le_iff]
  constructor
  · intro h s hs
    exact (Stacks.Divisors.pullbackSection_eq_zero_iff_factorsThrough_zeroScheme X L s f).mpr
      ((factorsThrough_ideal_iff_ideal_le_ker _ _).mpr (h ⟨s, hs⟩))
  · intro h s
    exact (factorsThrough_ideal_iff_ideal_le_ker _ _).mp
      ((Stacks.Divisors.pullbackSection_eq_zero_iff_factorsThrough_zeroScheme X L s.1 f).mp
        (h s.1 s.2))

/-- Actual scheme identification, over the original ambient scheme. -/
def cutIso (ss : List Γ(L, ⊤)) :
    (simultaneousCut L ss).left ≅ (ideal L ss).subscheme := by
  letI : Mono (Over.mk (ideal L ss).subschemeι).hom := by
    change Mono (ideal L ss).subschemeι
    infer_instance
  exact comparisonIso (simultaneousCut L ss) (Over.mk (ideal L ss).subschemeι)
    (fun _ f => (simultaneousCut_factors_iff L f ss).trans (ideal_factors_iff L ss f).symm)

@[reassoc]
theorem cutIso_hom_comp (ss : List Γ(L, ⊤)) :
    (cutIso L ss).hom ≫ (ideal L ss).subschemeι = (simultaneousCut L ss).hom := by
  letI : Mono (Over.mk (ideal L ss).subschemeι).hom := by
    change Mono (ideal L ss).subschemeι
    infer_instance
  dsimp only [cutIso]
  exact comparisonIso_hom_comp _ _ _

@[reassoc]
theorem cutIso_inv_comp (ss : List Γ(L, ⊤)) :
    (cutIso L ss).inv ≫ (simultaneousCut L ss).hom = (ideal L ss).subschemeι := by
  letI : Mono (Over.mk (ideal L ss).subschemeι).hom := by
    change Mono (ideal L ss).subschemeι
    infer_instance
  dsimp only [cutIso]
  exact comparisonIso_inv_comp _ _ _

/-- The actual structural closed immersion has exactly the sum ideal. -/
theorem cut_ker (ss : List Γ(L, ⊤)) : (simultaneousCut L ss).hom.ker = ideal L ss := by
  rw [← cutIso_hom_comp L ss, Scheme.Hom.ker_comp_of_isIso]
  exact Scheme.IdealSheafData.ker_subschemeι _

/-- The affine ideal consists of the original scalar coefficients in any
actual line frame. A frame and its coefficients are concrete local data,
not a prescribed ideal equality. -/
theorem ideal_affine_coefficients (ss : List Γ(L, ⊤)) (U : X.affineOpens)
    (g : Γ(L, U.1)) (hg : Function.Bijective (fun c : Γ(X, U.1) => c • g))
    (a : {s : Γ(L, ⊤) // s ∈ ss} → Γ(X, U.1))
    (ha : ∀ s, L.presheaf.map (homOfLE le_top).op s.1 = a s • g) :
    (ideal L ss).ideal U = Ideal.span (Set.range a) := by
  rw [ideal, Scheme.IdealSheafData.ideal_iSup]
  rw [iSup_apply]
  rw [Ideal.span_range_eq_iSup]
  congr 1
  funext s
  exact AlgebraicGeometry.zeroScheme_ideal_eq_span_singleton_of_bijective_smul
    X L s.1 U g hg (a s) (ha s)

end M9Native.LineSectionIdealSum
