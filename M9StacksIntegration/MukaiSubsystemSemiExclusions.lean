module

public import M9StacksIntegration.MukaiBundleRecognition
public import M9StacksIntegration.MukaiEvaluationMatrix

/-!
# Pair exclusion inside a genuine finite section subsystem

All auxiliary sections remain in the actual six-dimensional submodule
of native H0. Semi-irreducibility is used only on that submodule. The
whole H0 space is never assumed to have dimension six or to satisfy
complete semi-irreducibility.

For an actual rank-two subobject generated by three independent
sections from this subsystem, a nonzero map to the structure sheaf
would split. Its genuine line kernel contains an independent pair of
those original section combinations, contradicting the subsystem pair
exclusion. No complete section dimension of the rank-two object is used.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 1600000
set_option maxRecDepth 4096

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace Module
open M9Native.MukaiBundle M9Native.MukaiBundleDeterminant

universe u

attribute [local implicit_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.Scheme.Modules AlgebraicGeometry.Scheme.Modules.Hom

namespace M9Native.MukaiSubsystemSemiExclusions

open MukaiSemiExclusions

variable (K : Type u) [Field K] {X : Scheme.{u}} (f : X ⟶ Spec (.of K))

section Pair

variable [IsIntegral X] [IsAlgClosed K] [LocallyOfFiniteType f]
  (E : X.Modules) [SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} E 3]

/-- The actual pair exclusion inside a genuine six-dimensional native
section subspace, with Semi3 tested only on that subspace. -/
theorem pair_rank_exclusion_of_semi
    (A : Submodule K (cohomologyOverField K f E 0))
    (hA : finrank K A = 6)
    (hsemi : MukaiSemiIrreducible.SemiIrreducible K f E 3 A)
    (s : Fin 2 → cohomologyOverField K f E 0) (hs : LinearIndependent K s)
    (hsA : ∀ i, s i ∈ A) :
    ∃ x : X, 2 ≤ MukaiSemiIrreducible.mapRankAt
      (MukaiSemiIrreducible.evaluation K f E s) x := by
  classical
  let : Module.Finite K A := Module.finite_of_finrank_pos (by rw [hA]; decide)
  let sA : Fin 2 → A := fun i => ⟨s i, hsA i⟩
  have hsAli : LinearIndependent K sA := LinearIndependent.of_comp A.subtype hs
  by_contra hn
  have hbad (y : X) : MukaiSemiIrreducible.mapRankAt
      (MukaiSemiIrreducible.evaluation K f E s) y ≤ 1 := by
    have hnot : ¬2 ≤ MukaiSemiIrreducible.mapRankAt
        (MukaiSemiIrreducible.evaluation K f E s) y := fun h => hn ⟨y, h⟩
    omega
  obtain ⟨p, hp⟩ := BaseFieldPoints.exists_point f
  let c := pointEquivClosedPoint f ⟨p, hp⟩
  let x := c.val
  have hx : IsClosed ({x} : Set X) := c.property
  let e : A →ₗ[K] (Fin 3 → K) := (closedEvaluation K f E x hx).comp A.subtype
  obtain ⟨v, hv, houtside⟩ := exists_killed_outside_pair e hA (by simp) sA hsAli
  let tA : Fin 3 → A := Fin.cons v sA
  have htA : LinearIndependent K tA := linearIndependent_finCons.mpr ⟨hsAli, houtside⟩
  let t : Fin 3 → cohomologyOverField K f E 0 := fun i => (tA i).val
  have hpoint : MukaiSemiIrreducible.mapRankAt
      (MukaiSemiIrreducible.evaluation K f E t) x ≤ 1 := by
    rw [closedEvaluation_rank K f E x hx]
    have hb := hbad x
    rw [closedEvaluation_rank K f E x hx] at hb
    change finrank K (valueSpan e sA) ≤ 1 at hb
    change finrank K (valueSpan e (Fin.cons v sA)) ≤ 1
    rw [valueSpan_cons e sA v, hv, Submodule.span_zero_singleton, bot_sup_eq]
    exact hb
  let y := genericPoint X
  let := TupleEvaluationFiber.fiberFinite E 3 y
  let eA := (TupleEvaluationFiber.sectionValue K f E y).comp A.subtype
  have hgeneric : MukaiSemiIrreducible.mapRankAt
      (MukaiSemiIrreducible.evaluation K f E t) y ≤ 2 := by
    rw [mapRankAt_eq_finrank_valueSpan]
    have hb := hbad y
    rw [mapRankAt_eq_finrank_valueSpan] at hb
    change finrank (X.residueField y) (valueSpan eA sA) ≤ 1 at hb
    have hbound := finrank_valueSpan_cons_le eA sA v
    change finrank (X.residueField y) (valueSpan eA (Fin.cons v sA)) ≤ 2
    omega
  rcases hsemi tA htA with hm | hr
  · change Mono (MukaiSemiIrreducible.evaluation K f E t) at hm
    let := hm
    have h := mapRankAt_generic_of_mono K f E t
    change MukaiSemiIrreducible.mapRankAt (MukaiSemiIrreducible.evaluation K f E t) y = 3 at h
    omega
  · have h := hr x
    change MukaiSemiIrreducible.mapRankAt (MukaiSemiIrreducible.evaluation K f E t) x = 2 at h
    omega

end Pair

/-- The original tuple evaluation of zero native sections is the zero
sheaf morphism. -/
theorem evaluation_zero (E : X.Modules) (r : ℕ) :
    MukaiSemiIrreducible.evaluation K f E (fun _ : Fin r => 0) = 0 := by
  apply MukaiEvaluationMatrix.freeHom_ext_top
  intro i
  rw [MukaiEvaluationMatrix.evaluation_basisSection]
  change (cohomologyOverFieldZeroLinearIso K f E).hom 0 = 0
  exact map_zero _

section Hom

variable [IsAlgClosed K] [IsProper f] [IsCurve K f] [Smooth f]
  (E : X.Modules) [SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} E 3]

/-- A rank-two subobject generated by three independent ORIGINAL
subsystem sections has no nonzero morphism to the structure sheaf.
Neither H0(F)=3 nor completeness of the six-section system is assumed. -/
theorem hom_unit_eq_zero_of_generated_three_subsystem
    (A : Submodule K (cohomologyOverField K f E 0)) (hA : finrank K A = 6)
    (hsemi : MukaiSemiIrreducible.SemiIrreducible K f E 3 A)
    (F : X.Modules) [SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} F 2]
    (j : F ⟶ E) [Mono j]
    (u : Fin 3 → cohomologyOverField K f F 0) (hu : LinearIndependent K u)
    (hepi : Epi (MukaiSemiIrreducible.evaluation K f F u))
    (huA : ∀ i, cohomologyOverFieldMap K f j 0 (u i) ∈ A)
    (p : F ⟶ structureModule X) : p = 0 := by
  classical
  by_contra hp
  let O : X.Modules := structureModule X
  let := isIso_globalSections_of_isAlgClosed K f
  let : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property O :=
    Stacks.SheafOfModules.isInvertible_unit _ _
  let : SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} O 1 :=
    SheafOfModules.isFiniteLocallyFreeOfRank_one_of_isInvertible X O
  have hgenF : MukaiSemiIrreducible.GloballyGenerated F :=
    ⟨{ I := ULift.{u} (Fin 3)
       s := fun i => MukaiSemiIrreducible.sectionOfH0 K f F (u i.down)
       epi := hepi }⟩
  obtain ⟨spl, hspl⟩ :=
    MukaiBundleRecognition.section_of_nonzero_to_unit_of_globallyGenerated K f F hgenF p hp
  let : Epi p := epi_of_epi_fac hspl
  let : SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} (kernel p) 1 :=
    Stacks.ProjectiveBundleSplitting.isFiniteLocallyFreeOfRank_kernel_of_epi
      p inferInstance 2 1 inferInstance inferInstance
  let := MukaiRecognitionHomBound.finite_bundle_H0 K f O 1
  have hO : finrank K (cohomologyOverField K f (structureModule X) 0) = 1 :=
    finrank_cohomologyOverField_unit_zero_eq_one f
  let C : (Fin 3 → K) →ₗ[K] cohomologyOverField K f F 0 := Fintype.linearCombination K u
  have hC : Function.Injective C := linearIndependent_iff_injective_fintypeLinearCombination.mp hu
  let ψ := (cohomologyOverFieldMap K f p 0).hom.comp C
  have hker : 2 ≤ finrank K (LinearMap.ker ψ) := by
    have hd := ψ.finrank_range_add_finrank_ker
    have hb := (LinearMap.range ψ).finrank_le
    have hsource : finrank K (Fin 3 → K) = 3 := by simp
    change finrank K (LinearMap.range ψ) ≤
      finrank K (cohomologyOverField K f (structureModule X) 0) at hb
    rw [hO] at hb
    rw [hsource] at hd
    omega
  obtain ⟨a, ha⟩ := exists_linearIndependent_of_le_finrank hker
  let v : Fin 2 → cohomologyOverField K f F 0 := fun i => C (a i).val
  have hv : LinearIndependent K v :=
    (ha.map' ψ.ker.subtype (Submodule.ker_subtype _)).map' C (LinearMap.ker_eq_bot.mpr hC)
  let d := (cohomologyOverFieldMap K f j 0).hom
  let t : Fin 2 → cohomologyOverField K f E 0 := fun i => d (v i)
  have ht : LinearIndependent K t :=
    hv.map' d (LinearMap.ker_eq_bot.mpr
      (MukaiThreeSectionDeterminant.cohomologyMap_injective_of_mono K f j))
  have htA (i : Fin 2) : t i ∈ A := by
    change d (C (a i).val) ∈ A
    simp only [C, Fintype.linearCombination_apply, map_sum, map_smul]
    exact Submodule.sum_mem A (fun r _ => A.smul_mem ((a i).val r) (huA r))
  have hv0 (i : Fin 2) : cohomologyOverFieldMap K f p 0 (v i) = 0 := (a i).property
  have hv0fun : (fun i : Fin 2 => cohomologyOverFieldMap K f p 0 (v i)) =
      (fun _ : Fin 2 => 0) := funext hv0
  have hz : MukaiSemiIrreducible.evaluation K f F v ≫ p = 0 := by
    rw [MukaiBundleRecognition.evaluation_naturality, hv0fun, evaluation_zero K f O 2]
  let ell := kernel.lift p (MukaiSemiIrreducible.evaluation K f F v) hz
  have hfac : ell ≫ (kernel.ι p ≫ j) = MukaiSemiIrreducible.evaluation K f E t := by
    calc
      _ = MukaiSemiIrreducible.evaluation K f F v ≫ j := by
        simp only [ell, ← Category.assoc, kernel.lift_ι]
      _ = _ := MukaiBundleRecognition.evaluation_naturality K f j v
  obtain ⟨x, hx⟩ := pair_rank_exclusion_of_semi K f E A hA hsemi t ht htA
  have hsmall := MukaiBundleRecognition.mapRankAt_factor_le ell (kernel.ι p ≫ j) 1 x
  rw [hfac] at hsmall
  omega

end Hom

end M9Native.MukaiSubsystemSemiExclusions
