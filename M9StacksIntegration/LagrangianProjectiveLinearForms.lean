module

public import M9StacksIntegration.LagrangianProjectiveIntersection
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.LinearSubspaceQuotientMap

/-! The actual five homogeneous linear equations of the genuine quotient
projective plane. The kernel of the actual graded symmetric-algebra map
is generated by these five forms; no kernel or defining-ideal equality
is assumed. -/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000

open AlgebraicGeometry Module
open AlgebraicGeometry.ProjectiveSpaceOfModule
open M9Native.LagrangianProjectiveIntersection

universe u

namespace M9Native.LagrangianProjectiveLinearForms

variable (K : Type u) [Field K] (L : Coordinates K →ₗ[K] (Fin 5 → K))

def rowForms : Fin 5 → Forms K :=
  fun j => L.dualMap ((Pi.basisFun K (Fin 5)).dualBasis j)

def fiveForms : Fin 5 → SymmetricAlgebra K (Forms K) :=
  fun j => SymmetricAlgebra.ι K (Forms K) (rowForms K L j)

theorem constraints_eq_span : constraints K L = Submodule.span K (Set.range (rowForms K L)) := by
  change L.dualMap.range = _
  calc
    L.dualMap.range = Submodule.map L.dualMap ⊤ := (Submodule.map_top _).symm
    _ = Submodule.map L.dualMap
        (Submodule.span K (Set.range (Pi.basisFun K (Fin 5)).dualBasis)) := by
      rw [Basis.span_eq]
    _ = Submodule.span K (Set.range (rowForms K L)) := by
      rw [Submodule.map_span, ← Set.range_comp]
      rfl

theorem span_iota_constraints :
    Ideal.span (SymmetricAlgebra.ι K (Forms K) '' (constraints K L : Set (Forms K))) =
      Ideal.span (Set.range (fiveForms K L)) := by
  let J := Ideal.span (Set.range (fiveForms K L))
  have hW : constraints K L ≤ Submodule.comap (SymmetricAlgebra.ι K (Forms K))
      (J.restrictScalars K) := by
    rw [constraints_eq_span, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨j, rfl⟩
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨w, hw, rfl⟩
    exact hW hw
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨rowForms K L j,
      (show rowForms K L j ∈ constraints K L from ⟨(Pi.basisFun K (Fin 5)).dualBasis j, rfl⟩),
      rfl⟩

theorem fiveForms_homogeneous_one (j : Fin 5) :
    fiveForms K L j ∈ SymPow.symmetricPower 1 K (Forms K) :=
  AlgebraicGeometry.ProjectiveSpaceOfModule.ι_mem_symmetricPower_one K (Forms K) (rowForms K L j)

/-- The genuine graded quotient defining the native projective plane has
exactly the ideal generated by the five actual linear forms as kernel. -/
theorem quotientGradedHom_kernel :
    RingHom.ker (quotientGradedHom K (Forms K) (constraints K L)).toRingHom =
      Ideal.span (Set.range (fiveForms K L)) := by
  change RingHom.ker (SymPow.symAlgMap (constraints K L).mkQ) = _
  rw [Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span _ (constraints K L).mkQ_surjective,
    Submodule.ker_mkQ, span_iota_constraints]

end M9Native.LagrangianProjectiveLinearForms
