module

public import M9StacksIntegration.LagrangianLinearSectionEquations
public import M9StacksIntegration.FiniteFreeSectionIdeal

/-! Actual affine ideals of the original universal incidence family, expressed
in the genuine line and quotient frames. -/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
universe u
namespace M9Native.LagrangianLinearSectionIdeals
open M9Native.LagrangianLinearSections M9Native.LagrangianMatrixChart
open M9Native.LagrangianLinearSectionEquations M9Native.LinearIncidenceTensorCoordinates
open M9Native.FiniteFreeSectionIdeal
variable (K : Type u) [Field K]

/-- The literal original pulled ideal is generated by the actual five matrix equations. -/
theorem ideal_top {T : Scheme.{u}} [IsAffine T] (f : T ⟶ ambient K)
    (e : (Scheme.Modules.pullback f).obj (lineBundle K) ≅
      (SheafOfModules.unit T.ringCatSheaf : T.Modules))
    (d : (Scheme.Modules.pullback f).obj (quotientFive K) ≅ freeOn T 5)
    (q : freeOn T 14 ⟶ freeOn T 5)
    (hq : (AlgebraicGeometry.Grassmannian.pullbackPresentation f (ambientQuotient K)).map ≫ d.hom=q) :
    ((ideal K).comap f).ideal ⟨⊤,isAffineOpen_top T⟩=
      Ideal.span (Set.range ((Stacks.FreeSheafMatrix.toMatrix q).mulVec (lineCoefficients K f e))) := by
  have : SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u}
      ((Scheme.Modules.pullback f).obj (equationBundle K)) 5 :=
    AlgebraicGeometry.Grassmannian.isFiniteLocallyFreeOfRank_pullback
      f.base f.toRingCatSheafHom (equationBundle K) 5 inferInstance
  have : SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} (freeOn T 5) 5 :=
    AlgebraicGeometry.Grassmannian.free_isFiniteLocallyFreeOfRank T 5
  rw [ideal_baseChange]
  rw [sectionZeroIdeal_eq_of_iso 5
    (pullbackTensorTrivialization f (lineBundle K) (quotientFive K) 5 e d)]
  rw [sectionZeroIdeal_free_top,equationSection_coordinates K f e d q hq]

end M9Native.LagrangianLinearSectionIdeals
end
