module

public import M9StacksIntegration.MukaiPencilQuotient
public import M9StacksIntegration.MukaiBundleUniqueness
public import M9StacksIntegration.MukaiDualSpanDeterminant
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleSplitting.KernelConstantRankGeneral

/-!
# Actual recognition from three generators

An actual rank-two bundle generated by three sections, with its actual
top exterior power identified with a complete net line and with no map
to the structure sheaf, is identified with that line's original dual
span. The three residual sections and their basis are constructed from
the actual dual evaluation sequence. The source change of basis and
the resulting kernel isomorphism are the genuine frozen native maps.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 2000000
set_option maxRecDepth 4096
set_option linter.style.haveILetI false

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open Stacks.AlgebraicGeometry.ReflexiveModules
open M9Native.MukaiBundle M9Native.MukaiBundleDeterminant

universe u

namespace M9Native.MukaiThreeGeneratorRecognition

variable {X : Scheme.{u}}

/-- The actual first object of a short exact sequence is its actual
categorical kernel, with both comparison maps constructed explicitly. -/
def shortExactKernelIso (S : ShortComplex X.Modules) (hS : S.ShortExact) :
    S.X₁ ≅ kernel S.g := by
  letI := hS.mono_f
  let a := kernel.lift S.g S.f S.zero
  let b := hS.exact.lift (kernel.ι S.g) (kernel.condition S.g)
  have ha : a ≫ kernel.ι S.g = S.f := kernel.lift_ι _ _ _
  have hb : b ≫ S.f = kernel.ι S.g := hS.exact.lift_f _ _
  refine ⟨a, b, ?_, ?_⟩
  · apply (cancel_mono S.f).mp
    simp only [Category.assoc, hb, ha, Category.id_comp]
  · apply (cancel_mono (kernel.ι S.g)).mp
    simp only [Category.assoc, ha, hb, Category.id_comp]

variable (k : Type u) [Field k] (f : X ⟶ Spec (.of k))
variable [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)]

/-- The three actual free inclusions are independent over the original
base field, using the actual constants isomorphism. -/
theorem freeInclusions_linearIndependent :
    letI := modulesLinearOverField k f
    LinearIndependent k
      (Sigma.ι (fun _ : ULift.{u} (Fin 3) => (show X.Modules from structureModule X))) := by
  classical
  letI := modulesLinearOverField k f
  let O : X.Modules := structureModule X
  let N : X.Modules := netFree X
  change LinearIndependent k (Sigma.ι (fun _ : ULift.{u} (Fin 3) => O))
  have hO : (𝟙 O) ≠ 0 := by
    intro hid
    have hzero : IsZero (structureModule X) := (IsZero.iff_id_eq_zero _).mpr hid
    letI : (cohomologyOverFieldFunctor k f 0).Additive := by
      dsimp [cohomologyOverFieldFunctor]
      infer_instance
    letI : Subsingleton (cohomologyOverField k f (structureModule X) 0) :=
      ModuleCat.subsingleton_of_isZero ((cohomologyOverFieldFunctor k f 0).map_isZero hzero)
    have hz : Module.finrank k (cohomologyOverField k f (structureModule X) 0) = 0 :=
      Module.finrank_zero_of_subsingleton
    have hone := finrank_cohomologyOverField_unit_zero_eq_one f
    change Module.finrank k (cohomologyOverField k f (structureModule X) 0) = 1 at hone
    omega
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  let p : N ⟶ O :=
    Sigma.desc (fun j : ULift.{u} (Fin 3) => if j = i then 𝟙 _ else 0)
  have hp := congrArg (fun a : O ⟶ N => a ≫ p) hc
  have hz : c i • (𝟙 O) = 0 := by
    simpa only [p, Preadditive.sum_comp, Linear.smul_comp, Sigma.ι_comp_desc,
      zero_comp, smul_ite, smul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true] using hp
  exact (smul_eq_zero.mp hz).resolve_right hO

/-- Actual three-generator recognition. Every hypothesis concerns the
given bundle, maps and line; no dual-span isomorphism is supplied. -/
def dualSpanIso_of_three_generators (K β : X.Modules)
    [SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} K 2]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property β]
    (q : netFree X ⟶ K) [Epi q]
    (hdet : topExterior K 2 ≅ β)
    (hvan : ∀ a : K ⟶ structureModule X, a = 0)
    (bβ : Module.Basis (ULift.{u} (Fin 3)) k (cohomologyOverField k f β 0)) :
    K ≅ dualSpan β (MukaiDualSpanSections.completeNetSections f β bβ) := by
  classical
  letI := modulesLinearOverField k f
  let O : X.Modules := structureModule X
  let N : X.Modules := netFree X
  letI : SheafOfModules.IsFiniteLocallyFree.{u,u,u} K :=
    SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree K 2
  letI : SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} (netFree X) 3 := netFree_rank X
  letI : SheafOfModules.IsFiniteLocallyFree.{u,u,u} (netFree X) :=
    SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree (netFree X) 3
  letI : SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} (kernel q) 1 :=
    Stacks.ProjectiveBundleSplitting.isFiniteLocallyFreeOfRank_kernel_of_epi
      q inferInstance 3 2 inferInstance inferInstance
  letI : SheafOfModules.IsFiniteLocallyFree.{u,u,u} (kernel q) :=
    SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree (kernel q) 1
  letI : SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} β 1 :=
    SheafOfModules.isFiniteLocallyFreeOfRank_one_of_isInvertible X β
  letI : SheafOfModules.IsFiniteLocallyFree.{u,u,u} β :=
    SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree β 1
  let S := ShortComplex.mk (kernel.ι q) q (kernel.condition q)
  have hS : S.ShortExact := { exact := ShortComplex.exact_kernel q }
  let hprod : tensor (kernel q) β ≅ structureModule X :=
    tensorIso (Scheme.Modules.exteriorPowerOneIsoSelf (kernel q)).symm hdet.symm ≪≫
      Scheme.Modules.exteriorPowerTensorExteriorPowerIso
        (kernel.ι q) q (kernel.condition q) hS 1 1 ≪≫
      freeTopExteriorIso 3 (netFree X) (Iso.refl _)
  let eZ : kernel q ≅ dualSheaf β :=
    tensorInverseNativeIso β (kernel q)
      (Stacks.SheafOfModules.Invertible.tensorProductBraiding X.presheaf X.ringCatSheaf.property
        β (kernel q) ≪≫ hprod)
  letI := isIso_toDoubleDual_of_isFiniteLocallyFree β
  let eZdual : dualSheaf (kernel q) ≅ β :=
    (MukaiPencilQuotient.dualIso eZ).symm ≪≫ (asIso (toDoubleDual β)).symm
  let hd := exists_dualSheaf_shortExact
    (kernel.ι q) q (kernel.condition q) hS.mono_f hS.epi_g hS.exact
    ((Stacks.FiniteLocallyFree.isFiniteLocallyFree_iff_algebraicGeometry _).2 inferInstance)
    ((Stacks.FiniteLocallyFree.isFiniteLocallyFree_iff_algebraicGeometry _).2 inferInstance)
    ((Stacks.FiniteLocallyFree.isFiniteLocallyFree_iff_algebraicGeometry _).2 inferInstance)
  let wd := Classical.choose hd
  have hD := Classical.choose_spec hd
  let eFree := dualNetFreeIso X
  let i : dualSheaf K ⟶ netFree X := dualMap q ≫ eFree.hom
  let p : netFree X ⟶ β := eFree.inv ≫ dualMap (kernel.ι q) ≫ eZdual.hom
  have w : i ≫ p = 0 := by
    calc
      i ≫ p = (dualMap q ≫ dualMap (kernel.ι q)) ≫ eZdual.hom := by
        simp [i, p, Category.assoc]
      _ = 0 := by rw [wd, zero_comp]
  let T := ShortComplex.mk i p w
  let eT : ShortComplex.mk (dualMap q) (dualMap (kernel.ι q)) wd ≅ T :=
    ShortComplex.isoMk (Iso.refl _) eFree eZdual
      (by simp [T, i]) (by simp [T, p])
  have hT : T.ShortExact := ShortComplex.shortExact_of_iso eT hD
  letI : Mono T.f := hT.mono_f
  letI : Subsingleton (K ⟶ structureModule X) :=
    ⟨fun a b => (hvan a).trans (hvan b).symm⟩
  let eH : (structureModule X ⟶ dualSheaf K) ≃ₗ[k] (K ⟶ structureModule X) :=
    (unitHomLinearEquivCohomologyZero k f (dualSheaf K)).trans
      (MukaiBundleUniqueness.homH0SheafHomLinearEquiv k f K (structureModule X)).symm
  letI : Subsingleton (structureModule X ⟶ dualSheaf K) :=
    ⟨fun a b => eH.injective (Subsingleton.elim _ _)⟩
  let P : (O ⟶ N) →ₗ[k] (O ⟶ β) :=
    { toFun := fun a => a ≫ p
      map_add' := fun a b => by simp only [Preadditive.add_comp]
      map_smul' := fun c a => by simp [Linear.smul_comp] }
  have hP : Function.Injective P := by
    apply LinearMap.ker_eq_bot.mp
    apply eq_bot_iff.mpr
    intro a ha
    change a = 0
    change a ≫ p = 0 at ha
    let t := hT.exact.lift a ha
    have ht : t ≫ i = a := hT.exact.lift_f a ha
    have ht0 : t = 0 := Subsingleton.elim _ _
    exact ht.symm.trans (by rw [ht0, zero_comp])
  let eSec := MukaiPencilQuotient.sectionHomLinearEquiv f β
  let v : ULift.{u} (Fin 3) → cohomologyOverField k f β 0 :=
    fun i => eSec.symm (P (SheafOfModules.ιFree i))
  have hv : LinearIndependent k v :=
    ((freeInclusions_linearIndependent k f).map' P (LinearMap.ker_eq_bot.mpr hP)).map'
      eSec.symm.toLinearMap (LinearMap.ker_eq_bot.mpr eSec.symm.injective)
  have hcard : Fintype.card (ULift.{u} (Fin 3)) =
      Module.finrank k (cohomologyOverField k f β 0) := by
    simpa using (Module.finrank_eq_card_basis bβ).symm
  let bNew := basisOfLinearIndependentOfCardEqFinrank hv hcard
  have hp : p = netEvaluation β (MukaiDualSpanSections.completeNetSections f β bNew) := by
    apply Sigma.hom_ext
    intro j
    change SheafOfModules.ιFree j ≫ p =
      SheafOfModules.ιFree j ≫ netEvaluation β (MukaiDualSpanSections.completeNetSections f β bNew)
    rw [MukaiPencilQuotient.completeNetEvaluation_generator f β bNew j]
    have hbNew : bNew j = eSec.symm (P (SheafOfModules.ιFree j)) := by
      simp [bNew, v]
    rw [hbNew, eSec.apply_symm_apply]
    rfl
  let eSource := MukaiPencilQuotient.completeNetSourceIso f β bNew bβ
  have hSource : eSource.hom ≫ netEvaluation β (MukaiDualSpanSections.completeNetSections f β bβ) = p :=
    (MukaiPencilQuotient.completeNetSourceIso_evaluation f β bNew bβ).trans hp.symm
  let eKernel : dualSheaf K ≅ evaluationKernel β (MukaiDualSpanSections.completeNetSections f β bβ) :=
    shortExactKernelIso T hT ≪≫
      MukaiPencilQuotient.kernelSourceIso eSource p
        (netEvaluation β (MukaiDualSpanSections.completeNetSections f β bβ)) hSource
  letI := isIso_toDoubleDual_of_isFiniteLocallyFree K
  exact asIso (toDoubleDual K) ≪≫ (MukaiPencilQuotient.dualIso eKernel).symm

end M9Native.MukaiThreeGeneratorRecognition
