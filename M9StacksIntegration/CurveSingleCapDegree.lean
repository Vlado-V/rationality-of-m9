module

public import M9StacksIntegration.CurveTopChowClass
public import StacksFrontier.AlgebraicGeometry.Chow.ChernCapPushforward.Proper
public import StacksFrontier.AlgebraicGeometry.Chow.Degrees.DegreeHomomorphism

/-!
# Genuine single-Chern-cap degrees over an integral curve

The functional below is the actual native first Chern cap followed by
the actual native zero-cycle degree. Proper pushforward gives its
projection formula. Since the actual top Chow group of an integral
curve is generated by its fundamental class, every such functional is
determined by the degree of the actual line on that class.

No Picard divisibility, Jacobian trace, theta class, or Weil theory is
assumed or imported.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace M9Native.CurveSingleCapDegree

open Stacks.Chow CurveTopChowClass

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f]

def singleCapDegree (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] :
    chowGroup (fieldChowSituation k) f 1 →+ ℤ :=
  (chowDegree (fieldChowSituation k) (fieldChowSituation_dimensionFunction_eq_zero k) f
    (IsLocalRing.closedPoint k)).comp ((invCap (fieldChowSituation k) f L).capOnChow
      (fieldChowSituation k) f 0)

theorem zeroCycleDegree_proper {Y : Scheme.{u}} (fY : Y ⟶ Spec (.of k)) [IsProper fY]
    (g : Y ⟶ X) [IsProper g] (hg : g ≫ f = fY)
    (z : chowGroup (fieldChowSituation k) fY 0) :
    chowDegree (fieldChowSituation k) (fieldChowSituation_dimensionFunction_eq_zero k) fY
        (IsLocalRing.closedPoint k) z =
      chowDegree (fieldChowSituation k) (fieldChowSituation_dimensionFunction_eq_zero k) f
        (IsLocalRing.closedPoint k)
        (properChowPushforward (fieldChowSituation k) fY f g hg 0
          (properPushforwardFactorsThroughRationalEquivalence_of_isProper (fieldChowSituation k)
            fY f g hg 0) z) := by
  subst hg
  simp only [chowDegree, AddMonoidHom.comp_apply]
  congr 1
  exact (properChowPushforward_properChowPushforward (fieldChowSituation k) (g ≫ f) f
    (𝟙 (fieldChowSituation k).S) g f rfl (Category.comp_id f) 0 z).symm

theorem singleCapDegree_proper {Y : Scheme.{u}} (fY : Y ⟶ Spec (.of k)) [IsProper fY]
    (g : Y ⟶ X) [IsProper g] (hg : g ≫ f = fY) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (a : chowGroup (fieldChowSituation k) fY 1) :
    singleCapDegree k fY ((Scheme.Modules.pullback g).obj L) a =
      singleCapDegree k f L
        (properChowPushforward (fieldChowSituation k) fY f g hg 1
          (properPushforwardFactorsThroughRationalEquivalence_of_isProper (fieldChowSituation k)
            fY f g hg 1) a) := by
  simp only [singleCapDegree, AddMonoidHom.comp_apply]
  rw [zeroCycleDegree_proper k f fY g hg,
    properChowPushforward_invCap_capOnChow (fieldChowSituation k) fY f g hg 0 L]
  rfl

section IntegralCurve

variable [IsIntegral X] (hdim : schemeDeltaDimension (fieldChowSituation k) f = (1 : EInt))
  (L M : X.Modules)
  [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
  [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property M]

include hdim

theorem singleCapDegree_cross_mul (a : chowGroup (fieldChowSituation k) f 1) :
    singleCapDegree k f L a * singleCapDegree k f M (identityChowClass (fieldChowSituation k) f 1) =
      singleCapDegree k f L (identityChowClass (fieldChowSituation k) f 1) *
        singleCapDegree k f M a :=
  addHom_cross_mul (fieldChowSituation k) f 1 hdim
    (singleCapDegree k f L) (singleCapDegree k f M) a

/-- The actual projected cap pairings depend only on the actual
single-line degrees on the integral curve. This equality carries no
normalization or numerical-equivalence assumption. -/
theorem pullback_singleCapDegree_cross_mul {Y : Scheme.{u}} (fY : Y ⟶ Spec (.of k))
    [IsProper fY] (g : Y ⟶ X) [IsProper g] (hg : g ≫ f = fY)
    (a : chowGroup (fieldChowSituation k) fY 1) :
    singleCapDegree k fY ((Scheme.Modules.pullback g).obj L) a *
        singleCapDegree k f M (identityChowClass (fieldChowSituation k) f 1) =
      singleCapDegree k f L (identityChowClass (fieldChowSituation k) f 1) *
        singleCapDegree k fY ((Scheme.Modules.pullback g).obj M) a := by
  rw [singleCapDegree_proper k f fY g hg L, singleCapDegree_proper k f fY g hg M]
  exact singleCapDegree_cross_mul k f hdim L M _

theorem singleCapDegree_zero_of_identity_zero
    (hL : singleCapDegree k f L (identityChowClass (fieldChowSituation k) f 1) = 0)
    (a : chowGroup (fieldChowSituation k) f 1) : singleCapDegree k f L a = 0 :=
  addHom_zero_of_identity_zero (fieldChowSituation k) f 1 hdim (singleCapDegree k f L) hL a

end IntegralCurve

end M9Native.CurveSingleCapDegree
