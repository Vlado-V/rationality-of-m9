module

public import M9StacksIntegration.GradedCapVirtualSchur
public import M9StacksIntegration.ChowCapWords
public import Mathlib.Algebra.Ring.Subring.Basic

/-!
# The commutative subring of actual line-cap families

Each generator is the literal native first-Chern cap operator of an
actual invertible module, concentrated in degree one. The genuine
Stacks 02TJ theorem proves the generators commute on every Chow grade.
Only their generated subring receives a CommRing structure. The ambient
ring of graded cap families remains noncommutative.

No membership of an infinite inverse family in this uncompleted
subring is asserted.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false

universe u
namespace M9Native.GradedLineCapSubring
open AlgebraicGeometry CategoryTheory Stacks.Chow
open M9Native.ChowCapWords M9Native.GradedCapVirtualSchur

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (q : X ⟶ C.S)
    [LocallyOfFiniteType q]

/-- The actual line cap, and zero in every other homogeneous degree.
Its input and output are transported only by native degree casts. -/
def lineFamily (L : InvertibleLine X) : GradedCapFamily (chowGroup C q) := fun k i =>
  if h : i = 1 then
    (gradedDegreeCast (chowGroup C q)
      (show k - 1 = k - (i : ℤ) by simp [h])).toAddMonoidHom.comp
      (((lineCap C q L).capOnChow C q (k - 1)).comp
        (gradedDegreeCast (chowGroup C q) (show k = k - 1 + 1 by omega)).toAddMonoidHom)
  else 0

/-- The first coefficient is the original native cap map of the same
actual line; this does not replace it by a numerical functional. -/
theorem lineFamily_apply_one (L : InvertibleLine X) (k : ℤ) (α : chowGroup C q k) :
    lineFamily C q L k 1 α = (lineCap C q L).capOnChow C q (k - 1)
      (gradedDegreeCast (chowGroup C q) (show k = k - 1 + 1 by omega) α) := by
  simp only [lineFamily]
  rfl

/-- Each actual line family is homogeneous of degree one. -/
theorem lineFamily_homogeneous (L : InvertibleLine X) :
    (lineFamily C q L).IsHomogeneous 1 := fun _ _ h => dite_eq_right h

/-- Native grading compatibility for the same actual first-Chern cap. -/
theorem lineFamily_apply_heq (L : InvertibleLine X) {k d : ℤ}
    (hd : k - 1 = d) {α : chowGroup C q k} {β : chowGroup C q (d + 1)} (hα : α ≍ β) :
    lineFamily C q L k 1 α ≍ (lineCap C q L).capOnChow C q d β := by
  rw [lineFamily_apply_one]
  exact capOnChow_heq C q (lineCap C q L) hd
    ((gradedDegreeCast_heq _ α).trans hα)

/-- Ordered product application agrees with the actual two native line
caps in any equal grades. -/
theorem lineFamily_mul_apply_heq (L M : InvertibleLine X) {k d : ℤ}
    (hd : k - 2 = d) {α : chowGroup C q k} {β : chowGroup C q (d + 1 + 1)}
    (hα : α ≍ β) :
    (lineFamily C q L * lineFamily C q M) k 2 α ≍
      (lineCap C q L).capOnChow C q d
        ((lineCap C q M).capOnChow C q (d + 1) β) := by
  rw [mul_apply_of_homogeneous_right _ (lineFamily_homogeneous C q M) 1]
  change gradedDegreeCast (chowGroup C q) _
    (lineFamily C q L (k - (1 : ℤ)) 1 (lineFamily C q M k 1 α)) ≍ _
  refine (gradedDegreeCast_heq _ _).trans ?_
  exact lineFamily_apply_heq C q L (by omega)
    (lineFamily_apply_heq C q M (by omega) hα)

/-- Genuine native 02TJ on every Chow group proves the actual line
families commute in the operational cap ring. -/
theorem lineFamily_commute (L M : InvertibleLine X) :
    Commute (lineFamily C q L) (lineFamily C q M) := by
  change lineFamily C q L * lineFamily C q M = lineFamily C q M * lineFamily C q L
  funext k m
  by_cases hm : m = 2
  · subst m
    apply AddMonoidHom.ext
    intro α
    let β := gradedDegreeCast (chowGroup C q) (show k = (k - 2) + 1 + 1 by omega) α
    have hα : α ≍ β := (gradedDegreeCast_heq _ α).symm
    exact eq_of_heq ((lineFamily_mul_apply_heq C q L M rfl hα).trans
      ((heq_of_eq (lineCap_comm C q L M (k - 2) β)).trans
        (lineFamily_mul_apply_heq C q M L rfl hα).symm))
  · rw [((lineFamily_homogeneous C q L).mul (lineFamily_homogeneous C q M)) k m hm,
      ((lineFamily_homogeneous C q M).mul (lineFamily_homogeneous C q L)) k m hm]

/-- The actual subring generated by all actual invertible-line caps. -/
def lineSubring : Subring (GradedCapFamily (chowGroup C q)) :=
  Subring.closure (Set.range (lineFamily C q))

theorem lineFamily_mem (L : InvertibleLine X) : lineFamily C q L ∈ lineSubring C q :=
  Subring.subset_closure ⟨L, rfl⟩

/-- Only the generated subring is proved multiplicatively commutative. -/
instance lineSubring_isMulCommutative : IsMulCommutative (lineSubring C q) :=
  Subring.isMulCommutative_closure (by
    rintro a ⟨L, rfl⟩ b ⟨M, rfl⟩ _
    exact lineFamily_commute C q L M)

open scoped IsMulCommutative in
/-- The actual generated subring, with its actual inherited operations,
is a commutative ring. -/
instance lineSubring_commRing : CommRing (lineSubring C q) := inferInstance

/-- An actual line as an element of the actual generated ring. -/
def lineRoot (L : InvertibleLine X) : lineSubring C q :=
  ⟨lineFamily C q L, lineFamily_mem C q L⟩

@[simp] theorem coe_lineRoot (L : InvertibleLine X) :
    (lineRoot C q L : GradedCapFamily (chowGroup C q)) = lineFamily C q L := rfl

/-- The inclusion maps actual polynomial computations back to the same
native cap operators. -/
def inclusion : lineSubring C q →+* GradedCapFamily (chowGroup C q) :=
  (lineSubring C q).subtype

theorem inclusion_injective : Function.Injective (inclusion C q) := Subtype.val_injective

end M9Native.GradedLineCapSubring
