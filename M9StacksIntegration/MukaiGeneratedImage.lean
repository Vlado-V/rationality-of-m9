module

public import M9StacksIntegration.MukaiBundle
public import Mathlib.CategoryTheory.Preadditive.Biproducts
public import Mathlib.CategoryTheory.Abelian.Images

/-!
# The actual image generated by a subbundle and one extra section

The construction keeps the image, not its saturation. Its quotient by
the original subobject is generated by the extra section, and that
generator descends through any actual annihilating ideal.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Preadditive

universe u v

namespace M9Native.MukaiGeneratedImage

section Abelian

variable {C : Type u} [Category.{v} C] [Abelian C]
variable {Q E O : C} (j : Q ⟶ E) (a : O ⟶ E)

/-- The genuine image of the original subobject together with the
extra section. -/
def generatedImage : C := image (biprod.desc j a)

/-- Its original inclusion in E. -/
def inclusion : generatedImage j a ⟶ E := image.ι (biprod.desc j a)

/-- The actual factor of Q through the image. -/
def subobjectMap : Q ⟶ generatedImage j a :=
  biprod.inl ≫ factorThruImage (biprod.desc j a)

/-- The actual factor of the extra section through the image. -/
def sectionMap : O ⟶ generatedImage j a :=
  biprod.inr ≫ factorThruImage (biprod.desc j a)

@[reassoc (attr := simp)] theorem subobjectMap_inclusion :
    subobjectMap j a ≫ inclusion j a = j := by
  simp [subobjectMap, inclusion]

@[reassoc (attr := simp)] theorem sectionMap_inclusion :
    sectionMap j a ≫ inclusion j a = a := by
  simp [sectionMap, inclusion]

instance inclusion_mono : Mono (inclusion j a) := by
  dsimp [inclusion]
  infer_instance

instance subobjectMap_mono [Mono j] : Mono (subobjectMap j a) :=
  mono_of_mono_fac (subobjectMap_inclusion j a)

/-- The actual quotient of this generated image by Q. -/
def quotient : C := cokernel (subobjectMap j a)

def quotientMap : generatedImage j a ⟶ quotient j a :=
  cokernel.π (subobjectMap j a)

instance quotientMap_epi : Epi (quotientMap j a) := by
  dsimp [quotientMap]
  infer_instance

/-- The extra section generates the quotient. -/
def quotientSection : O ⟶ quotient j a := sectionMap j a ≫ quotientMap j a

instance quotientSection_epi : Epi (quotientSection j a) := by
  rw [epi_iff_cancel_zero]
  intro T b hb
  apply (cancel_epi (quotientMap j a)).mp
  apply (cancel_epi (factorThruImage (biprod.desc j a))).mp
  apply biprod.hom_ext'
  · have hzero : subobjectMap j a ≫ quotientMap j a = 0 := by
      exact cokernel.condition _
    simpa only [subobjectMap, Category.assoc, comp_zero] using
      (show (subobjectMap j a ≫ quotientMap j a) ≫ b = 0 from by rw [hzero, zero_comp])
  · simpa only [quotientSection, sectionMap, Category.assoc, comp_zero] using hb

/-- An actual relation of the extra section modulo Q annihilates its
actual quotient class. -/
theorem relation_quotientSection_zero {I : C} (k : I ⟶ O) (u : I ⟶ Q)
    (h : k ≫ a = u ≫ j) :
    k ≫ quotientSection j a = 0 := by
  have hlift : k ≫ sectionMap j a = u ≫ subobjectMap j a := by
    apply (cancel_mono (inclusion j a)).mp
    simpa only [Category.assoc, sectionMap_inclusion, subobjectMap_inclusion] using h
  dsimp only [quotientSection]
  rw [← Category.assoc, hlift, Category.assoc]
  simp [quotientMap]

/-- Consequently the class is a quotient of the literal cokernel of
the annihilating ideal inclusion. -/
def quotientFromCokernel {I : C} (k : I ⟶ O) (u : I ⟶ Q)
    (h : k ≫ a = u ≫ j) : cokernel k ⟶ quotient j a :=
  cokernel.desc k (quotientSection j a) (relation_quotientSection_zero j a k u h)

@[reassoc (attr := simp)] theorem cokernel_quotientFromCokernel {I : C}
    (k : I ⟶ O) (u : I ⟶ Q) (h : k ≫ a = u ≫ j) :
    cokernel.π k ≫ quotientFromCokernel j a k u h = quotientSection j a :=
  cokernel.π_desc _ _ _

instance quotientFromCokernel_epi {I : C} (k : I ⟶ O) (u : I ⟶ Q)
    (h : k ≫ a = u ≫ j) : Epi (quotientFromCokernel j a k u h) :=
  epi_of_epi_fac (cokernel_quotientFromCokernel j a k u h)

end Abelian

end M9Native.MukaiGeneratedImage

