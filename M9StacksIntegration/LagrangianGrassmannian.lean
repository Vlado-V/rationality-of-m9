namespace M9Native.LagrangianGrassmannian
section UniversalProperty

variable (K : Type u) [Field K]

open AlgebraicGeometry.Grassmannian

/-- Equality in the actual quotient functor gives an isomorphism of the
quotient bundles commuting with the quotient maps, not merely a K-theory equality. -/
theorem presentation_isomorphic_of_class_eq {T : Scheme.{u}} {k n : ℕ}
    {q q' : QuotientPresentation T k n} (h : (⟦q⟧ : Points T k n)=⟦q'⟧) :
    q.Isomorphic q' := by
  exact quotientPresentation_isomorphic_of_eq h

/-- The actual native moduli equivalence is natural for pullback of presentations. -/
theorem pointsEquiv_map {S T : Scheme.{u}} (f : T ⟶ S) (k n : ℕ)
    (y : (AlgebraicGeometry.Grassmannian.functor k n).obj (op S)) :
    (functorData k n).objEquiv T ((AlgebraicGeometry.Grassmannian.functor k n).map f.op y)=
      pullbackPointsMap f k n ((functorData k n).objEquiv S y) := by
  obtain ⟨q,hq⟩ := Quotient.exists_rep ((functorData k n).objEquiv S y)
  have hy : y=((functorData k n).objEquiv S).symm ⟦q⟧ := by
    rw [hq,Equiv.symm_apply_apply]
  rw [hy,Equiv.apply_symm_apply]
  exact points_map_of_isPullback f q (pullbackPresentation f q)
    (pullbackPresentation_isPullback f q)

/-- The chosen representative of the identity class is an actual universal
quotient: its pullback has exactly the class represented by the given morphism. -/
theorem pullbackIntegralUniversal_class {T : Scheme.{u}}
    (f : T ⟶ AlgebraicGeometry.Grassmannian.scheme.{u} 3 6) :
    (⟦pullbackPresentation f integralUniversalQuotient⟧ : Points T 3 6)=
      (functorData 3 6).objEquiv T ((schemeRepresentableBy 3 6).homEquiv f) := by
  change pullbackPointsMap f 3 6 (⟦integralUniversalQuotient⟧ : Points _ 3 6)=_
  rw [show (⟦integralUniversalQuotient⟧ : Points _ 3 6)=integralUniversalClass from
    Quotient.out_eq _]
  rw [integralUniversalClass,← pointsEquiv_map]
  congr 1
  simpa only [Category.comp_id] using ((schemeRepresentableBy 3 6).homEquiv_comp f (𝟙 _)).symm

/-- The universal quotient pulls back to any actual quotient representing
that point, with a genuine commuting target isomorphism. -/
theorem pullbackIntegralUniversal_isomorphic {T : Scheme.{u}}
    (f : T ⟶ AlgebraicGeometry.Grassmannian.scheme.{u} 3 6)
    (q : QuotientPresentation T 3 6)
    (hq : (functorData 3 6).objEquiv T ((schemeRepresentableBy 3 6).homEquiv f)=⟦q⟧) :
    (pullbackPresentation f integralUniversalQuotient).Isomorphic q :=
  presentation_isomorphic_of_class_eq ((pullbackIntegralUniversal_class f).trans hq)


/-- The field-base-changed representative remains universal as an actual
quotient presentation. -/
theorem pullbackUniversal_class {T : Scheme.{u}} (f : T ⟶ grassmannian K) :
    (⟦pullbackPresentation f (universalQuotient K)⟧ : Points T 3 6)=
      (functorData 3 6).objEquiv T ((schemeRepresentableBy 3 6).homEquiv
        (f ≫ pullback.snd _ _)) := by
  change pullbackPointsMap f 3 6 (pullbackPointsMap (pullback.snd _ _) 3 6
    (⟦integralUniversalQuotient⟧ : Points _ 3 6))=_
  exact (congrFun (pullbackPointsMap_comp (pullback.snd _ _) f 3 6)
    (⟦integralUniversalQuotient⟧ : Points _ 3 6)).symm.trans
      (pullbackIntegralUniversal_class _)

/-- A genuine commuting target isomorphism with any presentation of the
same base-changed Grassmannian point. -/
theorem pullbackUniversal_isomorphic {T : Scheme.{u}} (f : T ⟶ grassmannian K)
    (q : QuotientPresentation T 3 6)
    (hq : (functorData 3 6).objEquiv T ((schemeRepresentableBy 3 6).homEquiv
      (f ≫ pullback.snd _ _))=⟦q⟧) :
    (pullbackPresentation f (universalQuotient K)).Isomorphic q :=
  presentation_isomorphic_of_class_eq ((pullbackUniversal_class K f).trans hq)

end UniversalProperty
end M9Native.LagrangianGrassmannian

