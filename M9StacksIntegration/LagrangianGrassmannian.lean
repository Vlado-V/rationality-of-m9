/-! The Lagrangian Grassmannian is constructed as the actual zero scheme of
the image of the standard symplectic bivector in the second exterior power
of the native rank-three universal quotient on `Gr(3,6)`.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 4000000
set_option maxRecDepth 4096

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace M9Native.LagrangianGrassmannian

section Bivector

variable (X : Scheme.{u})

abbrev freeModule (n : ℕ) : X.Modules :=
  SheafOfModules.free (R := X.ringCatSheaf) (ULift.{u} (Fin n))

/-- The actual functorial exterior-power map, constructed by the exterior
algebra universal property. This is the same native construction as
`ExteriorPowerFunctorial`, replayed here without its dependency wrapper. -/
def exteriorPowerMap {E F : X.Modules} (f : E ⟶ F) (n : ℤ) :
    Scheme.Modules.exteriorPower E n ⟶ Scheme.Modules.exteriorPower F n :=
  ((Scheme.Modules.isExteriorAlgebra_exteriorAlgebra E).desc (Scheme.Modules.exteriorAlgebra F)
    (f ≫ Scheme.Modules.exteriorGenerator F)
    ((Scheme.Modules.isExteriorAlgebra_exteriorAlgebra F).1.comp f)).app n

theorem exteriorPowerMap_eq_native {E F : X.Modules} (f : E ⟶ F) (n : ℤ) :
    exteriorPowerMap X f n=Scheme.Modules.exteriorPowerMap f n := rfl

/-- The native closed zero scheme of a global bundle section: on each affine
open its ideal is generated by evaluations against all linear functionals.
This is the literal `zeroSchemeOfSection` construction, with no representability input. -/
def sectionZeroIdeal (E : X.Modules) (s : Γ(E, ⊤)) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals (fun U =>
    Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(E, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
      a=φ (E.presheaf.map (homOfLE le_top).op s)})

/-- The literal standard global section of the free rank-six sheaf. -/
def freeVector (i : Fin 6) : Γ(freeModule X 6, ⊤) :=
  (SheafOfModules.ιFree (R := X.ringCatSheaf) (ULift.up.{u} i)).val.app (op ⊤) (1 : Γ(X, ⊤))

/-- The wedge of two actual global sections in the chosen sheaf exterior algebra. -/
def wedgeSection (E : X.Modules) (s t : Γ(E, ⊤)) :
    Γ(Scheme.Modules.exteriorPower E 2, ⊤) :=
  (Scheme.Modules.exteriorAlgebra E).toPresheafGradedAlgebra.homogeneousProd (op ⊤) 2
    ![(Scheme.Modules.exteriorGenerator E).app ⊤ s,
      (Scheme.Modules.exteriorGenerator E).app ⊤ t]

/-- The genuine bivector `σ=e₁∧f₁+e₂∧f₂+e₃∧f₃` in the free sheaf. -/
def sigmaSection : Γ(Scheme.Modules.exteriorPower (freeModule X 6) 2, ⊤) :=
  ∑ i : Fin 3, wedgeSection X (freeModule X 6)
    (freeVector X (i.castAdd 3)) (freeVector X (Fin.natAdd 3 i))

/-- A sheaf quotient annihilates the actual fixed bivector precisely when its
induced second exterior-power map kills that section. -/
def AnnihilatesSigma {E : X.Modules} (q : freeModule X 6 ⟶ E) : Prop :=
  (exteriorPowerMap X q 2).app ⊤ (sigmaSection X)=0

end Bivector

section NativeScheme

variable (K : Type u) [Field K]

abbrev base : Scheme.{u} := Spec (.of K)
abbrev grassmannian : Scheme.{u} := AlgebraicGeometry.Grassmannian.schemeOver 3 6 (base K)
abbrev grassmannianProjection : grassmannian K ⟶ base K := pullback.fst _ _

/-- The actual universal isomorphism class comes from the pinned native
representability equivalence applied to the identity morphism. -/
def integralUniversalClass : AlgebraicGeometry.Grassmannian.Points
    (AlgebraicGeometry.Grassmannian.scheme.{u} 3 6) 3 6 :=
  (AlgebraicGeometry.Grassmannian.functorData 3 6).objEquiv _
    ((AlgebraicGeometry.Grassmannian.schemeRepresentableBy 3 6).homEquiv (𝟙 _))

def integralUniversalQuotient : AlgebraicGeometry.Grassmannian.QuotientPresentation
    (AlgebraicGeometry.Grassmannian.scheme.{u} 3 6) 3 6 :=
  Quotient.out (integralUniversalClass.{u})

/-- The native universal rank-three quotient, chosen from its actual
representability class and pulled back to the given field. -/
def universalQuotient : AlgebraicGeometry.Grassmannian.QuotientPresentation (grassmannian K) 3 6 :=
  AlgebraicGeometry.Grassmannian.pullbackPresentation (pullback.snd _ _) integralUniversalQuotient

abbrev quotientBundle : (grassmannian K).Modules := (universalQuotient K).target

instance quotientBundle_rank :
    SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} (quotientBundle K) 3 := by
  simpa using (universalQuotient K).finiteLocallyFree

abbrev equationBundle : (grassmannian K).Modules :=
  Scheme.Modules.exteriorPower (quotientBundle K) 2

instance equationBundle_rank :
    SheafOfModules.IsFiniteLocallyFreeOfRank.{u,u,u} (equationBundle K) 3 := by
  simpa using Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower (quotientBundle K) 3 2

/-- The section obtained by sending the fixed genuine bivector through the
second exterior power of the actual universal quotient. -/
def equationSection : Γ(equationBundle K, ⊤) :=
  (exteriorPowerMap (grassmannian K) (universalQuotient K).map 2).app ⊤
    (sigmaSection (grassmannian K))

def ideal : (grassmannian K).IdealSheafData :=
  sectionZeroIdeal (grassmannian K) (equationBundle K) (equationSection K)

/-- The actual Lagrangian Grassmannian scheme. -/
abbrev space : Scheme.{u} := (ideal K).subscheme

abbrev inclusion : space K ⟶ grassmannian K := (ideal K).subschemeι
abbrev projection : space K ⟶ base K := inclusion K ≫ grassmannianProjection K

instance inclusion_isClosedImmersion : IsClosedImmersion (inclusion K) := inferInstance

instance space_over : (space K).CanonicallyOver (base K) where
  hom := projection K

end NativeScheme

end M9Native.LagrangianGrassmannian

/-! The following field-algebra bridge replays the frozen actual exterior
model in the stable toolchain; provenance is recorded in audits/lagrangian/algebra-replay.json. -/

namespace M9Native.LagrangianField

/-- The actual space of symmetric ternary matrices. -/
def Symmetric3 (K : Type*) [Field K] : Submodule K (Matrix (Fin 3) (Fin 3) K) where
  carrier := {M | M.transpose = M}
  zero_mem' := rfl
  add_mem' := by
    intro X Y hX hY
    change X.transpose = X at hX
    change Y.transpose = Y at hY
    change (X + Y).transpose = X + Y
    rw [Matrix.transpose_add, hX, hY]
  smul_mem' := by
    intro c X hX
    change X.transpose = X at hX
    change (c • X).transpose = c • X
    rw [Matrix.transpose_smul, hX]

abbrev Upper3 := {ij : Fin 3 × Fin 3 // ij.1 ≤ ij.2}

@[simp] theorem card_upper3 : Fintype.card Upper3 = 6 := by decide

/-- Reconstruct a symmetric matrix from its six upper-triangular entries. -/
def upperMatrix {K : Type*} (v : Upper3 → K) : Matrix (Fin 3) (Fin 3) K :=
  fun i j => if hij : i ≤ j then v ⟨(i,j),hij⟩ else v ⟨(j,i), le_of_not_ge hij⟩

theorem upperMatrix_transpose {K : Type*} (v : Upper3 → K) :
    (upperMatrix v).transpose = upperMatrix v := by
  funext i j
  change upperMatrix v j i = upperMatrix v i j
  by_cases hij : i ≤ j
  · by_cases hji : j ≤ i
    · have heq := le_antisymm hij hji
      subst j
      rfl
    · simp only [upperMatrix, dite_eq_right hji, dite_eq_left hij]
  · have hji : j ≤ i := le_of_not_ge hij
    simp only [upperMatrix, dite_eq_left hji, dite_eq_right hij]

/-- The six-entry coordinate equivalence, preserving the actual matrix carrier. -/
def symmetric3Coordinates (K : Type*) [Field K] : Symmetric3 K ≃ₗ[K] (Upper3 → K) where
  toFun X ij := X.val ij.val.1 ij.val.2
  invFun v := ⟨upperMatrix v, upperMatrix_transpose v⟩
  left_inv X := by
    apply Subtype.ext
    funext i j
    change upperMatrix (fun ij : Upper3 => X.val ij.val.1 ij.val.2) i j = X.val i j
    by_cases hij : i ≤ j
    · simp only [upperMatrix, dite_eq_left hij]
    · simp only [upperMatrix, dite_eq_right hij]
      exact congrFun (congrFun X.property i) j
  right_inv v := by
    funext ij
    exact dite_eq_left ij.property
  map_add' X Y := rfl
  map_smul' c X := rfl

@[simp] theorem finrank_symmetric3 (K : Type*) [Field K] :
    Module.finrank K (Symmetric3 K) = 6 := by
  rw [(symmetric3Coordinates K).finrank_eq, Module.finrank_pi]
  simp


abbrev Coordinates (K : Type*) [Field K] := K × (Symmetric3 K × (Symmetric3 K × K))

@[simp] theorem finrank_coordinates (K : Type*) [Field K] : Module.finrank K (Coordinates K)=14 := by
  simp [Coordinates,Module.finrank_prod]


open Module Matrix exteriorPower
open scoped BigOperators

variable (K : Type*) [Field K]

abbrev V := Fin 6 → K
abbrev Third := ⋀[K]^3 (V K)

def eIndex (i : Fin 3) : Fin 6 := i.castAdd 3
def fIndex (i : Fin 3) : Fin 6 := Fin.natAdd 3 i

def basisVector (i : Fin 6) : V K := Pi.single i 1
def e (i : Fin 3) : V K := basisVector K (eIndex i)
def f (i : Fin 3) : V K := basisVector K (fIndex i)

/-- The paper's sign convention, `ω(e_i,f_j)=δ_ij`. -/
def omegaValue (u v : V K) : K :=
  ∑ i : Fin 3, (u (eIndex i) * v (fIndex i) - u (fIndex i) * v (eIndex i))

def omega : LinearMap.BilinForm K (V K) :=
  LinearMap.mk₂ K (omegaValue K)
    (by intro u v w; simp [omegaValue, Fin.sum_univ_succ]; ring)
    (by intro c u v; simp [omegaValue, Fin.sum_univ_succ]; ring)
    (by intro u v w; simp [omegaValue, Fin.sum_univ_succ]; ring)
    (by intro c u v; simp [omegaValue, Fin.sum_univ_succ]; ring)

@[simp] theorem omega_apply (u v : V K) : omega K u v = omegaValue K u v := rfl

@[simp] theorem omegaValue_self (u : V K) : omegaValue K u u = 0 := by
  simp [omegaValue, mul_comm]

@[simp] theorem omega_self (u : V K) : omega K u u = 0 := by
  exact omegaValue_self K u

theorem omega_swap (u v : V K) : omega K u v = -omega K v u := by
  simp only [omega_apply, omegaValue, Fin.sum_univ_succ]
  ring

def tripleContract (u v w : V K) : V K :=
  omega K u v • w - omega K u w • v + omega K v w • u

/-- The actual contraction formula before descent to the exterior power. -/
def contractionFormula (v : Fin 3 → V K) : V K := tripleContract K (v 0) (v 1) (v 2)

theorem tripleContract_add_left (x y v w : V K) :
    tripleContract K (x+y) v w = tripleContract K x v w + tripleContract K y v w := by
  funext k
  simp [tripleContract, omegaValue, Fin.sum_univ_succ, smul_eq_mul]
  ring

theorem tripleContract_add_middle (u x y w : V K) :
    tripleContract K u (x+y) w = tripleContract K u x w + tripleContract K u y w := by
  funext k
  simp [tripleContract, omegaValue, Fin.sum_univ_succ, smul_eq_mul]
  ring

theorem tripleContract_add_right (u v x y : V K) :
    tripleContract K u v (x+y) = tripleContract K u v x + tripleContract K u v y := by
  funext k
  simp [tripleContract, omegaValue, Fin.sum_univ_succ, smul_eq_mul]
  ring

theorem tripleContract_smul_left (c : K) (u v w : V K) :
    tripleContract K (c • u) v w = c • tripleContract K u v w := by
  funext k
  simp [tripleContract, omegaValue, Fin.sum_univ_succ, smul_eq_mul]
  ring

theorem tripleContract_smul_middle (c : K) (u v w : V K) :
    tripleContract K u (c • v) w = c • tripleContract K u v w := by
  funext k
  simp [tripleContract, omegaValue, Fin.sum_univ_succ, smul_eq_mul]
  ring

theorem tripleContract_smul_right (c : K) (u v w : V K) :
    tripleContract K u v (c • w) = c • tripleContract K u v w := by
  funext k
  simp [tripleContract, omegaValue, Fin.sum_univ_succ, smul_eq_mul]
  ring

def contractionAlternating : (V K) [⋀^Fin 3]→ₗ[K] V K where
  toMultilinearMap := MultilinearMap.mk' (contractionFormula K)
    (by
      intro v i x y
      fin_cases i
      · change tripleContract K (x+y) (v 1) (v 2) = tripleContract K x (v 1) (v 2) + tripleContract K y (v 1) (v 2)
        exact tripleContract_add_left K x y _ _
      · change tripleContract K (v 0) (x+y) (v 2) = tripleContract K (v 0) x (v 2) + tripleContract K (v 0) y (v 2)
        exact tripleContract_add_middle K _ x y _
      · change tripleContract K (v 0) (v 1) (x+y) = tripleContract K (v 0) (v 1) x + tripleContract K (v 0) (v 1) y
        exact tripleContract_add_right K _ _ x y)
    (by
      intro v i c x
      fin_cases i
      · change tripleContract K (c • x) (v 1) (v 2) = c • tripleContract K x (v 1) (v 2)
        exact tripleContract_smul_left K c x _ _
      · change tripleContract K (v 0) (c • x) (v 2) = c • tripleContract K (v 0) x (v 2)
        exact tripleContract_smul_middle K c _ x _
      · change tripleContract K (v 0) (v 1) (c • x) = c • tripleContract K (v 0) (v 1) x
        exact tripleContract_smul_right K c _ _ x)
  map_eq_zero_of_eq' v i j hij hne := by
    change contractionFormula K v = 0
    have hv : v 0 = v 1 ∨ v 0 = v 2 ∨ v 1 = v 2 := by
      fin_cases i <;> fin_cases j <;> simp_all
    rcases hv with hv | hv | hv
    · simp [contractionFormula, tripleContract, hv]
    · funext k
      simp only [contractionFormula, tripleContract, hv, omega_self, Pi.add_apply, Pi.smul_apply,
        zero_smul, sub_zero, smul_eq_mul, Pi.zero_apply]
      rw [omega_swap K (v 2) (v 1)]
      ring
    · simp [contractionFormula, tripleContract, hv]

/-- Contraction on Mathlib's actual third exterior power. -/
def contraction : Third K →ₗ[K] V K :=
  exteriorPower.alternatingMapLinearEquiv (contractionAlternating K)

@[simp] theorem contraction_ιMulti (v : Fin 3 → V K) :
    contraction K (exteriorPower.ιMulti K 3 v) = contractionFormula K v :=
  exteriorPower.alternatingMapLinearEquiv_apply_ιMulti _ _

def wedge3 (u v w : V K) : Third K := exteriorPower.ιMulti K 3 ![u,v,w]

@[simp] theorem contraction_wedge3 (u v w : V K) :
    contraction K (wedge3 K u v w) = omega K u v • w - omega K u w • v + omega K v w • u := by
  simp [wedge3, contractionFormula, tripleContract]

/-- The actual primitive submodule, rather than a coordinate surrogate. -/
def Primitive : Submodule K (Third K) := LinearMap.ker (contraction K)

@[simp] theorem finrank_third : finrank K (Third K) = 20 := by
  rw [Third, exteriorPower.finrank_eq]
  norm_num [V, Module.finrank_pi, Nat.choose]

@[simp] theorem omega_e_e (i j : Fin 3) : omega K (e K i) (e K j) = 0 := by
  change omegaValue K (e K i) (e K j) = 0
  fin_cases i <;> fin_cases j <;>
    simp only [omegaValue, Fin.sum_univ_succ, e, basisVector, eIndex, fIndex] <;>
    norm_num [Pi.single_apply]

@[simp] theorem omega_f_f (i j : Fin 3) : omega K (f K i) (f K j) = 0 := by
  change omegaValue K (f K i) (f K j) = 0
  fin_cases i <;> fin_cases j <;>
    simp only [omegaValue, Fin.sum_univ_succ, f, basisVector, eIndex, fIndex] <;>
    norm_num [Pi.single_apply]

@[simp] theorem omega_e_f (i j : Fin 3) : omega K (e K i) (f K j) = if i=j then 1 else 0 := by
  change omegaValue K (e K i) (f K j) = if i=j then 1 else 0
  fin_cases i <;> fin_cases j <;>
    simp only [omegaValue, Fin.sum_univ_succ, e, f, basisVector, eIndex, fIndex] <;>
    norm_num [Pi.single_apply]

@[simp] theorem omega_f_e (i j : Fin 3) : omega K (f K i) (e K j) = if i=j then -1 else 0 := by
  rw [omega_swap, omega_e_f]
  split_ifs <;> simp_all

/-- Six actual decomposable preimages prove that contraction is onto. -/
def contractionSectionBasis : Fin 6 → Third K :=
  ![wedge3 K (e K 0) (e K 1) (f K 1), wedge3 K (e K 1) (e K 2) (f K 2),
    wedge3 K (e K 2) (e K 0) (f K 0), wedge3 K (e K 1) (f K 1) (f K 0),
    wedge3 K (e K 2) (f K 2) (f K 1), wedge3 K (e K 0) (f K 0) (f K 2)]

@[simp] theorem contractionSectionBasis_apply (i : Fin 6) :
    contraction K (contractionSectionBasis K i) = basisVector K i := by
  fin_cases i <;> simp [contractionSectionBasis, e, f, eIndex, fIndex, basisVector,
    omegaValue, Fin.sum_univ_succ]

theorem contraction_surjective : Function.Surjective (contraction K) := by
  apply LinearMap.range_eq_top.mp
  apply top_unique
  rw [← (Pi.basisFun K (Fin 6)).span_eq]
  apply Submodule.span_le.mpr
  rintro _ ⟨i, rfl⟩
  refine ⟨contractionSectionBasis K i, ?_⟩
  simpa only [basisVector, Pi.basisFun_apply] using contractionSectionBasis_apply K i

@[simp] theorem finrank_primitive : finrank K (Primitive K) = 14 := by
  have h := (contraction K).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr (contraction_surjective K), finrank_top, finrank_third] at h
  have hV : finrank K (V K) = 6 := by simp [V]
  rw [hV] at h
  change finrank K (LinearMap.ker (contraction K)) = 14
  omega

def nextOne : Fin 3 → Fin 3 := ![1,2,0]
def nextTwo : Fin 3 → Fin 3 := ![2,0,1]

def a : Third K := wedge3 K (e K 0) (e K 1) (e K 2)
def b : Third K := wedge3 K (f K 0) (f K 1) (f K 2)

/-- The paper's `q_ij=e_i∧ι_phi_j(b)`, using the cyclic cofactor orientation. -/
def q (i j : Fin 3) : Third K := wedge3 K (e K i) (f K (nextOne j)) (f K (nextTwo j))

/-- The paper's `p_ij=f_i∧ι_epsilon_j(a)`, with the same orientation. -/
def p (i j : Fin 3) : Third K := wedge3 K (f K i) (e K (nextOne j)) (e K (nextTwo j))

/-- A genuine exterior-coordinate functional, obtained by exterior duality. -/
def coordinate (i j k : Fin 6) : Third K →ₗ[K] K :=
  exteriorPower.pairingDual K (V K) 3
    (exteriorPower.ιMulti K 3 ![LinearMap.proj i, LinearMap.proj j, LinearMap.proj k])

@[simp] theorem coordinate_wedge3 (i j k : Fin 6) (u v w : V K) :
    coordinate K i j k (wedge3 K u v w) =
      u i * v j * w k + u j * v k * w i + u k * v i * w j -
        u i * v k * w j - u j * v i * w k - u k * v j * w i := by
  simp [coordinate, wedge3, Matrix.det_fin_three]
  ring

def aCoordinate : Third K →ₗ[K] K := coordinate K 0 1 2
def bCoordinate : Third K →ₗ[K] K := coordinate K 3 4 5
def qCoordinate (i j : Fin 3) : Third K →ₗ[K] K :=
  coordinate K (eIndex i) (fIndex (nextOne j)) (fIndex (nextTwo j))
def pCoordinate (i j : Fin 3) : Third K →ₗ[K] K :=
  coordinate K (fIndex i) (eIndex (nextOne j)) (eIndex (nextTwo j))

@[simp] theorem qCoordinate_q (i j k l : Fin 3) :
    qCoordinate K i j (q K k l) = if i=k then if j=l then 1 else 0 else 0 := by
  fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    norm_num [qCoordinate, q, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]

@[simp] theorem qCoordinate_p (i j k l : Fin 3) : qCoordinate K i j (p K k l) = 0 := by
  fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    norm_num [qCoordinate, p, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]

@[simp] theorem pCoordinate_p (i j k l : Fin 3) :
    pCoordinate K i j (p K k l) = if i=k then if j=l then 1 else 0 else 0 := by
  fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    norm_num [pCoordinate, p, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]

@[simp] theorem pCoordinate_q (i j k l : Fin 3) : pCoordinate K i j (q K k l) = 0 := by
  fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    norm_num [pCoordinate, q, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]


@[simp] theorem aCoordinate_a : aCoordinate K (a K) = 1 := by
  norm_num [aCoordinate, a, e, eIndex, basisVector]
@[simp] theorem aCoordinate_b : aCoordinate K (b K) = 0 := by
  norm_num [aCoordinate, b, f, fIndex, basisVector]
@[simp] theorem bCoordinate_a : bCoordinate K (a K) = 0 := by
  norm_num [bCoordinate, a, e, eIndex, basisVector]
@[simp] theorem bCoordinate_b : bCoordinate K (b K) = 1 := by
  norm_num [bCoordinate, b, f, fIndex, basisVector]

@[simp] theorem aCoordinate_q (i j : Fin 3) : aCoordinate K (q K i j) = 0 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [aCoordinate, q, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]
@[simp] theorem aCoordinate_p (i j : Fin 3) : aCoordinate K (p K i j) = 0 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [aCoordinate, p, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]
@[simp] theorem bCoordinate_q (i j : Fin 3) : bCoordinate K (q K i j) = 0 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [bCoordinate, q, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]
@[simp] theorem bCoordinate_p (i j : Fin 3) : bCoordinate K (p K i j) = 0 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [bCoordinate, p, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]
@[simp] theorem qCoordinate_a (i j : Fin 3) : qCoordinate K i j (a K) = 0 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [qCoordinate, a, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]
@[simp] theorem qCoordinate_b (i j : Fin 3) : qCoordinate K i j (b K) = 0 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [qCoordinate, b, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]
@[simp] theorem pCoordinate_a (i j : Fin 3) : pCoordinate K i j (a K) = 0 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [pCoordinate, a, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]
@[simp] theorem pCoordinate_b (i j : Fin 3) : pCoordinate K i j (b K) = 0 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [pCoordinate, b, e, f, nextOne, nextTwo, eIndex, fIndex, basisVector]

/-- Sum of the actual mixed wedges with their full matrix coefficients. -/
def mixedQ : Matrix (Fin 3) (Fin 3) K →ₗ[K] Third K where
  toFun X := ∑ i, ∑ j, X i j • q K i j
  map_add' X Y := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' c X := by simp [Finset.smul_sum, smul_smul]

def mixedP : Matrix (Fin 3) (Fin 3) K →ₗ[K] Third K where
  toFun X := ∑ i, ∑ j, X i j • p K i j
  map_add' X Y := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' c X := by simp [Finset.smul_sum, smul_smul]

/-- The manuscript's literal expansion in the actual exterior power. -/
def coordinateEmbedding : Coordinates K →ₗ[K] Third K where
  toFun r := r.1 • a K + mixedQ K r.2.1.val + mixedP K r.2.2.1.val + r.2.2.2 • b K
  map_add' r s := by
    simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, map_add, add_smul]
    module
  map_smul' c r := by
    change (c * r.1) • a K + mixedQ K (c • r.2.1.val) +
      mixedP K (c • r.2.2.1.val) + (c * r.2.2.2) • b K =
      c • (r.1 • a K + mixedQ K r.2.1.val + mixedP K r.2.2.1.val + r.2.2.2 • b K)
    simp [smul_add, smul_smul]

@[simp] theorem aCoordinate_embedding (r : Coordinates K) :
    aCoordinate K (coordinateEmbedding K r) = r.1 := by
  simp [coordinateEmbedding, mixedQ, mixedP]
@[simp] theorem bCoordinate_embedding (r : Coordinates K) :
    bCoordinate K (coordinateEmbedding K r) = r.2.2.2 := by
  simp [coordinateEmbedding, mixedQ, mixedP]
@[simp] theorem qCoordinate_embedding (r : Coordinates K) (i j : Fin 3) :
    qCoordinate K i j (coordinateEmbedding K r) = r.2.1.val i j := by
  classical
  simp [coordinateEmbedding, mixedQ, mixedP, smul_eq_mul, mul_ite]
@[simp] theorem pCoordinate_embedding (r : Coordinates K) (i j : Fin 3) :
    pCoordinate K i j (coordinateEmbedding K r) = r.2.2.1.val i j := by
  classical
  simp [coordinateEmbedding, mixedQ, mixedP, smul_eq_mul, mul_ite]

/-- Extract upper-triangular exterior coefficients and reconstruct a symmetric matrix. -/
def qExtraction : Third K →ₗ[K] Symmetric3 K :=
  (symmetric3Coordinates K).symm.toLinearMap.comp
    (LinearMap.pi fun ij : Upper3 => qCoordinate K ij.val.1 ij.val.2)
def pExtraction : Third K →ₗ[K] Symmetric3 K :=
  (symmetric3Coordinates K).symm.toLinearMap.comp
    (LinearMap.pi fun ij : Upper3 => pCoordinate K ij.val.1 ij.val.2)

/-- Explicit coordinate extraction on the entire actual third exterior power. -/
def coordinateProjection : Third K →ₗ[K] Coordinates K :=
  (aCoordinate K).prod ((qExtraction K).prod ((pExtraction K).prod (bCoordinate K)))

@[simp] theorem qExtraction_embedding (r : Coordinates K) :
    qExtraction K (coordinateEmbedding K r) = r.2.1 := by
  change (symmetric3Coordinates K).symm
    ((LinearMap.pi fun ij : Upper3 => qCoordinate K ij.val.1 ij.val.2)
      (coordinateEmbedding K r)) = r.2.1
  apply (symmetric3Coordinates K).injective
  rw [LinearEquiv.apply_symm_apply]
  funext ij
  exact qCoordinate_embedding K r ij.val.1 ij.val.2
@[simp] theorem pExtraction_embedding (r : Coordinates K) :
    pExtraction K (coordinateEmbedding K r) = r.2.2.1 := by
  change (symmetric3Coordinates K).symm
    ((LinearMap.pi fun ij : Upper3 => pCoordinate K ij.val.1 ij.val.2)
      (coordinateEmbedding K r)) = r.2.2.1
  apply (symmetric3Coordinates K).injective
  rw [LinearEquiv.apply_symm_apply]
  funext ij
  exact pCoordinate_embedding K r ij.val.1 ij.val.2

@[simp] theorem coordinateProjection_embedding (r : Coordinates K) :
    coordinateProjection K (coordinateEmbedding K r) = r := by
  change (aCoordinate K (coordinateEmbedding K r), qExtraction K (coordinateEmbedding K r),
    pExtraction K (coordinateEmbedding K r), bCoordinate K (coordinateEmbedding K r)) = r
  simp only [aCoordinate_embedding, bCoordinate_embedding, qExtraction_embedding, pExtraction_embedding]

theorem coordinateEmbedding_injective : Function.Injective (coordinateEmbedding K) :=
  Function.LeftInverse.injective (coordinateProjection_embedding K)

@[simp] theorem contraction_a : contraction K (a K) = 0 := by
  simp [a, -omega_apply]
@[simp] theorem contraction_b : contraction K (b K) = 0 := by
  simp [b, -omega_apply]

theorem contraction_q_swap (i j : Fin 3) :
    contraction K (q K j i) = -contraction K (q K i j) := by
  fin_cases i <;> fin_cases j <;> simp [q, nextOne, nextTwo, -omega_apply]
theorem contraction_p_swap (i j : Fin 3) :
    contraction K (p K j i) = -contraction K (p K i j) := by
  fin_cases i <;> fin_cases j <;> simp [p, nextOne, nextTwo, -omega_apply]

/-- Symmetric coefficients annihilate a skew family in characteristic zero. -/
theorem sum_symmetric_skew_zero [CharZero K] {M : Type*} [AddCommGroup M] [Module K M]
    (X : Symmetric3 K) (z : Fin 3 → Fin 3 → M) (hz : ∀ i j, z j i = -z i j) :
    (∑ i, ∑ j, X.val i j • z i j) = 0 := by
  have hX (i j : Fin 3) : X.val j i = X.val i j := congrFun (congrFun X.property i) j
  have hneg : (∑ i, ∑ j, X.val i j • z i j) = -(∑ i, ∑ j, X.val i j • z i j) := by
    calc
      _ = ∑ j, ∑ i, X.val i j • z i j := Finset.sum_comm
      _ = ∑ j, ∑ i, -(X.val j i • z j i) := by
        apply Finset.sum_congr rfl
        intro j _
        apply Finset.sum_congr rfl
        intro i _
        rw [hX i j, hz j i, smul_neg]
      _ = _ := by simp
  have htwo : (2 : K) • (∑ i, ∑ j, X.val i j • z i j) = 0 := by
    rw [two_smul]
    nth_rw 1 [hneg]
    exact neg_add_cancel _
  exact (smul_eq_zero.mp htwo).resolve_left two_ne_zero

@[simp] theorem contraction_mixedQ [CharZero K] (X : Symmetric3 K) :
    contraction K (mixedQ K X.val) = 0 := by
  simp only [mixedQ, LinearMap.coe_mk, AddHom.coe_mk, map_sum, map_smul]
  exact sum_symmetric_skew_zero K X _ (contraction_q_swap K)
@[simp] theorem contraction_mixedP [CharZero K] (X : Symmetric3 K) :
    contraction K (mixedP K X.val) = 0 := by
  simp only [mixedP, LinearMap.coe_mk, AddHom.coe_mk, map_sum, map_smul]
  exact sum_symmetric_skew_zero K X _ (contraction_p_swap K)

@[simp] theorem contraction_embedding [CharZero K] (r : Coordinates K) :
    contraction K (coordinateEmbedding K r) = 0 := by
  simp [coordinateEmbedding]

/-- The coordinate expansion takes values in the actual kernel of contraction. -/
def embeddingIntoPrimitive [CharZero K] : Coordinates K →ₗ[K] Primitive K :=
  (coordinateEmbedding K).codRestrict (Primitive K) (by
    intro r
    exact contraction_embedding K r)

theorem embeddingIntoPrimitive_bijective [CharZero K] :
    Function.Bijective (embeddingIntoPrimitive K) := by
  have hinj : Function.Injective (embeddingIntoPrimitive K) := by
    intro r s h
    apply coordinateEmbedding_injective K
    exact congrArg Subtype.val h
  refine ⟨hinj, ?_⟩
  have hdim : finrank K (Coordinates K) = finrank K (Primitive K) := by
    rw [finrank_coordinates, finrank_primitive]
  exact LinearMap.range_eq_top.mp
    (Submodule.eq_top_of_finrank_eq (K := K) (V := Primitive K)
      (S := (embeddingIntoPrimitive K).range)
      ((LinearMap.finrank_range_of_inj (f := embeddingIntoPrimitive K) hinj).trans hdim))

/-- The explicit fourteen-coordinate model is the actual primitive exterior subspace. -/
def primitiveEquiv [CharZero K] : Coordinates K ≃ₗ[K] Primitive K :=
  LinearEquiv.ofBijective (embeddingIntoPrimitive K) (embeddingIntoPrimitive_bijective K)

@[simp] theorem primitiveEquiv_val [CharZero K] (r : Coordinates K) :
    (primitiveEquiv K r).val = coordinateEmbedding K r := rfl

@[simp] theorem primitiveEquiv_symm [CharZero K] (w : Primitive K) :
    (primitiveEquiv K).symm w = coordinateProjection K w.val := by
  obtain ⟨r, rfl⟩ := (primitiveEquiv K).surjective w
  simp



def sigma : ⋀[K]^2 (V K) :=
  ∑ i : Fin 3, exteriorPower.ιMulti K 2 ![e K i,f K i]

def quotientSigma (M : Matrix (Fin 3) (Fin 6) K) : ⋀[K]^2 (Fin 3 → K) :=
  exteriorPower.map 2 (Matrix.mulVecLin M) (sigma K)

def coordinate2 (i j : Fin 3) : (⋀[K]^2 (Fin 3 → K)) →ₗ[K] K :=
  exteriorPower.pairingDual K (Fin 3 → K) 2
    (exteriorPower.ιMulti K 2 ![LinearMap.proj i,LinearMap.proj j])

@[simp] theorem coordinate2_wedge (i j : Fin 3) (u v : Fin 3 → K) :
    coordinate2 K i j (exteriorPower.ιMulti K 2 ![u,v])=u i*v j-u j*v i := by
  simp [coordinate2,Matrix.det_fin_two]

theorem coordinate2_quotientSigma (M : Matrix (Fin 3) (Fin 6) K) (i j : Fin 3) :
    coordinate2 K i j (quotientSigma K M)=omega K (M i) (M j) := by
  simp only [quotientSigma,sigma,map_sum,omega_apply,omegaValue]
  apply Finset.sum_congr rfl
  intro k _
  rw [exteriorPower.map_apply_ιMulti]
  change coordinate2 K i j (exteriorPower.ιMulti K 2
    ![Matrix.mulVecLin M (e K k),Matrix.mulVecLin M (f K k)])=_
  rw [coordinate2_wedge]
  simp only [e,f,basisVector,Matrix.mulVecLin_apply,Matrix.mulVec_single_one,Matrix.col_apply]
  ring

theorem rows_isotropic_of_quotientSigma_zero (M : Matrix (Fin 3) (Fin 6) K)
    (hM : quotientSigma K M=0) (i j : Fin 3) : omega K (M i) (M j)=0 := by
  rw [← coordinate2_quotientSigma K M i j,hM,map_zero]

/-- The quotient convention's actual row trivector. Its coefficients below
are precisely the native maximal minors; no kernel/row identification is implicit. -/
def rowPlucker (M : Matrix (Fin 3) (Fin 6) K) : Third K := wedge3 K (M 0) (M 1) (M 2)

theorem rowPlucker_primitive (M : Matrix (Fin 3) (Fin 6) K) (hM : quotientSigma K M=0) :
    rowPlucker K M ∈ Primitive K := by
  change contraction K (wedge3 K (M 0) (M 1) (M 2))=0
  rw [contraction_wedge3]
  simp only [rows_isotropic_of_quotientSigma_zero K M hM,zero_smul,sub_zero,add_zero]

def coordinate3 (c : Fin 3 ↪ Fin 6) : Third K →ₗ[K] K :=
  exteriorPower.pairingDual K (V K) 3
    (exteriorPower.ιMulti K 3 (fun j => LinearMap.proj (c j)))

/-- Exact compatibility with every one of the 120 native Plucker minors. -/
theorem coordinate3_rowPlucker (M : Matrix (Fin 3) (Fin 6) K) (c : Fin 3 ↪ Fin 6) :
    coordinate3 K c (rowPlucker K M)=Matrix.det (M.submatrix id c) := by
  simp only [coordinate3,rowPlucker,wedge3,exteriorPower.pairingDual_ιMulti_ιMulti]
  congr 1
  ext i j
  fin_cases i <;> rfl

theorem rowPlucker_ne_zero_of_minor (M : Matrix (Fin 3) (Fin 6) K) (c : Fin 3 ↪ Fin 6)
    (hc : Matrix.det (M.submatrix id c) ≠ 0) : rowPlucker K M ≠ 0 := by
  intro hz
  have h := congrArg (coordinate3 K c) hz
  rw [coordinate3_rowPlucker,map_zero] at h
  exact hc h

/-- The exact fourteen-coordinate projection from the frozen exterior model
reconstructs the actual row Plucker vector of every isotropic quotient. -/
theorem coordinateEmbedding_rowProjection [CharZero K] (M : Matrix (Fin 3) (Fin 6) K)
    (hM : quotientSigma K M=0) :
    coordinateEmbedding K (coordinateProjection K (rowPlucker K M))=rowPlucker K M := by
  let w : Primitive K := ⟨rowPlucker K M,rowPlucker_primitive K M hM⟩
  have h := congrArg Subtype.val ((primitiveEquiv K).apply_symm_apply w)
  simpa only [primitiveEquiv_val,primitiveEquiv_symm] using h

def primitiveMinor (c : Fin 3 ↪ Fin 6) : Coordinates K →ₗ[K] K :=
  (coordinate3 K c).comp (coordinateEmbedding K)

/-- Each of the native 120 Plucker coordinates is the stated genuine linear
functional of the manuscript's fourteen primitive coordinates. -/
theorem nativeMinor_from_fourteen [CharZero K] (M : Matrix (Fin 3) (Fin 6) K)
    (hM : quotientSigma K M=0) (c : Fin 3 ↪ Fin 6) :
    primitiveMinor K c (coordinateProjection K (rowPlucker K M))=Matrix.det (M.submatrix id c) := by
  rw [primitiveMinor,LinearMap.comp_apply,coordinateEmbedding_rowProjection K M hM,
    coordinate3_rowPlucker]

theorem rowProjection_ne_zero_of_minor [CharZero K] (M : Matrix (Fin 3) (Fin 6) K)
    (hM : quotientSigma K M=0) (c : Fin 3 ↪ Fin 6) (hc : Matrix.det (M.submatrix id c) ≠ 0) :
    coordinateProjection K (rowPlucker K M) ≠ 0 := by
  intro hz
  apply rowPlucker_ne_zero_of_minor K M c hc
  rw [← coordinateEmbedding_rowProjection K M hM,hz,map_zero]

abbrev CoordinateIndex := Unit ⊕ (Upper3 ⊕ (Upper3 ⊕ Unit))

def coordinateBasis : Basis CoordinateIndex K (Coordinates K) :=
  (Basis.singleton Unit K).prod
    (((Pi.basisFun K Upper3).map (symmetric3Coordinates K).symm).prod
      (((Pi.basisFun K Upper3).map (symmetric3Coordinates K).symm).prod (Basis.singleton Unit K)))

def coordinateBasis14 : Basis (Fin 14) K (Coordinates K) :=
  (coordinateBasis K).reindex (Fintype.equivFinOfCardEq (by
    simp [CoordinateIndex]))

/-- A genuine coordinate equivalence for the actual primitive exterior kernel. -/
def primitiveCoordinates14 [CharZero K] : Primitive K ≃ₗ[K] (Fin 14 → K) :=
  (primitiveEquiv K).symm.trans (coordinateBasis14 K).equivFun

def rowFourteen (M : Matrix (Fin 3) (Fin 6) K) : Fin 14 → K :=
  (coordinateBasis14 K).equivFun (coordinateProjection K (rowPlucker K M))

def primitiveMinor14 (c : Fin 3 ↪ Fin 6) : (Fin 14 → K) →ₗ[K] K :=
  (primitiveMinor K c).comp (coordinateBasis14 K).equivFun.symm.toLinearMap

theorem nativeMinor_from_rowFourteen [CharZero K] (M : Matrix (Fin 3) (Fin 6) K)
    (hM : quotientSigma K M=0) (c : Fin 3 ↪ Fin 6) :
    primitiveMinor14 K c (rowFourteen K M)=Matrix.det (M.submatrix id c) := by
  change primitiveMinor K c ((coordinateBasis14 K).equivFun.symm
    ((coordinateBasis14 K).equivFun (coordinateProjection K (rowPlucker K M))))=_
  rw [LinearEquiv.symm_apply_apply]
  exact nativeMinor_from_fourteen K M hM c

theorem rowFourteen_ne_zero_of_minor [CharZero K] (M : Matrix (Fin 3) (Fin 6) K)
    (hM : quotientSigma K M=0) (c : Fin 3 ↪ Fin 6) (hc : Matrix.det (M.submatrix id c) ≠ 0) :
    rowFourteen K M ≠ 0 := by
  intro hz
  exact rowProjection_ne_zero_of_minor K M hM c hc
    ((coordinateBasis14 K).equivFun.injective (hz.trans (map_zero _).symm))

def bivectorCoordinates : (⋀[K]^2 (Fin 3 → K)) →ₗ[K] (Fin 3 → K) :=
  LinearMap.pi ![coordinate2 K 1 2,coordinate2 K 2 0,coordinate2 K 0 1]

def bivectorSection : (Fin 3 → K) →ₗ[K] ⋀[K]^2 (Fin 3 → K) :=
  (LinearMap.proj 0).smulRight (exteriorPower.ιMulti K 2 ![Pi.single 1 1,Pi.single 2 1])+
  (LinearMap.proj 1).smulRight (exteriorPower.ιMulti K 2 ![Pi.single 2 1,Pi.single 0 1])+
  (LinearMap.proj 2).smulRight (exteriorPower.ιMulti K 2 ![Pi.single 0 1,Pi.single 1 1])

theorem bivectorCoordinates_section (v : Fin 3 → K) :
    bivectorCoordinates K (bivectorSection K v)=v := by
  funext i
  fin_cases i <;>
    simp [bivectorCoordinates,bivectorSection,coordinate2_wedge]

theorem bivectorCoordinates_injective : Function.Injective (bivectorCoordinates K) := by
  apply (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (by
    rw [exteriorPower.finrank_eq]
    norm_num [Module.finrank_pi])).mpr
  intro v
  exact ⟨bivectorSection K v,bivectorCoordinates_section K v⟩

theorem quotientSigma_zero_iff_rows_isotropic (M : Matrix (Fin 3) (Fin 6) K) :
    quotientSigma K M=0 ↔ ∀ i j, omega K (M i) (M j)=0 := by
  constructor
  · exact rows_isotropic_of_quotientSigma_zero K M
  · intro h
    apply bivectorCoordinates_injective K
    funext i
    fin_cases i <;> simp [bivectorCoordinates,coordinate2_quotientSigma,h]

theorem coordinateEmbedding_projection_of_primitive [CharZero K] (w : Third K)
    (hw : contraction K w=0) : coordinateEmbedding K (coordinateProjection K w)=w := by
  let w' : Primitive K := ⟨w,hw⟩
  have h := congrArg Subtype.val ((primitiveEquiv K).apply_symm_apply w')
  simpa only [primitiveEquiv_val,primitiveEquiv_symm] using h

def contractionSection : V K →ₗ[K] Third K :=
  (Pi.basisFun K (Fin 6)).constr K (contractionSectionBasis K)

theorem contractionSection_rightInverse :
    (contraction K).comp (contractionSection K)=LinearMap.id := by
  apply (Pi.basisFun K (Fin 6)).ext
  intro i
  simp [contractionSection,contractionSectionBasis_apply,basisVector]

/-- The error of the fourteen-coordinate projection factors through the
actual symplectic contraction, giving a constant linear identity suitable
for base change to arbitrary coordinate rings. -/
def correction : V K →ₗ[K] Third K :=
  (LinearMap.id-(coordinateEmbedding K).comp (coordinateProjection K)).comp (contractionSection K)

theorem primitive_linear_decomposition [CharZero K] :
    (coordinateEmbedding K).comp (coordinateProjection K)+(correction K).comp (contraction K)=
      LinearMap.id := by
  apply LinearMap.ext
  intro w
  let t := contractionSection K (contraction K w)
  have ht : contraction K t=contraction K w :=
    LinearMap.congr_fun (contractionSection_rightInverse K) (contraction K w)
  have hk : contraction K (w-t)=0 := by rw [map_sub,ht,sub_self]
  have h := coordinateEmbedding_projection_of_primitive K (w-t) hk
  rw [map_sub,map_sub] at h
  change coordinateEmbedding K (coordinateProjection K w)+
    (t-coordinateEmbedding K (coordinateProjection K t))=w
  calc
    _ = (coordinateEmbedding K (coordinateProjection K w)-
      coordinateEmbedding K (coordinateProjection K t))+t := by abel
    _ = (w-t)+t := congrArg (fun z => z+t) h
    _ = w := sub_add_cancel _ _

def thirdBasis20 : Basis (Fin 20) K (Third K) :=
  ((Pi.basisFun K (Fin 6)).exteriorPower 3).reindex
    (Fintype.equivFinOfCardEq
      ((finrank_eq_card_basis ((Pi.basisFun K (Fin 6)).exteriorPower 3)).symm.trans (finrank_third K)))

def embeddingMatrix : Matrix (Fin 20) (Fin 14) K :=
  LinearMap.toMatrix (coordinateBasis14 K) (thirdBasis20 K) (coordinateEmbedding K)

def projectionMatrix : Matrix (Fin 14) (Fin 20) K :=
  LinearMap.toMatrix (thirdBasis20 K) (coordinateBasis14 K) (coordinateProjection K)

def contractionMatrix : Matrix (Fin 6) (Fin 20) K :=
  LinearMap.toMatrix (thirdBasis20 K) (Pi.basisFun K (Fin 6)) (contraction K)

def correctionMatrix : Matrix (Fin 20) (Fin 6) K :=
  LinearMap.toMatrix (Pi.basisFun K (Fin 6)) (thirdBasis20 K) (correction K)

theorem primitive_matrix_decomposition [CharZero K] :
    embeddingMatrix K*projectionMatrix K+correctionMatrix K*contractionMatrix K=1 := by
  simp only [embeddingMatrix,projectionMatrix,correctionMatrix,contractionMatrix,
    ← LinearMap.toMatrix_comp,← map_add,primitive_linear_decomposition,LinearMap.toMatrix_id]

theorem primitive_matrix_decomposition_map [CharZero K] {R : Type*} [CommRing R] (f : K →+* R) :
    (embeddingMatrix K).map f*(projectionMatrix K).map f+
      (correctionMatrix K).map f*(contractionMatrix K).map f=1 := by
  ext i j
  have h := congrArg (fun M : Matrix (Fin 20) (Fin 20) K => f (M i j))
    (primitive_matrix_decomposition K)
  by_cases hij : i=j <;> simpa [Matrix.mul_apply, Matrix.one_apply, hij] using h



/-- Reconstruction in an arbitrary coefficient ring, including nonreduced
coordinate rings; this uses no field-valued-points criterion. -/
theorem primitive_vector_reconstruction [CharZero K] {R : Type*} [CommRing R]
    (f : K →+* R) (w : Fin 20 → R)
    (hw : (contractionMatrix K).map f *ᵥ w=0) :
    (embeddingMatrix K).map f *ᵥ ((projectionMatrix K).map f *ᵥ w)=w := by
  have h := congrArg (fun M : Matrix (Fin 20) (Fin 20) R => M *ᵥ w)
    (primitive_matrix_decomposition_map K f)
  simpa only [Matrix.add_mulVec,← Matrix.mulVec_mulVec,hw,
    Matrix.mulVec_zero,add_zero,Matrix.one_mulVec] using h

/-- Projection to the fourteen coordinates preserves the unit-ideal
condition needed to define an actual projective morphism. -/
theorem span_projection_eq_top [CharZero K] {R : Type*} [CommRing R]
    (f : K →+* R) (w : Fin 20 → R)
    (hw : (contractionMatrix K).map f *ᵥ w=0)
    (hspan : Ideal.span (Set.range w)=⊤) :
    Ideal.span (Set.range ((projectionMatrix K).map f *ᵥ w))=⊤ := by
  apply top_unique
  rw [← hspan]
  apply Ideal.span_le.mpr
  rintro x ⟨i,rfl⟩
  rw [← congrFun (primitive_vector_reconstruction K f w hw) i]
  change ∑ j,((embeddingMatrix K).map f) i j *
    ((projectionMatrix K).map f *ᵥ w) j∈_
  exact Submodule.sum_mem _ (fun j _ =>
    Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j,rfl⟩))



/-- The fourteen primitive coordinates are a split linear subspace of the
actual twenty-dimensional third exterior power. -/
theorem primitive_matrix_leftInverse : projectionMatrix K*embeddingMatrix K=1 := by
  have h : (coordinateProjection K).comp (coordinateEmbedding K)=LinearMap.id := by
    apply LinearMap.ext
    intro r
    exact coordinateProjection_embedding K r
  simp only [projectionMatrix,embeddingMatrix,← LinearMap.toMatrix_comp,h,LinearMap.toMatrix_id]

theorem primitive_matrix_leftInverse_map {R : Type*} [CommRing R] (f : K →+* R) :
    (projectionMatrix K).map f*(embeddingMatrix K).map f=1 := by
  ext i j
  have h := congrArg (fun M : Matrix (Fin 14) (Fin 14) K => f (M i j))
    (primitive_matrix_leftInverse K)
  by_cases hij : i=j <;> simpa [Matrix.mul_apply,Matrix.one_apply,hij] using h

theorem embeddingMatrix_map_injective {R : Type*} [CommRing R] (f : K →+* R) :
    Function.Injective ((embeddingMatrix K).map f).mulVec := by
  apply Function.LeftInverse.injective (g:=((projectionMatrix K).map f).mulVec)
  intro v
  rw [Matrix.mulVec_mulVec,primitive_matrix_leftInverse_map,Matrix.one_mulVec]

end M9Native.LagrangianField



namespace M9Native.LagrangianGrassmannian

open M9Native.SectionZeroIdealFactorization
open scoped ChangeOfRings

variable (K : Type u) [Field K]

/-- Equality with the independently verified dual-evaluation zero ideal. -/
theorem ideal_eq_sectionZeroIdeal : ideal K =
    M9Native.SectionZeroIdealFactorization.sectionZeroIdeal (grassmannian K)
      (equationBundle K) (equationSection K) := rfl

/-- The actual LG closed subscheme represents the vanishing of the genuine
rank-three universal bivector section over every test scheme. -/
theorem factorsThrough_iff_pullback_equation_zero {Y : Scheme.{u}}
    (f : Y ⟶ grassmannian K) :
    (∃ g : Y ⟶ space K, g ≫ inclusion K=f) ↔
      pullbackGlobalSections f (equationBundle K) (equationSection K)=0 := by
  exact (pullbackGlobalSections_eq_zero_iff_factorsThrough
    (equationBundle K) 3 (equationSection K) f).symm

/-- The section vanishes on the constructed LG itself. -/
theorem equation_zero_on_space :
    pullbackGlobalSections (inclusion K) (equationBundle K) (equationSection K)=0 :=
  (factorsThrough_iff_pullback_equation_zero K (inclusion K)).mp ⟨𝟙 _,by simp⟩

/-- The defining ideal commutes with arbitrary scheme base change. -/
theorem ideal_baseChange {Y : Scheme.{u}} (f : Y ⟶ grassmannian K) :
    M9Native.SectionZeroIdealFactorization.sectionZeroIdeal Y
      ((Scheme.Modules.pullback f).obj (equationBundle K))
      (pullbackGlobalSections f (equationBundle K) (equationSection K))=
        (ideal K).comap f :=
  sectionZeroIdeal_pullback f (equationBundle K) 3 (equationSection K)

/-- Genuine field points are classified by the vanishing of the universal
section in its canonical affine extension-of-scalars module. -/
theorem specPoint_factorsThrough_iff {k : Type u} [Field k]
    (f : Spec (.of k) ⟶ grassmannian K) {U : (grassmannian K).Opens}
    (hU : IsAffineOpen U) (hfU : (⊤ : (Spec (.of k)).Opens) ≤ f ⁻¹ᵁ U) :
    (∃ g : Spec (.of k) ⟶ space K, g ≫ inclusion K=f) ↔
      ((1 : Γ(Spec (.of k),⊤)) ⊗ₜ[Γ(grassmannian K,U),(f.appLE U ⊤ hfU).hom]
        ((equationBundle K).presheaf.map (homOfLE (show U≤⊤ from le_top)).op
          (equationSection K)))=0 :=
  specPoint_factorsThrough_iff_one_tmul (equationBundle K) 3 (equationSection K) k f hU hfU

