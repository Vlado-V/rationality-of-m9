open AlgebraicGeometry.Grassmannian

def chartPresentation {T : Scheme.{u}} (ι : Fin 3 ↪ Fin 6)
    (g : T ⟶ Spec (.of (MvPolynomial (ChartIndex.{u} (k:=3) (n:=6) ι) (ULift.{u} ℤ)))) :
    QuotientPresentation T 3 6 :=
  normalizedQuotientPresentation T 3 6 ι
    ((normalizedQuotientCoefficientsEquiv T 3 6 ι).symm
      (AffineSpace.toSpecMvPolyIntEquiv _ g))

theorem chartPresentation_map {T : Scheme.{u}} (ι : Fin 3 ↪ Fin 6)
    (g : T ⟶ Spec (.of (MvPolynomial (ChartIndex.{u} (k:=3) (n:=6) ι) (ULift.{u} ℤ)))) :
    (chartPresentation ι g).map=chartQuotientMap 3 6 ι g := by
  exact Eq.trans (Eq.refl ((chartPresentation ι g).map)) (Eq.refl _)

theorem integralChart_class {T : Scheme.{u}} (ι : Fin 3 ↪ Fin 6)
    (g : T ⟶ Spec (.of (MvPolynomial (ChartIndex.{u} (k:=3) (n:=6) ι) (ULift.{u} ℤ)))) :
    (functorData 3 6).objEquiv T ((schemeRepresentableBy 3 6).homEquiv
      (g ≫ chart 3 6 ι))=⟦chartPresentation ι g⟧ := by
  exact objEquiv_homEquiv_comp_chartMap 3 6 ι g


variable (K : Type u) [Field K]

/-- On any native matrix chart the pulled-back chosen universal quotient is
isomorphic to the literal normalized matrix quotient, with its quotient map preserved. -/
theorem pullbackUniversal_chart_isomorphic {T : Scheme.{u}}
    (f : T ⟶ grassmannian K) (ι : Fin 3 ↪ Fin 6)
    (g : T ⟶ Spec (.of (MvPolynomial (ChartIndex.{u} (k:=3) (n:=6) ι) (ULift.{u} ℤ))))
    (hfg : f ≫ pullback.snd _ _=g ≫ chart 3 6 ι) :
    ∃ e : (pullbackPresentation f (universalQuotient K)).target ≅ freeModule T 3,
      (pullbackPresentation f (universalQuotient K)).map ≫ e.hom=chartQuotientMap 3 6 ι g := by
  obtain ⟨e,he⟩ := pullbackUniversal_isomorphic K f (chartPresentation ι g) (by
    rw [hfg]
    exact integralChart_class ι g)
  exact ⟨e,he.trans (chartPresentation_map ι g)⟩

/-- Annihilation of the actual bivector is independent of the chosen target
trivialization of a quotient. -/
theorem annihilatesSigma_iff_of_iso (T : Scheme.{u}) {E F : T.Modules}
    (q : freeModule T 6 ⟶ E) (q' : freeModule T 6 ⟶ F)
    (e : E ≅ F) (he : q ≫ e.hom=q') :
    AnnihilatesSigma T q ↔ AnnihilatesSigma T q' := by
  have hcomp : exteriorPowerMap T q' 2=
      exteriorPowerMap T q 2 ≫ exteriorPowerMap T e.hom 2 := by
    rw [← he,exteriorPowerMap_eq_native,exteriorPowerMap_eq_native,
      exteriorPowerMap_eq_native,Scheme.Modules.exteriorPowerMap_comp]
  have hi : Function.Injective ((exteriorPowerMap T e.hom 2).app ⊤) := by
    rw [exteriorPowerMap_eq_native]
    exact (ConcreteCategory.bijective_of_isIso _).injective
  change _=0 ↔ _=0
  rw [hcomp]
  change _=0 ↔ (exteriorPowerMap T e.hom 2).app ⊤
    ((exteriorPowerMap T q 2).app ⊤ (sigmaSection T))=0
  exact (map_eq_zero_iff _ hi).symm

end M9Native.LagrangianGrassmannian


/-! The following canonical exterior pullback identities replay only the
universal-property proofs from the pinned native exterior-algebra providers;
the exact source hashes and license are saved in audits/lagrangian/native-provenance.json. -/
open TopologicalSpace

namespace M9Native.LagrangianPullback
open RingedSpaceModuleAdjunction Stacks.RingedSpace SheafOfModules.GradedAlgebra


section RingedSpace

open AlgebraicGeometry RingedSpaceModuleAdjunction

variable {X Y : RingedSpace.{u, u}} (f : X ⟶ Y) {F : SheafOfModules.{u} (structureSheafRing Y)}
  {A : SheafOfModules.GradedAlgebra.{u, u} (structureSheafRing Y)} {ι : F ⟶ A.piece 1}
  {B : SheafOfModules.GradedAlgebra.{u, u} (structureSheafRing X)}
  {κ : (modulePullback f).obj F ⟶ B.piece 1} (hA : IsExteriorAlgebra A ι)

/-- The canonical comparison depends on the degree-one generator of the target only through its
value, not through the proof that it is square-zero. -/
theorem pullbackComparison_congr {κ₁ κ₂ : (modulePullback f).obj F ⟶ B.piece 1} (h : κ₁ = κ₂)
    (hκ₁ : SquareZero κ₁) (hκ₂ : SquareZero κ₂) (n : ℤ) :
    pullbackComparison f hA hκ₁ n = pullbackComparison f hA hκ₂ n := by
  subst h; rfl

/-- The canonical comparison of Stacks 01CI absorbs a unital homomorphism: composing the
comparison `f^*(A_n) ⟶ B_n` attached to a square-zero generator `κ` of `B` with a unital
homomorphism `Φ : B ⟶ D` of sheaves of graded algebras gives the comparison attached to the
square-zero generator `κ ≫ Φ₁` of `D`. -/
theorem pullbackComparison_comp_unitalHom (hκ : SquareZero κ)
    {D : SheafOfModules.GradedAlgebra.{u, u} (structureSheafRing X)} (Φ : UnitalHom B D) (n : ℤ) :
    pullbackComparison f hA hκ n ≫ Φ.app n =
      pullbackComparison f hA (hκ.compUnitalHom Φ) n := by
  refine pullbackComparison_unique f hA (hκ.compUnitalHom Φ)
    (fun m => pullbackComparison f hA hκ m ≫ Φ.app m) (fun i j U a b => ?_) (fun U => ?_)
    (fun U s => ?_) n
  · exact (congrArg (fun z => (Φ.app (i + j)).val.app ((opensMap f).op.obj U) z)
      (pullbackComparison_mul f hA hκ i j U a b)).trans (Φ.map_mul i j _ _ _)
  · exact (congrArg (fun z => (Φ.app 0).val.app ((opensMap f).op.obj U) z)
      (pullbackComparison_one f hA hκ U)).trans (Φ.map_one _)
  · exact congrArg (fun z => (Φ.app 1).val.app ((opensMap f).op.obj U) z)
      (pullbackComparison_generator f hA hκ U s)

end RingedSpace



section Naturality

variable {X Y : RingedSpace.{u, u}} (f : X ⟶ Y)
  {F F' : SheafOfModules.{u} (structureSheafRing Y)}
  {A A' : SheafOfModules.GradedAlgebra.{u, u} (structureSheafRing Y)}
  {ι : F ⟶ A.piece 1} {ι' : F' ⟶ A'.piece 1}
  {B B' : SheafOfModules.GradedAlgebra.{u, u} (structureSheafRing X)}
  {κ : (modulePullback f).obj F ⟶ B.piece 1}
  {κ' : (modulePullback f).obj F' ⟶ B'.piece 1}
  (hA : IsExteriorAlgebra A ι) (hκ' : SquareZero κ') {φ : F ⟶ F'}

/-- **The canonical comparison of Stacks 01CI absorbs a unital homomorphism on the source.**
Let `u : A ⟶ A'` be a unital homomorphism of sheaves of graded algebras extending
`φ : F ⟶ F'` on the degree-one generators.  Pulling `u` back and following it with the
comparison `f^*(A'_n) ⟶ B'_n` attached to a square-zero generator `κ'` of `B'` gives the
comparison attached to the square-zero generator `f^*φ ≫ κ'` of `B'`. -/
theorem pullbackComparison_map_unitalHom (u : UnitalHom A A') (hu : ι ≫ u.app 1 = φ ≫ ι')
    (hA' : IsExteriorAlgebra A' ι') (n : ℤ) :
    (modulePullback f).map (u.app n) ≫ pullbackComparison f hA' hκ' n =
      pullbackComparison f hA (hκ'.comp ((modulePullback f).map φ)) n := by
  have key : ∀ (m : ℤ) (U : (Opens Y.carrier)ᵒᵖ) (y : (A.piece m).val.obj U) (z),
      (u.app m).val.app U y = z →
      ((modulePullback f).map (u.app m) ≫ pullbackComparison f hA' hκ' m).val.app
          ((opensMap f).op.obj U) (pullbackUnit f (A.piece m) U y) =
        (pullbackComparison f hA' hκ' m).val.app ((opensMap f).op.obj U)
          (pullbackUnit f (A'.piece m) U z) := by
    rintro m U y _ rfl
    exact congrArg (fun z => (pullbackComparison f hA' hκ' m).val.app ((opensMap f).op.obj U) z)
      (pullbackUnit_naturality f (u.app m) U y)
  refine pullbackComparison_unique f hA (hκ'.comp ((modulePullback f).map φ))
    (fun m => (modulePullback f).map (u.app m) ≫ pullbackComparison f hA' hκ' m)
    (fun i j U a b => ?_) (fun U => ?_) (fun U s => ?_) n
  · exact (key _ U _ _ (u.map_mul i j U a b)).trans
      ((pullbackComparison_mul f hA' hκ' i j U _ _).trans
        (congrArg₂ (fun x y => ((B'.mul i j).app ((opensMap f).op.obj U) x) y)
          (key i U a _ rfl).symm (key j U b _ rfl).symm))
  · exact (key 0 U _ _ (u.map_one U)).trans (pullbackComparison_one f hA' hκ' U)
  · exact (key 1 U _ _ (congrArg (fun k => k.val.app U s) hu)).trans
      ((pullbackComparison_generator f hA' hκ' U (φ.val.app U s)).trans
        (congrArg (fun z => κ'.val.app ((opensMap f).op.obj U) z)
          (pullbackUnit_naturality f φ U s).symm))

/-- **The comparison of Stacks 01CI is natural in the sheaf of modules.**  Let `A` be an
exterior algebra of `F` and `A'` one of `F'` on `Y`, let `B`, `B'` carry square-zero degree-one
generators of `f^*F`, `f^*F'`, let `u : A ⟶ A'` extend `φ : F ⟶ F'` and let `v : B ⟶ B'` extend
`f^*φ`.  Then the square formed by `f^*(u_n)`, `v_n` and the two comparisons commutes. -/
theorem pullbackComparison_natural (hκ : SquareZero κ) (hA' : IsExteriorAlgebra A' ι')
    (u : UnitalHom A A') (hu : ι ≫ u.app 1 = φ ≫ ι')
    (v : UnitalHom B B') (hv : κ ≫ v.app 1 = (modulePullback f).map φ ≫ κ') (n : ℤ) :
    (modulePullback f).map (u.app n) ≫ pullbackComparison f hA' hκ' n =
      pullbackComparison f hA hκ n ≫ v.app n := by
  rw [pullbackComparison_map_unitalHom f hA hκ' u hu hA' n,
    pullbackComparison_comp_unitalHom f hA hκ v n]
  exact pullbackComparison_congr f hA hv.symm _ _ n


end Naturality

open AlgebraicGeometry.Scheme.Modules
/-- **The exterior power of a sheaf of modules on a scheme commutes with pullback**:
`f^*(⋀ⁿ F) ≅ ⋀ⁿ(f^*F)`, the exterior-algebra case of [Stacks, Tag 01CI] in degree `n`. -/
noncomputable def exteriorPullbackIso {X' X : Scheme.{u}} (f : X' ⟶ X) (F : X.Modules)
    (n : ℤ) :
    (Scheme.Modules.pullback f).obj (exteriorPower F n) ≅
      exteriorPower ((Scheme.Modules.pullback f).obj F) n :=
  (Stacks.PullbackExteriorAlgebra.exteriorAlgebraPullbackIso f.toLRSHom.toShHom
      (exteriorAlgebra F) (exteriorGenerator F)
      (exteriorAlgebra ((Scheme.Modules.pullback f).obj F))
      (exteriorGenerator ((Scheme.Modules.pullback f).obj F))
      (isExteriorAlgebra_exteriorAlgebra F)
      (isExteriorAlgebra_exteriorAlgebra _)).app n



open SheafOfModules.GradedAlgebra

variable {X' X : Scheme.{u}} (f : X' ⟶ X) {F F' : X.Modules} (φ : F ⟶ F')

/-- **The isomorphism `f^*(⋀ⁿ F) ≅ ⋀ⁿ(f^*F)` of [Stacks, Tag 01CI] is natural in `F`.** -/
theorem exteriorPullbackIso_natural (n : ℤ) :
    (Scheme.Modules.pullback f).map (exteriorPowerMap φ n) ≫
        (exteriorPullbackIso f F' n).hom =
      (exteriorPullbackIso f F n).hom ≫
        exteriorPowerMap ((Scheme.Modules.pullback f).map φ) n :=
  pullbackComparison_natural f.toLRSHom.toShHom
    (isExteriorAlgebra_exteriorAlgebra F) (isExteriorAlgebra_exteriorAlgebra _).1
    (isExteriorAlgebra_exteriorAlgebra _).1 (isExteriorAlgebra_exteriorAlgebra F')
    ((isExteriorAlgebra_exteriorAlgebra F).map (isExteriorAlgebra_exteriorAlgebra F') φ)
    ((isExteriorAlgebra_exteriorAlgebra F).map_app_one _ φ)
    ((isExteriorAlgebra_exteriorAlgebra _).map (isExteriorAlgebra_exteriorAlgebra _)
      ((Scheme.Modules.pullback f).map φ))
    ((isExteriorAlgebra_exteriorAlgebra _).map_app_one _ _) n




section HomogeneousProd


open RingedSpaceModuleAdjunction Stacks.RingedSpace SheafOfModules.GradedAlgebra

variable {X Y : RingedSpace.{u, u}} (f : X ⟶ Y)
  (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf Y))
  {M : SheafOfModules.{u} (structureRingSheaf Y)} {ι : M ⟶ A.piece 1}
  {B : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf X)}
  {κ : (pullbackFunctor f).obj M ⟶ B.piece 1}
  (hA : IsExteriorAlgebra A ι) (hκ : SquareZero κ)

/-- The comparison morphism `f^*(A_n) ⟶ B_n` carries the pullback of an ordered product of
degree-one generators to the ordered product of the degree-one generators of `B` at the pulled
back sections. -/
theorem comparisonHom_homogeneousProd (U : (Opens Y.carrier)ᵒᵖ) (n : ℕ)
    (s : Fin n → M.val.obj U) :
    (Stacks.PullbackExteriorAlgebra.comparisonHom f A hA hκ n).val.app ((opensMap f).op.obj U)
        (pullbackUnit f (A.piece n) U
          (A.toPresheafGradedAlgebra.homogeneousProd U n fun i => ι.val.app U (s i))) =
      B.toPresheafGradedAlgebra.homogeneousProd ((opensMap f).op.obj U) n
        fun i => κ.val.app ((opensMap f).op.obj U) (pullbackUnit f M U (s i)) := by
  induction n with
  | zero => exact Stacks.PullbackExteriorAlgebra.comparisonHom_one f A hA hκ U
  | succ n ih =>
    refine (Stacks.PullbackExteriorAlgebra.comparisonHom_mul f A hA hκ (n : ℤ) 1 U _ _).trans ?_
    rw [ih fun i => s i.castSucc, Stacks.PullbackExteriorAlgebra.comparisonHom_generator]
    rfl


end HomogeneousProd


/-- The actual pullback/exterior comparison carries ordered wedges of
actual global sections to ordered wedges of their actual pullbacks. -/

theorem exteriorPullback_homogeneousProd {Y X : Scheme.{u}} (f : Y ⟶ X) (F : X.Modules)
    (n : ℕ) (s : Fin n → Γ(F,⊤)) :
    (exteriorPullbackIso f F n).hom.app ⊤ (pullbackGlobalSections f
      (exteriorPower F n) ((exteriorAlgebra F).toPresheafGradedAlgebra.homogeneousProd
        (op ⊤) n (fun i => (exteriorGenerator F).app ⊤ (s i))))=
      (exteriorAlgebra ((Scheme.Modules.pullback f).obj F)).toPresheafGradedAlgebra.homogeneousProd
        (op ⊤) n (fun i => (exteriorGenerator ((Scheme.Modules.pullback f).obj F)).app ⊤
          (pullbackGlobalSections f F (s i))) := by
  simp only [pullbackGlobalSections_eq_unit]
  exact comparisonHom_homogeneousProd (M:=F)
    (B:=exteriorAlgebra ((Scheme.Modules.pullback f).obj F))
    (κ:=exteriorGenerator ((Scheme.Modules.pullback f).obj F))
    f.toLRSHom.toShHom (exteriorAlgebra F)
    (isExteriorAlgebra_exteriorAlgebra F)
    (isExteriorAlgebra_exteriorAlgebra ((Scheme.Modules.pullback f).obj F)).1 (op ⊤) n s

end M9Native.LagrangianPullback



namespace M9Native.LagrangianGrassmannian
open AlgebraicGeometry.Grassmannian M9Native.SectionZeroIdealFactorization
open M9Native.LagrangianPullback

/-- The canonical comparison for the unit module carries the actual
pullback of `1` to `1`. -/
theorem unit_pullback_one {X Y : Scheme.{u}} (f : Y ⟶ X) :
    let : (SheafOfModules.pushforward f.toRingCatSheafHom).IsRightAdjoint :=
      (Scheme.Modules.pullbackPushforwardAdjunction f).isRightAdjoint
    (SheafOfModules.pullbackObjUnitToUnit f.toRingCatSheafHom).val.app (op ⊤)
      (pullbackGlobalSections f (SheafOfModules.unit X.ringCatSheaf) (1 : Γ(X,⊤)))=
        (1 : Γ(Y,⊤)) := by
  let : (SheafOfModules.pushforward f.toRingCatSheafHom).IsRightAdjoint :=
    (Scheme.Modules.pullbackPushforwardAdjunction f).isRightAdjoint
  have heq : (Scheme.Modules.pullbackPushforwardAdjunction f).unit.app
      (SheafOfModules.unit X.ringCatSheaf) ≫ (Scheme.Modules.pushforward f).map
        (SheafOfModules.pullbackObjUnitToUnit f.toRingCatSheafHom)=
      SheafOfModules.unitToPushforwardObjUnit f.toRingCatSheafHom :=
    (Adjunction.homEquiv_unit _ _ _ _).symm.trans
      (SheafOfModules.pullbackPushforwardAdjunction_homEquiv_pullbackObjUnitToUnit _)
  rw [pullbackGlobalSections_eq_unit]
  exact (congrArg (fun φ => φ.val.app (op ⊤) (1 : Γ(X,⊤))) heq).trans
    (map_one (f.toRingCatSheafHom.hom.app (op ⊤)).hom)


/-- The actual standard free sections pull back to the actual standard
free sections under the native canonical free-bundle comparison. -/
theorem freeVector_pullback {X Y : Scheme.{u}} (f : Y ⟶ X) (i : Fin 6) :
    (pullbackFreeIso f 6).hom.app ⊤
      (pullbackGlobalSections f (freeModule X 6) (freeVector X i))=freeVector Y i := by
  let : (SheafOfModules.pushforward f.toRingCatSheafHom).IsRightAdjoint :=
    (Scheme.Modules.pullbackPushforwardAdjunction f).isRightAdjoint
  have hnat := pullback_map_app_pullbackGlobalSections f
    (SheafOfModules.ιFree (R:=X.ringCatSheaf) (ULift.up.{u} i)) (1 : Γ(X,⊤))
  have hcomp := congrArg (fun φ => φ.val.app (op ⊤)
    (pullbackGlobalSections f (SheafOfModules.unit X.ringCatSheaf) (1 : Γ(X,⊤))))
      (pullback_map_ιFree_comp_pullbackFreeIso_hom f 6 (ULift.up.{u} i))
  change (pullbackFreeIso f 6).hom.app ⊤
    (pullbackGlobalSections f (freeModule X 6)
      ((SheafOfModules.ιFree (R:=X.ringCatSheaf) (ULift.up.{u} i)).val.app (op ⊤) (1 : Γ(X,⊤))))=_
  exact (congrArg ((pullbackFreeIso f 6).hom.app ⊤) hnat.symm).trans
    (hcomp.trans (congrArg
    ((SheafOfModules.ιFree (R:=Y.ringCatSheaf) (ULift.up.{u} i)).val.app (op ⊤))
      (unit_pullback_one f)))


/-- A unital graded-algebra map preserves ordered products of generators. -/
theorem unitalHom_homogeneousProd (X : Scheme.{u})
    {A B : SheafOfModules.GradedAlgebra.{u,u} X.ringCatSheaf}
    (g : SheafOfModules.GradedAlgebra.UnitalHom A B) (n : ℕ)
    (z : Fin n → (A.piece 1).val.obj (op ⊤)) :
    (g.app (n : ℤ)).val.app (op ⊤) (A.toPresheafGradedAlgebra.homogeneousProd (op ⊤) n z)=
      B.toPresheafGradedAlgebra.homogeneousProd (op ⊤) n
        (fun i => (g.app 1).val.app (op ⊤) (z i)) := by
  induction n with
  | zero => exact g.map_one (op ⊤)
  | succ n ih =>
    change (g.app ((n : ℤ)+1)).val.app (op ⊤) ((A.mul (n : ℤ) 1).app (op ⊤) _ _)=_
    rw [g.map_mul (n : ℤ) 1 (op ⊤),ih (fun i => z i.castSucc)]
    rfl


theorem exteriorPowerMap_wedgeSection (X : Scheme.{u}) {E F : X.Modules}
    (q : E ⟶ F) (s t : Γ(E,⊤)) :
    (exteriorPowerMap X q 2).app ⊤ (wedgeSection X E s t)=
      wedgeSection X F (q.app ⊤ s) (q.app ⊤ t) := by
  let h := (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra E).map
    (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra F) q
  change (h.app 2).val.app (op ⊤) _=_
  refine (unitalHom_homogeneousProd X h 2 _).trans ?_
  apply congrArg ((Scheme.Modules.exteriorAlgebra F).toPresheafGradedAlgebra.homogeneousProd
    (op ⊤) 2)
  funext i
  have he := (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra E).map_app_one
    (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra F) q
  fin_cases i
  · exact congrArg (fun φ : E ⟶ Scheme.Modules.exteriorPower F 1 => φ.val.app (op ⊤) s) he
  · exact congrArg (fun φ : E ⟶ Scheme.Modules.exteriorPower F 1 => φ.val.app (op ⊤) t) he

end M9Native.LagrangianGrassmannian


namespace M9Native.LagrangianGrassmannian
open AlgebraicGeometry.Grassmannian M9Native.SectionZeroIdealFactorization
open M9Native.LagrangianPullback

theorem exteriorPullback_wedgeSection {X Y : Scheme.{u}} (f : Y ⟶ X)
    (E : X.Modules) (s t : Γ(E,⊤)) :
    (exteriorPullbackIso f E 2).hom.app ⊤ (pullbackGlobalSections f
      (Scheme.Modules.exteriorPower E 2) (wedgeSection X E s t))=
      wedgeSection Y ((Scheme.Modules.pullback f).obj E)
        (pullbackGlobalSections f E s) (pullbackGlobalSections f E t) := by
  refine (exteriorPullback_homogeneousProd f E 2 ![s,t]).trans ?_
  have h : (fun i : Fin 2 => (Scheme.Modules.exteriorGenerator
      ((Scheme.Modules.pullback f).obj E)).app ⊤ (pullbackGlobalSections f E (![s,t] i)))=
      ![(Scheme.Modules.exteriorGenerator ((Scheme.Modules.pullback f).obj E)).app ⊤
        (pullbackGlobalSections f E s),
        (Scheme.Modules.exteriorGenerator ((Scheme.Modules.pullback f).obj E)).app ⊤
        (pullbackGlobalSections f E t)] := by
    funext i
    fin_cases i <;> rfl
  exact congrArg ((Scheme.Modules.exteriorAlgebra ((Scheme.Modules.pullback f).obj E )).toPresheafGradedAlgebra.homogeneousProd (op ⊤) 2) h

/-- The genuine constant bivector is preserved by scheme pullback and the
native canonical free-bundle comparison. -/
theorem sigmaSection_pullback {X Y : Scheme.{u}} (f : Y ⟶ X) :
    (exteriorPowerMap Y (pullbackFreeIso f 6).hom 2).app ⊤
      ((exteriorPullbackIso f (freeModule X 6) 2).hom.app ⊤
        (pullbackGlobalSections f (Scheme.Modules.exteriorPower (freeModule X 6) 2)
          (sigmaSection X)))=sigmaSection Y := by
  simp only [sigmaSection,map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [exteriorPullback_wedgeSection,exteriorPowerMap_wedgeSection,
    freeVector_pullback,freeVector_pullback]

variable (K : Type u) [Field K]

/-- The actual pulled-back defining section is exactly the bivector image
under the actual pulled-back universal quotient. -/
theorem pullback_equation_eq_quotientSigma {Y : Scheme.{u}} (f : Y ⟶ grassmannian K) :
    (exteriorPullbackIso f (quotientBundle K) 2).hom.app ⊤
      (pullbackGlobalSections f (equationBundle K) (equationSection K))=
      (exteriorPowerMap Y (pullbackPresentation f (universalQuotient K)).map 2).app ⊤
        (sigmaSection Y) := by
  let s := pullbackGlobalSections f (Scheme.Modules.exteriorPower (freeModule (grassmannian K) 6) 2)
    (sigmaSection (grassmannian K))
  let t := (exteriorPullbackIso f (freeModule (grassmannian K) 6) 2).hom.app ⊤ s
  have hn : (Scheme.Modules.pullback f).map
        (exteriorPowerMap (grassmannian K) (universalQuotient K).map 2) ≫
          (exteriorPullbackIso f (quotientBundle K) 2).hom=
      (exteriorPullbackIso f (freeModule (grassmannian K) 6) 2).hom ≫
        exteriorPowerMap Y ((Scheme.Modules.pullback f).map (universalQuotient K).map) 2 := by
    simpa only [exteriorPowerMap_eq_native] using
      exteriorPullbackIso_natural f (universalQuotient K).map 2
  have hq : exteriorPowerMap Y (pullbackFreeIso f 6).hom 2 ≫
      exteriorPowerMap Y (pullbackPresentation f (universalQuotient K)).map 2=
      exteriorPowerMap Y ((Scheme.Modules.pullback f).map (universalQuotient K).map) 2 := by
    simp only [exteriorPowerMap_eq_native,← Scheme.Modules.exteriorPowerMap_comp]
    congr 1
    change (pullbackFreeIso f 6).hom ≫
      ((pullbackFreeIso f 6).inv ≫ (Scheme.Modules.pullback f).map (universalQuotient K).map)=_
    exact Iso.hom_inv_id_assoc _ _
  calc
    _ = (exteriorPullbackIso f (quotientBundle K) 2).hom.app ⊤
        (((Scheme.Modules.pullback f).map
          (exteriorPowerMap (grassmannian K) (universalQuotient K).map 2)).app ⊤ s) :=
      congrArg ((exteriorPullbackIso f (quotientBundle K) 2).hom.app ⊤)
        (pullback_map_app_pullbackGlobalSections f
          (exteriorPowerMap (grassmannian K) (universalQuotient K).map 2)
          (sigmaSection (grassmannian K))).symm
    _ = (exteriorPowerMap Y ((Scheme.Modules.pullback f).map (universalQuotient K).map) 2).app ⊤ t := congrArg (fun φ => φ.app ⊤ s) hn
    _ = _ := by
      rw [← sigmaSection_pullback f]
      exact (congrArg (fun φ => φ.app ⊤ t) hq).symm

/-- LG's genuine functor-of-points condition says exactly that the actual
rank-three quotient annihilates the actual standard symplectic bivector. -/
theorem factorsThrough_iff_pullbackQuotient_annihilates {Y : Scheme.{u}}
    (f : Y ⟶ grassmannian K) :
    (∃ g : Y ⟶ space K,g ≫ inclusion K=f) ↔
      AnnihilatesSigma Y (pullbackPresentation f (universalQuotient K)).map := by
  rw [factorsThrough_iff_pullback_equation_zero]
  change _=0 ↔ _=0
  rw [← pullback_equation_eq_quotientSigma K f]
  exact (map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso
    ((exteriorPullbackIso f (quotientBundle K) 2).hom.app ⊤)).injective).symm

end M9Native.LagrangianGrassmannian
