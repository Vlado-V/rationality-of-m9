module

public import StacksFrontier.AlgebraicGeometry.Limits.AdjoinFinsetSystem

/-! Algebra maps factor through the actual finite-generator affine stages.

The target stage is generated by the images of the source generators.
All maps are the original maps over Spec K, including for zero algebras.
-/

@[expose] public noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace M9StacksIntegration.AdjoinFinsetBaseMapFactorization

variable {K A R : Type u} [Field K] [CommRing A] [CommRing R]
  [Algebra K A] [Algebra K R]

/-- The literal map on spectra, as a morphism over the original field. -/
def specOverMap (φ : A →ₐ[K] R) :
    (AdjoinFinset.specOverCone K R).pt ⟶ (AdjoinFinset.specOverCone K A).pt :=
  Over.homMk (Spec.map (CommRingCat.ofHom φ.toRingHom)) (by
    change Spec.map (CommRingCat.ofHom φ.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K A)) =
      Spec.map (CommRingCat.ofHom (algebraMap K R))
    rw [← Spec.map_comp, Spec.map_inj]
    exact CommRingCat.hom_ext (by ext k; exact φ.commutes k))

theorem specOverMap_left (φ : A →ₐ[K] R) :
    (specOverMap φ).left = Spec.map (CommRingCat.ofHom φ.toRingHom) := rfl

/-- The actual target stage is the image of the finite source generators. -/
def imageStage (φ : A →ₐ[K] R) (i : (Finset A)ᵒᵖ) : (Finset R)ᵒᵖ := by
  classical
  exact op (i.unop.image φ)

theorem image_mem_adjoin (φ : A →ₐ[K] R) (i : (Finset A)ᵒᵖ)
    (x : Algebra.adjoin K (i.unop : Set A)) :
    φ x ∈ Algebra.adjoin K ((imageStage φ i).unop : Set R) := by
  classical
  have hsub : Algebra.adjoin K (i.unop : Set A) ≤
      (Algebra.adjoin K ((imageStage φ i).unop : Set R)).comap φ := by
    apply Algebra.adjoin_le
    intro a ha
    change φ a ∈ Algebra.adjoin K ((imageStage φ i).unop : Set R)
    apply Algebra.subset_adjoin
    change φ a ∈ i.unop.image φ
    exact Finset.mem_image.mpr ⟨a,ha,rfl⟩
  exact hsub x.property

/-- Restrict the original algebra map to the two actual generated subalgebras. -/
def stageAlgHom (φ : A →ₐ[K] R) (i : (Finset A)ᵒᵖ) :
    Algebra.adjoin K (i.unop : Set A) →ₐ[K]
      Algebra.adjoin K ((imageStage φ i).unop : Set R) :=
  (φ.comp (Algebra.adjoin K (i.unop : Set A)).val).codRestrict
    (Algebra.adjoin K ((imageStage φ i).unop : Set R)) (image_mem_adjoin φ i)

theorem stageAlgHom_val (φ : A →ₐ[K] R) (i : (Finset A)ᵒᵖ) :
    (Algebra.adjoin K ((imageStage φ i).unop : Set R)).val.comp (stageAlgHom φ i) =
      φ.comp (Algebra.adjoin K (i.unop : Set A)).val :=
  AlgHom.ext fun _ => rfl

/-- The actual finite-stage map over Spec K is induced by that restriction. -/
def stageMap (φ : A →ₐ[K] R) (i : (Finset A)ᵒᵖ) :
    (AdjoinFinset.specOverDiagram K R).obj (imageStage φ i) ⟶
      (AdjoinFinset.specOverDiagram K A).obj i :=
  Over.homMk (Spec.map (CommRingCat.ofHom (stageAlgHom φ i).toRingHom)) (by
    change Spec.map (CommRingCat.ofHom (stageAlgHom φ i).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (Algebra.adjoin K (i.unop : Set A)))) =
      Spec.map (CommRingCat.ofHom
        (algebraMap K (Algebra.adjoin K ((imageStage φ i).unop : Set R))))
    rw [← Spec.map_comp, Spec.map_inj]
    exact CommRingCat.hom_ext (RingHom.ext fun k => (stageAlgHom φ i).commutes k))

/-- The finite-stage triangle retains the literal original map on spectra. -/
theorem stageMap_comp (φ : A →ₐ[K] R) (i : (Finset A)ᵒᵖ) :
    specOverMap φ ≫ (AdjoinFinset.specOverCone K A).π.app i =
      (AdjoinFinset.specOverCone K R).π.app (imageStage φ i) ≫ stageMap φ i := by
  apply Over.OverMorphism.ext
  change Spec.map (CommRingCat.ofHom φ.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (Algebra.adjoin K (i.unop : Set A)).val.toRingHom) =
    Spec.map (CommRingCat.ofHom
      (Algebra.adjoin K ((imageStage φ i).unop : Set R)).val.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (stageAlgHom φ i).toRingHom)
  rw [← Spec.map_comp, ← Spec.map_comp, Spec.map_inj]
  exact CommRingCat.hom_ext (by ext x; rfl)

/-- Every algebra map factors through an actual target stage over Spec K.
No finite-presentation or nontriviality premise is imposed on either algebra. -/
theorem exists_stageMap (φ : A →ₐ[K] R) (i : (Finset A)ᵒᵖ) :
    ∃ j : (Finset R)ᵒᵖ,
      ∃ a : (AdjoinFinset.specOverDiagram K R).obj j ⟶
          (AdjoinFinset.specOverDiagram K A).obj i,
        specOverMap φ ≫ (AdjoinFinset.specOverCone K A).π.app i =
          (AdjoinFinset.specOverCone K R).π.app j ≫ a :=
  ⟨imageStage φ i, stageMap φ i, stageMap_comp φ i⟩

end M9StacksIntegration.AdjoinFinsetBaseMapFactorization
end
